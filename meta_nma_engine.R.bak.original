# =============================================================================
# META-ANALYSIS & NETWORK META-ANALYSIS ENGINE — UNIFIED BUNDLE
# Covers: MA (Binary · Continuous · Diagnostic) + NMA (Binary · Continuous)
#
# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  CARA PAKAI (2 langkah)                                                ║
# ╠══════════════════════════════════════════════════════════════════════════╣
# ║  Step 1 — Set working directory (WAJIB):                               ║
# ║    RStudio/Positron: Session > Set Working Directory >                 ║
# ║                       To Source File Location                           ║
# ║                                                                         ║
# ║  Step 2 — Source file ini:                                             ║
# ║    source("meta_nma_engine.R")                                          ║
# ║                                                                         ║
# ║  Step 3a — Jalankan Meta-Analysis (termasuk routing otomatis ke NMA):  ║
# ║    hasil_ma  <- run_ma_analyses()           # file picker              ║
# ║    hasil_ma  <- run_ma_analyses("data.xlsx")# atau path langsung       ║
# ║                                                                         ║
# ║  Step 3b — Jalankan Network Meta-Analysis secara manual:               ║
# ║    hasil_nma <- run_nma_analyses()                                      ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
# LOGIKA ROUTING OTOMATIS (sheet dikotomi & kontinyu):
#   Tidak ada kolom treat1/treat2      → MA biasa
#   Ada treat1/treat2, 1 pair unik     → MA biasa (treat1 vs treat2 = group1 vs group2)
#   Ada treat1/treat2, > 1 pair unik   → NMA (run_nma_analyses dipanggil otomatis)
#   Sheet diagnostik                   → selalu MA biasa
#
# KOLOM BARU DI EXCEL (opsional, untuk routing):
#   treat1              nama treatment kelompok 1
#   treat2              nama treatment kelompok 2
#   nma_reference       treatment referensi untuk NMA (isi di baris pertama per outcome)
#   nma_small_values    "desirable" atau "undesirable" (default: "desirable")
#
# OUTPUT FOLDER (prioritas otomatis):
#   1. Working directory saat ini   ← gunakan "Set WD to Source File Location"
#   2. ~/Documents
#   3. ~/Desktop (Mac) / USERPROFILE root (Windows)
#   4. tempdir()
#
# AKSES HASIL:
#   # MA results:
#   hasil_ma$dikotomi$`Mortality (OR)`$overall_meta
#   hasil_ma$kontinyu$`HbA1c (MD)`$overall_meta
#   hasil_ma$diagnostik$`PCR`$bivariate_model
#
#   # NMA results:
#   hasil_nma$dikotomi$`Mortality (OR)`$nma
#   hasil_nma$dikotomi$`Mortality (OR)`$pscore
#   hasil_nma$dikotomi$`Mortality (OR)`$league_table
#   hasil_nma$dikotomi$`Mortality (OR)`$netsplit + AUTO-RUN
# Covers: Package Installer · Binary (OR/RR/HR) · Continuous (MD/SMD) · Diagnostic
#
# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  CARA PAKAI (3 LANGKAH)                                                ║
# ╠══════════════════════════════════════════════════════════════════════════╣
# ║  Step 1 — Set working directory ke folder script (WAJIB):              ║
# ║    RStudio / Positron: Session > Set Working Directory >               ║
# ║                         To Source File Location                         ║
# ║                                                                         ║
# ║  Step 2 — Source file ini (sekali saja per sesi):                      ║
# ║    source("meta_analysis_complete.R")                                   ║
# ║                                                                         ║
# ║  Step 3 — Jalankan analisis (buka file picker, pilih Excel):           ║
# ║    hasil_ma  <- run_ma_analyses()           # file picker              ║
# ║    # Atau langsung isi path:                                            ║
# ║    hasil_ma  <- run_ma_analyses("data.xlsx")# atau path langsung       ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
# FORMAT EXCEL:
#   Sheet wajib bernama (case-insensitive): dikotomi · kontinyu · diagnostik
#   Sheet boleh ada 1, 2, atau semua 3 — yang ada langsung dianalisis.
#
#   Setiap sheet WAJIB punya kolom:
#     outcome_name    → nama outcome (contoh: "Mortality", "HbA1c Change")
#     effect_measure  → OR / RR / HR  (sheet dikotomi)
#                       MD / SMD       (sheet kontinyu)
#                       (kolom ini TIDAK diperlukan di sheet diagnostik)
#
#   Multi-outcome dalam 1 sheet didukung — tiap kombinasi outcome_name ×
#   effect_measure dijalankan sebagai analisis terpisah dengan folder sendiri.
#
# FORMAT KOLOM DATA (tidak berubah dari versi sebelumnya):
#
#   KOLOM WAJIB (semua engine):
#     study           → nama studi (karakter)
#
#   BINARY ENGINE — pilih salah satu input:
#     Opsi A (langsung): yi, lowci, highci, sample1, sample2
#     Opsi B (2x2):      event1, sample1, event2, sample2
#     Opsi C (campuran): gabungan Opsi A dan B per baris
#
#   CONTINUOUS ENGINE — boleh campur antar baris:
#     Opsi A (langsung):   md, lowci, highci, sample1, sample2
#     Opsi B (md + sd):    md, sd, sample1, sample2
#     Opsi C (dari mean):  mean1, sd1, sample1, mean2, sd2, sample2
#     Opsi D (median/IQR): median1, q1_1, q3_1, sample1,
#                          median2, q1_2, q3_2, sample2
#                          + min1,max1,min2,max2 (opsional, lebih akurat)
#
#   DIAGNOSTIC ENGINE:
#     Opsi A (2x2):      tp, fp, fn, tn, sample
#     Opsi B (langsung): sens, spec, sample
#
#   SUBGROUP ANALYSIS (prefix: subgroup_):
#     subgroup_design · subgroup_region · subgroup_namaapapun
#
#   META-REGRESSION (prefix: moderator_num_ atau moderator_cat_):
#     moderator_num_year · moderator_num_mean_age
#     moderator_cat_design · moderator_cat_region
#     → Auto-run jika kolom ditemukan, tidak perlu kode tambahan
#
# CONTOH HEADER EXCEL LENGKAP (sheet dikotomi):
#   study | outcome_name | effect_measure | yi | lowci | highci |
#   sample1 | sample2 | subgroup_design | moderator_num_year
#
# CONTOH HEADER EXCEL LENGKAP (sheet kontinyu):
#   study | outcome_name | effect_measure | md | sd | lowci | highci |
#   mean1 | sd1 | median1 | iqr1 | q1_1 | q3_1 | min1 | max1 | sample1 |
#   mean2 | sd2 | median2 | iqr2 | q1_2 | q3_2 | min2 | max2 | sample2 |
#   subgroup_studydesign | moderator_num_year | moderator_cat_region
#
# CONTOH HEADER EXCEL LENGKAP (sheet diagnostik):
#   study | outcome_name | tp | fp | fn | tn | sample | subgroup_setting
#
# OUTPUT FOLDER (prioritas otomatis):
#   1. Working directory saat ini  ← gunakan Set WD To Source File Location
#   2. ~/Documents
#   3. ~/Desktop (Mac) / USERPROFILE root (Windows)
#   4. tempdir()                   ← last resort
#
# AKSES HASIL DARI R:
#   hasil$dikotomi$`Mortality (OR)`$overall_meta       # objek rma
#   hasil$dikotomi$`Mortality (OR)`$meta_regression    # meta-regresi
#   hasil$dikotomi$`Mortality (OR)`$loo_table          # leave-one-out
#   hasil$kontinyu$`HbA1c Change (MD)`$overall_meta
#   hasil$diagnostik$`PCR for COVID-19`$bivariate_model
# =============================================================================

# ── Bersihkan versi lama fungsi dari environment (jika pernah di-source sebelumnya)
local({
  old_fns <- c(".run_meta_regression", ".run_metareg_v4",
               "run_all_analyses", "run_ma_analyses", "run_nma_analyses",
               "run_binary_outcome_analysis",
               "run_continuous_outcome_analysis",
               "run_diagnostic_meta_analysis",
               "run_network_meta_analysis", "plot_net_clinical_benefit",
               "run_single_arm_analysis",
               ".resolve_output_folder",
               "import_excel_sheets",
               "install_meta_packages")
  for (fn in old_fns)
    if (exists(fn, envir = .GlobalEnv, inherits = FALSE))
      rm(list = fn, envir = .GlobalEnv)
})


# =============================================================================
# SHARED HELPER: OUTPUT FOLDER RESOLUTION
# =============================================================================
#
# Priority:
#   1. getwd()  — uses whatever working directory the user has set
#                 (e.g. "Set Working Directory > To Source File Location" in RStudio,
#                  or Session > Set Working Directory in Positron)
#   2. ~/Documents  — safe fallback if wd is a temp/system directory
#   3. ~/Desktop    — secondary fallback (Mac) or USERPROFILE root (Windows)
#   4. tempdir()    — last resort; always writable
#
# "Safe" = not a system/temp directory (e.g. /tmp, C:/Windows, /usr, etc.)

.resolve_output_folder <- function(folder_name) {

  # ── Is a path "safe" to write user output into? ───────────────────────────
  .is_safe_wd <- function(path) {
    if (is.null(path) || !nzchar(path)) return(FALSE)
    path <- normalizePath(path, mustWork = FALSE)

    # Patterns that indicate system / temp directories — not suitable for output
    unsafe_patterns <- c(
      "^/tmp",           "^/var/",          "^/usr/",
      "^/System/",       "^/Library/",      "^/bin",
      "^/sbin",          "^/etc",           "^/proc",
      "[Tt]emp[/\\\\]",  "[Tt]mp[/\\\\]",
      "^C:[/\\\\]Windows", "^C:[/\\\\]Program"
    )

    for (pat in unsafe_patterns)
      if (grepl(pat, path)) return(FALSE)

    # Must actually exist and be writable
    dir.exists(path) && file.access(path, 2) == 0
  }

  # ── Candidate paths in priority order ─────────────────────────────────────
  candidates <- list(

    list(
      path   = tryCatch(getwd(), error = function(e) ""),
      label  = "working directory (current session)"
    ),

    list(
      path   = if (.Platform$OS.type == "windows")
                 file.path(Sys.getenv("USERPROFILE"), "Documents")
               else
                 file.path(Sys.getenv("HOME"), "Documents"),
      label  = "Documents folder"
    ),

    list(
      path   = if (.Platform$OS.type == "windows")
                 Sys.getenv("USERPROFILE")
               else
                 file.path(Sys.getenv("HOME"), "Desktop"),
      label  = if (.Platform$OS.type == "windows") "user profile root" else "Desktop"
    ),

    list(
      path   = tempdir(),
      label  = "system temp directory (last resort — output may not persist)"
    )
  )

  # ── Walk candidates until one works ───────────────────────────────────────
  for (candidate in candidates) {
    base <- candidate$path
    if (!nzchar(base)) next

    target <- file.path(base, folder_name)

    if (.is_safe_wd(base) || base == tempdir()) {
      if (dir.create(target, recursive = TRUE, showWarnings = FALSE) || dir.exists(target)) {
        message("Output folder: ", target,
                "\n  (saved to: ", candidate$label, ")")
        return(target)
      }
    }
  }

  # Should never reach here, but just in case
  stop("Could not create output folder in any writable location.")
}

# NMA engine references .resolve_nma_output_folder — point to same function
.resolve_nma_output_folder <- .resolve_output_folder


# =============================================================================
# SECTION 1: UNIVERSAL PACKAGE INSTALLER
# =============================================================================

install_meta_packages <- function() {

  cat("\n============================================================\n")
  cat("  META-ANALYSIS & NMA ENGINE — UNIVERSAL PACKAGE INSTALLER\n")
  cat("  Covers: Binary · Continuous · Diagnostic · Network Meta-Analysis\n")
  cat("============================================================\n\n")

  # ── Package list ────────────────────────────────────────────────────────────

  packages <- list(
    list(name = "metafor",   min_version = "3.0",
         engines = c("Binary", "Continuous", "Diagnostic", "NMA"),
         reason  = "Core RE model, leave-one-out, trim-and-fill, Egger/Begg, escalc()"),
    list(name = "meta",      min_version = "5.0",
         engines = c("Binary", "Continuous", "Diagnostic", "NMA"),
         reason  = "Forest plots, metagen(), metaprop(), subgroup analysis"),
    list(name = "netmeta",   min_version = "2.0",
         engines = c("NMA"),
         reason  = "Core NMA engine: netmeta(), netgraph(), netsplit(), netrank()"),
    list(name = "mada",      min_version = "0.5",
         engines = c("Diagnostic"),
         reason  = "Bivariate model (reitsma), SROC curve, AUC — diagnostic-specific"),
    list(name = "ggplot2",   min_version = "3.3",
         engines = c("NMA"),
         reason  = "P-score ranking plot, net clinical benefit plot"),
    list(name = "ggrepel",   min_version = "0.9",
         engines = c("NMA"),
         reason  = "Non-overlapping labels in net clinical benefit plot"),
    list(name = "gridExtra", min_version = "2.3",
         engines = c("NMA"),
         reason  = "League table visualization (grid.table)"),
    list(name = "writexl",   min_version = "1.4",
         engines = c("NMA"),
         reason  = "Export league table and results to Excel"),
    list(name = "Matrix",    min_version = "1.3",
         engines = c("Binary", "Continuous", "Diagnostic", "NMA"),
         reason  = "Dependency of metafor/lme4 — must be compatible to avoid ABI warning"),
    list(name = "lme4",      min_version = "1.1",
         engines = c("Binary", "Continuous", "Diagnostic", "NMA"),
         reason  = "Mixed-effects backend used by metafor, mada, and netmeta"),
    list(name = "readxl",    min_version = "1.3",
         engines = c("Binary", "Continuous", "Diagnostic", "NMA"),
         reason  = "Import Excel files (.xlsx/.xls) via import_excel_sheets()")
  )

  # ── Helper functions ────────────────────────────────────────────────────────

  version_ok <- function(pkg, min_v) {
    tryCatch(
      utils::compareVersion(as.character(utils::packageVersion(pkg)), min_v) >= 0,
      error = function(e) FALSE
    )
  }

  try_install <- function(name, type = "binary") {
    utils::install.packages(name, repos = "https://cloud.r-project.org/",
                            type = type, quiet = FALSE, dependencies = TRUE)
  }

  status_line <- function(icon, name, msg) {
    cat(sprintf("  %s  %-10s %s\n", icon, name, msg))
  }

  # ── Install loop ────────────────────────────────────────────────────────────

  cat("--- Checking and installing packages ---\n\n")
  install_log <- list()

  for (pkg in packages) {
    name    <- pkg$name
    min_v   <- pkg$min_version
    engines <- paste(pkg$engines, collapse = " / ")
    reason  <- pkg$reason

    cat(sprintf("Package : %s  (>= %s)\n", name, min_v))
    cat(sprintf("Used by : %s\n", engines))
    cat(sprintf("Purpose : %s\n", reason))

    already_ok <- requireNamespace(name, quietly = TRUE) && version_ok(name, min_v)

    if (already_ok) {
      v <- as.character(utils::packageVersion(name))
      cat(sprintf("Status  : Already installed (v%s) — skipping\n\n", v))
      install_log[[name]] <- list(status = "ok", version = v)
      next
    }

    cat("Status  : Installing...\n")
    success <- tryCatch({
      try_install(name, type = "binary")
      requireNamespace(name, quietly = TRUE) && version_ok(name, min_v)
    }, error   = function(e) FALSE,
       warning = function(w) requireNamespace(name, quietly = TRUE) && version_ok(name, min_v))

    if (!success) {
      cat("          Binary install failed — trying from source...\n")
      success <- tryCatch({
        try_install(name, type = "source")
        requireNamespace(name, quietly = TRUE) && version_ok(name, min_v)
      }, error   = function(e) FALSE,
         warning = function(w) requireNamespace(name, quietly = TRUE) && version_ok(name, min_v))
    }

    if (success) {
      v <- as.character(utils::packageVersion(name))
      cat(sprintf("Status  : Installed successfully (v%s)\n\n", v))
      install_log[[name]] <- list(status = "ok", version = v)
    } else {
      cat(sprintf("Status  : FAILED — install manually:\n"))
      cat(sprintf("          install.packages('%s')\n\n", name))
      install_log[[name]] <- list(status = "failed", version = NA)
    }
  }

  # ── ABI compatibility check: Matrix / lme4 ──────────────────────────────────

  cat("------------------------------------------------------------\n")
  cat("Checking Matrix/lme4 ABI compatibility...\n")

  # Helper: kembalikan NA jika hasilnya NULL, length-0, atau NA
  .safe_int <- function(x) {
    x <- tryCatch(x, error = function(e) NULL)
    if (is.null(x) || length(x) == 0 || !is.finite(x)) NA_integer_
    else as.integer(x)
  }

  matrix_abi <- .safe_int(as.integer(utils::packageDescription("Matrix")$ABIVersion))
  lme4_abi   <- .safe_int(as.integer(utils::packageDescription("lme4")$MatrixABI))

  # Fallback jika field tidak ada di DESCRIPTION
  if (is.na(matrix_abi) || is.na(lme4_abi)) {
    abi_warn <- tryCatch({
      abi_env <- new.env()
      withCallingHandlers(
        loadNamespace("lme4"),
        warning = function(w) {
          if (grepl("ABI", conditionMessage(w)))
            abi_env$found <- TRUE
          invokeRestart("muffleWarning")
        }
      )
      isTRUE(abi_env$found)
    }, error = function(e) FALSE)
    abi_issue <- abi_warn
  } else {
    abi_issue <- matrix_abi != lme4_abi
  }

  matrix_v <- tryCatch(as.character(utils::packageVersion("Matrix")), error = function(e) "?")
  lme4_v   <- tryCatch(as.character(utils::packageVersion("lme4")),   error = function(e) "?")

  if (isTRUE(abi_issue)) {
    cat("ABI mismatch detected between Matrix and lme4.\n")
    cat("Reinstalling lme4 from source (this may take a few minutes)...\n\n")
    install_ok <- tryCatch({
      utils::install.packages("Matrix", repos = "https://cloud.r-project.org/",
                              dependencies = TRUE)
      utils::install.packages("lme4", type = "source",
                              repos = "https://cloud.r-project.org/",
                              dependencies = TRUE)
      TRUE
    }, error = function(e) {
      cat("Source install failed:", e$message, "\n")
      cat("Trying binary install...\n")
      tryCatch({
        utils::install.packages("lme4", repos = "https://cloud.r-project.org/",
                                dependencies = TRUE)
        TRUE
      }, error = function(e2) FALSE)
    })

    if (install_ok) {
      install_log[["Matrix"]]$status <- "ok-reinstalled"
      install_log[["lme4"]]$status   <- "ok-reinstalled"
      cat("\n")
      cat("============================================================\n")
      cat("  lme4 REINSTALLED SUCCESSFULLY\n")
      cat("============================================================\n")
      cat("  ACTION REQUIRED: You MUST restart R before running any\n")
      cat("  analysis. The current session still uses the old version.\n")
      cat("\n")
      cat("  In RStudio : Session -> Restart R\n")
      cat("  In Positron: use the Restart R button\n")
      cat("============================================================\n\n")
      stop(
        "R restart required after lme4 reinstall.\n",
        "Go to: Session -> Restart R\n",
        "Then source this file again and run your analysis.",
        call. = FALSE
      )
    } else {
      cat("\n")
      cat("Automatic fix failed. Run these manually, then restart R:\n\n")
      cat("  install.packages('Matrix')\n")
      cat("  install.packages('lme4', type = 'source')\n\n")
      cat("If you do not have Rtools (Windows), install it first from:\n")
      cat("  https://cran.r-project.org/bin/windows/Rtools/\n\n")
    }
  } else {
    cat(sprintf("OK  Matrix v%s / lme4 v%s — no ABI mismatch\n\n", matrix_v, lme4_v))
  }

  # ── Summary ─────────────────────────────────────────────────────────────────

  cat("============================================================\n")
  cat("  INSTALLATION SUMMARY\n")
  cat("============================================================\n\n")

  all_ok <- TRUE
  for (pkg in packages) {
    name   <- pkg$name
    result <- install_log[[name]]
    if (!is.null(result)) {
      if (result$status %in% c("ok", "ok-reinstalled")) {
        status_line("OK  ", name, paste0("v", result$version))
      } else {
        status_line("FAIL", name, "not installed — see instructions above")
        all_ok <- FALSE
      }
    } else {
      status_line("????", name, "unknown")
      all_ok <- FALSE
    }
  }

  cat("\n")
  if (all_ok) {
    cat("All packages installed and ready.\n\n")
  } else {
    cat("Some packages failed to install.\n")
    cat("Please install them manually using install.packages()\n")
    cat("then restart R (Session -> Restart R) before proceeding.\n\n")
  }

  cat("============================================================\n")
  invisible(all_ok)
}


# =============================================================================
# SECTION 2: EXCEL IMPORTER
# =============================================================================
#
# import_excel_sheets() membaca semua sheet dari file Excel dan langsung
# membuat satu variabel per sheet di Global Environment, siap dipakai
# sebagai 'dat' di fungsi analisis.
#
# CARA PAKAI:
#   import_excel_sheets()              # buka file picker
#   import_excel_sheets("data.xlsx")   # path langsung
#
# Setelah dijalankan, setiap sheet muncul sebagai variabel, misalnya:
#   Sheet "Mortality"  -> variabel 'Mortality'  di environment
#   Sheet "HbA1c"      -> variabel 'HbA1c'      di environment
#
# Lalu langsung pakai:
#   result <- run_binary_outcome_analysis(Mortality, outcome_name = "Mortality")

import_excel_sheets <- function(file_path = file.choose()) {

  # -- Cek package -------------------------------------------------------------

  if (!requireNamespace("readxl", quietly = TRUE))
    stop("Package 'readxl' belum terinstall. Jalankan install_meta_packages() dulu.")

  # -- Validasi file -----------------------------------------------------------

  if (!file.exists(file_path))
    stop("File tidak ditemukan: ", file_path)

  ext <- tolower(tools::file_ext(file_path))
  if (!ext %in% c("xlsx", "xls", "xlsm", "xlsb"))
    stop("File harus berformat Excel (.xlsx / .xls / .xlsm / .xlsb). Diterima: .", ext)

  # -- Baca semua sheet --------------------------------------------------------

  sheet_names <- tryCatch(
    readxl::excel_sheets(file_path),
    error = function(e) stop("Gagal membaca sheet: ", e$message)
  )

  if (length(sheet_names) == 0)
    stop("File Excel tidak memiliki sheet.")

  cat("\n==========================================\n")
  cat("EXCEL IMPORTER\n")
  cat("==========================================\n")
  cat("File  :", basename(file_path), "\n")
  cat("Sheet :", length(sheet_names), "ditemukan\n\n")

  sheets <- lapply(sheet_names, function(sheet) {
    tryCatch({
      df <- readxl::read_excel(file_path, sheet = sheet)

      # Bersihkan nama kolom
      names(df) <- gsub("[^A-Za-z0-9_.]", "_", names(df))
      names(df) <- gsub("_+",             "_", names(df))
      names(df) <- gsub("^_|_$",          "",  names(df))

      cat(sprintf("  OK  %-25s [%d baris x %d kolom]\n",
                  sheet, nrow(df), ncol(df)))
      df
    }, error = function(e) {
      cat(sprintf("  FAIL %-24s gagal dibaca: %s\n", sheet, e$message))
      NULL
    })
  })

  names(sheets) <- sheet_names
  sheets_ok     <- Filter(Negate(is.null), sheets)

  if (length(sheets_ok) == 0)
    stop("Tidak ada sheet yang berhasil dibaca.")

  # -- Export ke Global Environment -------------------------------------------

  list2env(sheets_ok, envir = .GlobalEnv)

  cat("\n------------------------------------------\n")
  cat("Variabel tersedia di environment:\n")
  for (nm in names(sheets_ok))
    cat(sprintf("  - %-25s (%d baris)\n", nm, nrow(sheets_ok[[nm]])))
  cat("------------------------------------------\n")
  cat("Contoh penggunaan:\n")
  cat("  run_binary_outcome_analysis(", names(sheets_ok)[1],
      ', outcome_name = "', names(sheets_ok)[1], '")\n', sep = "")
  cat("==========================================\n\n")

  invisible(sheets_ok)
}


# =============================================================================
# SECTION 3: META-REGRESSION ENGINE (SHARED — Binary & Continuous)
# =============================================================================
#
# Dipanggil OTOMATIS oleh run_binary_outcome_analysis() dan
# run_continuous_outcome_analysis() jika ada kolom moderator.
#
# KOLOM MODERATOR DI DATASET (prefix wajib):
#   moderator_num_NamaVar   -> moderator NUMERIK / kontinu
#   moderator_cat_NamaVar   -> moderator KATEGORIK (auto dummy-coded oleh R)
#
# Contoh nama kolom:
#   moderator_num_year          moderator_num_mean_age
#   moderator_cat_design        moderator_cat_region
#
# OUTPUT PER MODERATOR:
#   - Tabel koefisien (estimate, 95% CI, p-value, R²)
#   - Bubble plot (luas bubble ∝ precision = 1/SE²)
#   - Model multivariabel jika > 1 moderator (semua sekaligus)
#   - Bubble plot per moderator dari model multivariabel
#
# CATATAN METODOLOGI:
#   - Model: metafor::rma() dengan argumen mods=
#   - Estimasi tau²: REML (sama dengan model overall)
#   - Kategorik: R otomatis buat dummy, kategori pertama = referensi
#   - R² = proporsi heterogenitas yang dijelaskan moderator
#   - Rule of thumb: butuh >= 10 studi per moderator


# ═══════════════════════════════════════════════════════════════════════════════
# PLOT DIMENSION HELPERS — prevent clipping, overlap, and collisions
# ═══════════════════════════════════════════════════════════════════════════════

# Compute optimal PNG dimensions for meta::forest plots
# Returns list(width, height) in pixels at given res (DPI)
#
# Width budget (meta::forest with n-cols active):
#   Left text cols  : studlab(~50mm) + effect(~20mm) + seTE(~20mm) +
#                     n.e(~18mm) + n.c(~18mm) = ~126mm
#   Right text cols : MD + 95%-CI + W(fixed) + W(random) ~ 20+35+25+25 = 105mm
#   Forest plot area: plotwidth ~ 60mm (set explicitly)
#   Gaps + margins  : ~70mm  (colgap.forest.left=14mm is the key buffer)
#   Total fixed     : ~361mm = ~14.2 inches; add per-char overhead for long labels
.forest_png_dims <- function(n_studies, study_labels = NULL, n_subgroup_levels = 0,
                              is_subgroup = FALSE, has_n_cols = FALSE, res = 300) {
  max_label <- if (!is.null(study_labels)) max(nchar(as.character(study_labels)), na.rm = TRUE) else 30
  # Base 14 inches covers all fixed columns; scale for long labels, subgroup headers,
  # and optional n.e/n.c columns (~1.8 inches extra for 2 sample-size columns)
  width_in  <- max(14, 11 + max_label * 0.10 +
                     if (is_subgroup) 1.5 else 0 +
                     if (has_n_cols)  1.8 else 0)
  # Height budget per meta::forest render:
  #   Per subgroup : header(1) + Common model(1) + Random model(1) + het text(1) + blank(1) = 5
  #   Bottom fixed (subgroup) : Overall Common(1) + Overall Random(1) + x-axis(1) +
  #                  overall het text(1) + test-subgroup-diff lines(2) + header(1) + padding(3) = 11
  #   Bottom fixed (overall)  : header(1) + 2 models + het text(1) + padding(2) = 6
  # Row factor 0.42 gives enough breathing room so footnotes never overlap the scale
  n_rows    <- n_studies +
               n_subgroup_levels * 5 +
               if (n_subgroup_levels > 0) 11 else 6
  height_in <- max(3, 0.8 + n_rows * 0.42)
  list(width = round(width_in * res), height = round(height_in * res))
}

# Compute optimal margins and parameters for LOO plots
# Returns list(mar, mtext_line, cex_axis, png_width, png_height)
.loo_plot_params <- function(study_labels, res = 300) {
  n <- length(study_labels)
  max_char <- max(nchar(as.character(study_labels)), na.rm = TRUE)
  # Scale cex.axis down for very long or many labels
  cex_ax <- if (max_char > 45) 0.55 else if (max_char > 35) 0.65 else if (max_char > 25) 0.75 else 0.85
  # Left margin in lines: ~0.5 lines per character at cex_ax scale, plus padding
  left_mar <- max(12, ceiling(max_char * cex_ax * 0.55) + 3)
  mtext_ln <- left_mar - 1.5
  # PNG dims
  width_in  <- max(10, 6 + max_char * cex_ax * 0.08 + 2)
  height_in <- max(4, 1.5 + n * 0.4)
  list(mar = c(5, left_mar, 4, 2),
       mtext_line = mtext_ln,
       cex_axis = cex_ax,
       png_width = round(width_in * res),
       png_height = round(height_in * res))
}

# ── P-value label helpers for forest-plot model summary rows ────────────────
# These embed p-values directly into the "Common effect model" /
# "Random effects model" label text — the only approach that works reliably
# across all meta package versions (print.pval is version-inconsistent).

# Format a single p-value into a compact display string.
.fmt_pval_fp <- function(p) {
  if (is.null(p) || length(p) != 1L || !is.finite(p)) return(NULL)
  if (p < 0.0001) return("p < 0.0001")
  if (p < 0.001)  return(sprintf("p = %.4f", p))
  sprintf("p = %.3f", p)
}

# Extract p-values from a meta object and build labelled model-row strings.
# Returns list(text.common, text.random) for meta >= 5.0.
# text.common = "Common effect model (p = …)"
# text.random = "Random effects model (p = …)"
.forest_pval_text <- function(m) {
  pv_c <- tryCatch({
    p <- if (!is.null(m[["pval.common"]])) m[["pval.common"]]
         else if (!is.null(m[["pval.fixed"]])) m[["pval.fixed"]]
         else NULL
    if (is.numeric(p) && length(p) == 1L && is.finite(p)) p else NULL
  }, error = function(e) NULL)

  pv_r <- tryCatch({
    p <- m[["pval.random"]]
    if (is.numeric(p) && length(p) == 1L && is.finite(p)) p else NULL
  }, error = function(e) NULL)

  lbl_c <- if (!is.null(pv_c))
    paste0("Common effect model (", .fmt_pval_fp(pv_c), ")")
  else "Common effect model"

  lbl_r <- if (!is.null(pv_r))
    paste0("Random effects model (", .fmt_pval_fp(pv_r), ")")
  else "Random effects model"

  list(text.common = lbl_c, text.random = lbl_r)
}

# Pipeline helper: inject p-value labels into a forest_args list.
# Also strips print.pval (unreliable across meta versions).
.forest_add_pval_text <- function(args, m) {
  args$print.pval <- NULL
  pvt <- .forest_pval_text(m)
  args$text.common <- pvt$text.common
  args$text.random <- pvt$text.random
  args
}

# Add spacing/colgap/plotwidth args to meta::forest arg lists to prevent
# box/diamond collisions and side-clipping
.forest_add_spacing <- function(args, n_studies) {
  # Spacing between rows
  if (is.null(args$spacing))
    args$spacing <- if (n_studies > 25) 0.9 else if (n_studies > 15) 1.0 else 1.1
  # Explicit forest-area width: keeps the CI plot from expanding and crowding text cols
  if (is.null(args$plotwidth))
    args$plotwidth <- "6cm"
  # Gaps between forest area and adjacent text columns.
  # colgap.forest.left = 14mm: extra buffer so het text footnote (can be ~70+ chars)
  # never reaches the x-axis scale even in worst-case long-label / high-tau² scenarios.
  if (is.null(args$colgap.forest.left))
    args$colgap.forest.left <- "14mm"
  if (is.null(args$colgap.forest.right))
    args$colgap.forest.right <- "5mm"
  if (is.null(args$colgap))
    args$colgap <- "3mm"
  args
}

# Extract treat names and sample-size vectors for forest n-columns.
# Returns list(has_n, n_e, n_c, treat1_lab, treat2_lab).
# has_n = FALSE when treat1/treat2 OR sample1/sample2 are absent/all-NA.
.forest_n_info <- function(dat) {
  has_s <- all(c("sample1", "sample2") %in% names(dat)) &&
           any(!is.na(suppressWarnings(as.numeric(as.character(dat$sample1))))) &&
           any(!is.na(suppressWarnings(as.numeric(as.character(dat$sample2)))))
  has_t <- all(c("treat1", "treat2") %in% names(dat)) &&
           any(!is.na(dat$treat1) & nzchar(trimws(as.character(dat$treat1)))) &&
           any(!is.na(dat$treat2) & nzchar(trimws(as.character(dat$treat2))))
  if (!has_s || !has_t) return(list(has_n = FALSE))

  t1 <- unique(trimws(as.character(dat$treat1[!is.na(dat$treat1)])))
  t2 <- unique(trimws(as.character(dat$treat2[!is.na(dat$treat2)])))
  t1 <- t1[nzchar(t1)]; t2 <- t2[nzchar(t2)]

  # Two-line header: treat name on line 1, "Total" on line 2
  t1_lab <- if (length(t1) >= 1) paste0(t1[1], "\nTotal") else "Group 1\nTotal"
  t2_lab <- if (length(t2) >= 1) paste0(t2[1], "\nTotal") else "Group 2\nTotal"

  list(
    has_n      = TRUE,
    n_e        = suppressWarnings(as.numeric(as.character(dat$sample1))),
    n_c        = suppressWarnings(as.numeric(as.character(dat$sample2))),
    treat1_lab = t1_lab,
    treat2_lab = t2_lab
  )
}

# Inject n-column layout into forest_args when treat names are known.
#
# Layout (left of forest):  Study | MD | SE(MD) | treat1 Total | treat2 Total
#
# WHY "effect" + "seTE" must be kept:
#   meta::forest places the heterogeneity footnote (het text) starting at the
#   LEFT EDGE of the left-column area.  Without "effect"/"seTE" the left area
#   is only ~4.1 inches wide, but het text like
#   "Heterogeneity: I² = 84.2% [74.5%; 90.3%], τ² = 86.7480, p < 0.0001"
#   needs ~4.8 inches → overflows into the forest/x-axis area → visual collision.
#   Adding "effect" + "seTE" widens the left area to ~5.0 inches → no overflow.
#
# NOTE: use "seTE" (actual metagen field) not "se" — "se" is deprecated/unavailable
#   in meta 6.x and caused "Variable 'se' not available" errors across all outcomes.
.forest_apply_n_cols <- function(args, ni) {
  if (!isTRUE(ni$has_n)) return(args)
  m      <- args[[1]]
  sm_lab <- if (!is.null(m$sm)) m$sm else "MD"
  se_lab <- paste0("SE(", sm_lab, ")")
  args$leftcols <- c("studlab", "effect", "seTE", "n.e", "n.c")
  args$leftlabs <- c("Study", sm_lab, se_lab, ni$treat1_lab, ni$treat2_lab)
  args
}

.run_metareg_v4 <- function(dat,
                             yi_col,
                             sei_col,
                             outcome_name_display,
                             outcome_safe,
                             effect_measure,
                             is_log_scale,
                             output_folder) {

  # ── Detect moderator columns ───────────────────────────────────────────────
  mod_num_cols <- grep("^moderator_num_", names(dat), value = TRUE)
  mod_cat_cols <- grep("^moderator_cat_", names(dat), value = TRUE)
  all_mod_cols <- c(mod_num_cols, mod_cat_cols)
  # Buang kolom moderator yang nama variabelnya kosong (mis. header "moderator_num_" tanpa suffix)
  all_mod_cols <- all_mod_cols[nzchar(sub("^moderator_(num|cat)_", "", all_mod_cols))]
  mod_num_cols <- mod_num_cols[nzchar(sub("^moderator_num_", "", mod_num_cols))]
  mod_cat_cols <- mod_cat_cols[nzchar(sub("^moderator_cat_", "", mod_cat_cols))]
  if (length(all_mod_cols) == 0) return(invisible(NULL))

  cat("\n==========================================\n")
  cat("META-REGRESSION\n")
  cat("==========================================\n")
  cat("Outcome  :", outcome_name_display, "\n")
  cat("Moderator ditemukan:\n")
  for (col in mod_num_cols) cat("  [numerik]   ", sub("^moderator_num_", "", col), "\n")
  for (col in mod_cat_cols) cat("  [kategorik] ", sub("^moderator_cat_", "", col), "\n")
  cat("\n")

  safe_dev_off <- function() {
    while (grDevices::dev.cur() > 1)
      tryCatch(grDevices::dev.off(), error = function(e) NULL)
  }

  # ── Ambil yi dan sei sebagai numeric murni ─────────────────────────────────
  yi_all  <- suppressWarnings(as.numeric(as.character(dat[[yi_col]])))
  sei_all <- suppressWarnings(as.numeric(as.character(dat[[sei_col]])))

  reg_results  <- list()
  multi_result <- NULL

  # ── Helper: build mods matrix tanpa formula ────────────────────────────────
  .make_mods <- function(v, is_num) {
    if (is_num) {
      m <- matrix(as.numeric(v), ncol = 1)
      colnames(m) <- "moderator"
    } else {
      fv  <- factor(as.character(v))
      lev <- levels(fv)
      if (length(lev) < 2) stop("Faktor hanya punya 1 level")
      m <- matrix(0L, nrow = length(fv), ncol = length(lev) - 1)
      for (j in seq_len(ncol(m))) m[, j] <- as.integer(fv == lev[j + 1])
      colnames(m) <- lev[-1]
    }
    m
  }

  # ── Helper: extract pval dari koefisien (kompatibel metafor 3.x dan 4.x) ──
  .get_pval <- function(coef_row) {
    # metafor 4.x: kolom "pval"; metafor 3.x: kolom "pval" atau hitung dari zval/tval
    if ("pval" %in% names(coef_row)) return(as.numeric(coef_row[["pval"]]))
    if ("zval" %in% names(coef_row)) {
      z <- as.numeric(coef_row[["zval"]])
      return(2 * stats::pnorm(-abs(z)))
    }
    if ("tval" %in% names(coef_row)) {
      t <- as.numeric(coef_row[["tval"]])
      return(2 * stats::pt(-abs(t), df = Inf))
    }
    NA_real_
  }

  cat("--- Univariabel meta-regresi ---\n\n")

  for (col in all_mod_cols) {

    is_num       <- grepl("^moderator_num_", col)
    mod_name     <- sub("^moderator_(num|cat)_", "", col)
    mod_label    <- gsub("_", " ", mod_name)
    mod_safe     <- gsub("[^A-Za-z0-9]", "_", mod_name)
    mod_type_str <- if (is_num) "numerik" else "kategorik"

    mod_raw <- suppressWarnings(
      if (is_num) as.numeric(as.character(dat[[col]]))
      else        as.character(dat[[col]])
    )

    # Baris valid: yi, sei, dan moderator semua tidak NA
    keep <- !is.na(yi_all) & !is.na(sei_all) & !is.na(mod_raw)
    n_valid <- sum(keep)

    if (n_valid < 3) {
      warning("Moderator '", mod_name, "': hanya ", n_valid, " nilai valid. Dilewati.")
      next
    }
    if (n_valid < 10) {
      warning("Moderator '", mod_name, "': hanya ", n_valid,
              " studi — hasil meta-regresi perlu diinterpretasi dengan hati-hati (rule of thumb >= 10).")
    }

    cat(sprintf("Moderator: %s (%s) — %d studi valid\n", mod_label, mod_type_str, n_valid))

    tryCatch({

      yi_use  <- yi_all[keep]
      sei_use <- sei_all[keep]
      mod_use <- mod_raw[keep]

      mods_mat <- .make_mods(mod_use, is_num)

      res_reg <- metafor::rma(
        yi     = yi_use,
        sei    = sei_use,
        mods   = mods_mat,
        method = "REML"
      )

      # ── Koefisien — akses langsung dari slot objek rma (robust semua versi) ──
      # res_reg$beta  = matrix estimate (nrow = n_coef, ncol = 1)
      # res_reg$se    = vector SE
      # res_reg$pval  = vector p-value
      est   <- as.numeric(res_reg$beta)
      se    <- as.numeric(res_reg$se)
      pvals <- as.numeric(res_reg$pval)
      terms <- rownames(res_reg$beta)

      # Rename: intrcpt → Intercept, kolom moderator → nama asli
      terms <- sub("^intrcpt$", "Intercept", terms)
      if (is_num) {
        terms <- sub("^moderator$", mod_label, terms)
      } else {
        fv  <- factor(mod_use)
        lev <- levels(fv)
        for (j in seq_len(ncol(mods_mat)))
          terms <- sub(paste0("^", lev[j + 1], "$"),
                       paste0(mod_label, ": ", lev[j + 1]), terms)
      }

      r2 <- tryCatch(if (is.finite(res_reg$R2)) res_reg$R2 else NA_real_,
                     error = function(e) NA_real_)

      cat(sprintf("  R² = %.1f%%   tau² = %.6f   p(moderator) = %.4f\n",
                  ifelse(is.na(r2), 0, r2), res_reg$tau2, res_reg$QMp))

      # Back-transform display
      if (is_log_scale) {
        est_disp  <- exp(est)
        ci_lb_disp <- exp(est - 1.96 * se)
        ci_ub_disp <- exp(est + 1.96 * se)
      } else {
        est_disp  <- est
        ci_lb_disp <- est - 1.96 * se
        ci_ub_disp <- est + 1.96 * se
      }

      for (i in seq_along(terms)) {
        cat(sprintf("  %-35s  est=%8.4f  [%8.4f; %8.4f]  p=%s\n",
                    terms[i], est[i],
                    est[i] - 1.96 * se[i],
                    est[i] + 1.96 * se[i],
                    formatC(pvals[i], format = "g", digits = 3)))
      }
      cat("\n")

      coef_out <- data.frame(
        term            = terms,
        estimate        = est,
        se              = se,
        ci_lb           = est - 1.96 * se,
        ci_ub           = est + 1.96 * se,
        pval            = pvals,
        estimate_display = est_disp,
        ci_lb_display   = ci_lb_disp,
        ci_ub_display   = ci_ub_disp,
        stringsAsFactors = FALSE
      )

      utils::write.csv(
        coef_out,
        file.path(output_folder, paste0("metareg_coef_", mod_safe, "_", outcome_safe, ".csv")),
        row.names = FALSE
      )

      reg_results[[col]] <- list(
        model    = res_reg,
        coef_df  = coef_out,
        r2       = r2,
        mod_name = mod_label,
        mod_type = mod_type_str,
        mod_vec  = mod_use,
        mod_safe = mod_safe
      )

      # ── Bubble plot ──────────────────────────────────────────────────────
      wi_use <- ifelse(sei_use > 0, 1 / sei_use^2, NA_real_)

      .draw_bubble_uni <- function() {
        if (is_num) {
          mv     <- as.numeric(mod_use)
          x_seq  <- seq(min(mv, na.rm=TRUE), max(mv, na.rm=TRUE), length.out = 200)
          pred   <- tryCatch(
            metafor::predict.rma(res_reg, newmods = matrix(x_seq, ncol=1)),
            error = function(e) NULL
          )
          y_vals <- if (is_log_scale) exp(yi_use) else yi_use
          bsz    <- 0.5 + 3 * (wi_use / max(wi_use, na.rm=TRUE))
          y_lab  <- paste("Effect Size (", effect_measure, ")")
          graphics::plot(mv, y_vals, cex=bsz, pch=21,
                         bg=grDevices::adjustcolor("steelblue", .55),
                         col="steelblue4", xlab=mod_label, ylab=y_lab,
                         log=if(is_log_scale) "y" else "",
                         main=paste0("Bubble Plot — Meta-Regresi\n",
                                     outcome_name_display, "  |  ", mod_label))
          if (!is.null(pred)) {
            yp <- if (is_log_scale) exp(pred$pred) else pred$pred
            yl <- if (is_log_scale) exp(pred$ci.lb) else pred$ci.lb
            yu <- if (is_log_scale) exp(pred$ci.ub) else pred$ci.ub
            graphics::polygon(c(x_seq, rev(x_seq)), c(yl, rev(yu)),
                              col=grDevices::adjustcolor("steelblue",.15), border=NA)
            graphics::lines(x_seq, yp, lwd=2, col="steelblue4")
          }
          graphics::abline(h=if(is_log_scale) 1 else 0, lty=3, col="gray50")
          r2v <- if (!is.na(r2)) r2 else 0
          graphics::legend("topright", bty="n", cex=.9,
                           legend=c(paste0("R² = ", round(r2v,1), "%"),
                                    paste0("p  = ", formatC(as.numeric(res_reg$QMp), format="g", digits=3))))
        } else {
          mv      <- as.character(mod_use)
          cats    <- sort(unique(mv))
          cat_idx <- match(mv, cats)
          jy      <- cat_idx + stats::runif(length(cat_idx), -.25, .25)
          y_vals  <- if (is_log_scale) exp(yi_use) else yi_use
          bsz     <- 0.5 + 2.5 * (wi_use / max(wi_use, na.rm=TRUE))
          xlim_r  <- range(y_vals, na.rm=TRUE)
          xlim_r  <- xlim_r + c(-1,1) * diff(xlim_r) * .15
          graphics::par(mar=c(5,9,4,2))
          graphics::plot(y_vals, jy, cex=bsz, pch=21,
                         bg=grDevices::adjustcolor("steelblue", .55),
                         col="steelblue4",
                         xlab=paste("Effect Size (", effect_measure, ")"),
                         ylab="", yaxt="n",
                         xlim=xlim_r, ylim=c(.5, length(cats)+.5),
                         log=if(is_log_scale) "x" else "",
                         main=paste0("Bubble Plot — Meta-Regresi\n",
                                     outcome_name_display, "  |  ", mod_label))
          graphics::axis(2, at=seq_along(cats), labels=cats, las=2, cex.axis=.9)
          graphics::abline(v=if(is_log_scale) 1 else 0, lty=3, col="gray50")
          r2v <- if (!is.na(r2)) r2 else 0
          graphics::legend("topright", bty="n", cex=.9,
                           legend=c(paste0("R² = ", round(r2v,1), "%"),
                                    paste0("p  = ", formatC(as.numeric(res_reg$QMp), format="g", digits=3))))
        }
      }

      tryCatch(.draw_bubble_uni(),
               error = function(e) warning("Bubble plot viewer gagal: ", e$message))

      tryCatch({
        grDevices::png(
          file.path(output_folder,
                    paste0("metareg_bubble_", mod_safe, "_", outcome_safe, ".png")),
          width=1400, height=1200, res=150)
        .draw_bubble_uni()
        grDevices::dev.off()
        cat(sprintf("  OK Bubble plot '%s' disimpan\n\n", mod_label))
      }, error = function(e) { safe_dev_off(); warning("Gagal simpan bubble plot: ", e$message) })

    }, error = function(e) {
      warning("Meta-regresi gagal untuk moderator '", mod_name, "': ", e$message)
    })
  }

  # ── Multivariable (jika >= 2 moderator berhasil) ───────────────────────────
  valid_cols <- names(reg_results)

  if (length(valid_cols) >= 2) {
    cat("--- Multivariabel meta-regresi ---\n")
    mod_labels_all <- sapply(valid_cols, function(x) sub("^moderator_(num|cat)_","",x))
    cat("Moderator:", paste(gsub("_"," ", mod_labels_all), collapse=" + "), "\n\n")

    tryCatch({
      # Kumpulkan baris valid untuk semua moderator sekaligus
      all_mods_raw <- lapply(valid_cols, function(vc) {
        is_n <- grepl("^moderator_num_", vc)
        if (is_n) suppressWarnings(as.numeric(as.character(dat[[vc]])))
        else as.character(dat[[vc]])
      })
      keep_all <- !is.na(yi_all) & !is.na(sei_all) &
        Reduce("&", lapply(all_mods_raw, function(v) !is.na(v)))

      yi_m   <- yi_all[keep_all]
      sei_m  <- sei_all[keep_all]

      # Build mods matrix kolom per kolom
      mods_parts <- lapply(seq_along(valid_cols), function(k) {
        vc   <- valid_cols[k]
        is_n <- grepl("^moderator_num_", vc)
        lbl  <- gsub("_"," ", sub("^moderator_(num|cat)_","",vc))
        v    <- all_mods_raw[[k]][keep_all]
        m    <- .make_mods(v, is_n)
        if (!is_n) colnames(m) <- paste0(lbl, ": ", colnames(m))
        else       colnames(m) <- lbl
        m
      })
      mods_multi <- do.call(cbind, mods_parts)

      res_multi <- metafor::rma(
        yi = yi_m, sei = sei_m,
        mods = mods_multi, method = "REML"
      )

      r2_multi <- tryCatch(if (is.finite(res_multi$R2)) res_multi$R2 else NA_real_,
                           error = function(e) NA_real_)

      cat(sprintf("  R² total = %.1f%%   tau² = %.6f   p(model) = %.4f\n\n",
                  ifelse(is.na(r2_multi),0,r2_multi), res_multi$tau2, res_multi$QMp))

      est_m  <- as.numeric(res_multi$beta)
      se_m   <- as.numeric(res_multi$se)
      pv_m   <- as.numeric(res_multi$pval)
      trms_m <- sub("^intrcpt$", "Intercept", rownames(res_multi$beta))

      for (i in seq_along(trms_m)) {
        p_str <- if (is.na(pv_m[i])) "NA" else formatC(as.numeric(pv_m[i]), format="g", digits=3)
        cat(sprintf("  %-35s  est=%8.4f  [%8.4f; %8.4f]  p=%s\n",
                    trms_m[i], est_m[i],
                    est_m[i]-1.96*se_m[i], est_m[i]+1.96*se_m[i],
                    p_str))
      }
      cat("\n")

      coef_multi_out <- data.frame(
        term=trms_m, estimate=est_m, se=se_m,
        ci_lb=est_m-1.96*se_m, ci_ub=est_m+1.96*se_m, pval=pv_m,
        stringsAsFactors=FALSE)
      utils::write.csv(coef_multi_out,
        file.path(output_folder, paste0("metareg_multivariable_", outcome_safe, ".csv")),
        row.names=FALSE)

      multi_result <- list(model=res_multi, coef_df=coef_multi_out, r2=r2_multi)

    }, error = function(e) warning("Multivariabel meta-regresi gagal: ", e$message))
  }

  cat("OK Meta-regresi selesai\n")
  cat("==========================================\n\n")

  invisible(list(univariable=reg_results, multivariable=multi_result))
}


# =============================================================================
# SECTION 4: BINARY OUTCOME ENGINE (OR / RR / HR)
# =============================================================================

run_binary_outcome_analysis <- function(dat,
                                        outcome_name,
                                        effect_measure      = "OR",
                                        tau_method          = "REML",
                                        exclude_doublezero  = FALSE) {

  # ── Load packages ────────────────────────────────────────────────────────────

  for (pkg in c("metafor", "meta")) {
    if (!requireNamespace(pkg, quietly = TRUE))
      stop(paste0("Package '", pkg, "' not installed. Run install_meta_packages() first."))
  }

  # ── Validate effect measure ──────────────────────────────────────────────────

  effect_measure <- toupper(trimws(effect_measure))
  if (!(effect_measure %in% c("OR", "RR", "HR")))
    stop("effect_measure must be one of: OR, RR, HR")

  # ── Validate outcome name ────────────────────────────────────────────────────

  if (missing(outcome_name) || is.null(outcome_name) || trimws(outcome_name) == "")
    stop("outcome_name cannot be empty")
  outcome_name_display <- gsub("[_-]", " ", outcome_name)
  outcome_safe <- trimws(gsub("_+", "_", gsub("[^A-Za-z0-9]", "_", outcome_name_display)),
                         whitespace = "_")

  # ── Validate data frame ──────────────────────────────────────────────────────

  if (missing(dat) || is.null(dat)) stop("Argument 'dat' is required")
  if (!is.data.frame(dat))           stop("'dat' must be a data.frame")
  if (nrow(dat) < 2)                 stop("At least 2 studies required")
  if (!"study" %in% names(dat))     stop("Column 'study' not found")

  for (col in c("sample1", "sample2")) {
    if (!col %in% names(dat))
      stop(paste("Required column missing:", col))
  }

  # ── Create output folder ─────────────────────────────────────────────────────

  timestamp     <- format(Sys.time(), "%Y%m%d_%H%M%S")
  output_folder <- .resolve_output_folder(paste0("MetaAnalysis_", outcome_safe, "_", timestamp))

  cat("\n==========================================\n")
  cat("META-ANALYSIS ENGINE PRO — BINARY\n")
  cat("==========================================\n")
  cat("Outcome       :", outcome_name_display, "\n")
  cat("Effect measure:", effect_measure, "\n")
  cat("Output folder :", output_folder, "\n\n")

  original_wd <- getwd()
  on.exit(setwd(original_wd), add = TRUE)
  setwd(output_folder)

  # ── Helpers ──────────────────────────────────────────────────────────────────

  safe_dev_off <- function() {
    while (grDevices::dev.cur() > 1)
      tryCatch(grDevices::dev.off(), error = function(e) NULL)
  }

  # Reset semua graphics device yang mungkin terbuka dari sesi sebelumnya
  safe_dev_off()
  graphics::par(mfrow = c(1, 1), mar = c(5.1, 4.1, 4.1, 2.1), oma = c(0,0,0,0))

  yi_is_empty <- function(x) is.na(x) | (is.character(x) & trimws(as.character(x)) == "")

  # ── Coerce columns ───────────────────────────────────────────────────────────

  has_event_cols <- all(c("event1", "event2") %in% names(dat))
  has_raw_data   <- has_event_cols
  has_yi_col     <- "yi" %in% names(dat)

  if (!has_yi_col) { dat$yi <- NA_real_; dat$lowci <- NA_real_; dat$highci <- NA_real_ }

  for (col in c("yi", "lowci", "highci", "sample1", "sample2"))
    dat[[col]] <- suppressWarnings(as.numeric(as.character(dat[[col]])))
  if (has_event_cols)
    for (col in c("event1", "event2"))
      dat[[col]] <- suppressWarnings(as.numeric(as.character(dat[[col]])))

  # ── Auto-calculate from 2×2 ──────────────────────────────────────────────────

  if (has_raw_data) {
    rows_need_calc <- which(yi_is_empty(dat$yi))
    if (length(rows_need_calc) > 0) {
      cat("Info: Auto-calculating effect sizes from 2x2 data...\n")
      for (i in rows_need_calc) {
        e1 <- dat$event1[i]; n1 <- dat$sample1[i]
        e2 <- dat$event2[i]; n2 <- dat$sample2[i]
        lbl <- as.character(dat$study[i])
        if (any(is.na(c(e1, n1, e2, n2)))) { warning("Row ", i, " (", lbl, "): incomplete 2x2. Skipped."); next }
        if (e1 < 0 || e2 < 0 || n1 <= 0 || n2 <= 0) { warning("Row ", i, " (", lbl, "): invalid values. Skipped."); next }
        if (e1 > n1 || e2 > n2) { warning("Row ", i, " (", lbl, "): events exceed n. Skipped."); next }
        escalc_measure <- if (effect_measure == "HR") { warning("Row ", i, " (", lbl, "): HR approximated as RR."); "RR" } else effect_measure
        tryCatch({
          result <- metafor::escalc(measure = escalc_measure,
                                    ai = e1, n1i = n1, ci = e2, n2i = n2,
                                    add = 0.5, to = "only0")
          yi_log <- result$yi; sei <- sqrt(result$vi)
          dat$yi[i]    <- exp(yi_log)
          dat$lowci[i] <- exp(yi_log - 1.96 * sei)
          dat$highci[i]<- exp(yi_log + 1.96 * sei)
          cat(sprintf("  OK Row %d (%s): %s = %.4f [%.4f; %.4f]\n",
                      i, lbl, effect_measure, dat$yi[i], dat$lowci[i], dat$highci[i]))
        }, error = function(e) warning("Row ", i, " (", lbl, "): ", e$message))
      }
      cat("\n")
    }
  }

  # ── Drop incomplete rows ─────────────────────────────────────────────────────

  rows_complete <- !is.na(dat$yi) & !is.na(dat$lowci) & !is.na(dat$highci)
  if (sum(rows_complete) < nrow(dat)) {
    for (s in as.character(dat$study[!rows_complete]))
      warning("Row '", s, "' dropped: missing yi/lowci/highci after calculation")
    dat <- dat[rows_complete, ]
  }
  if (nrow(dat) < 2)
    stop("Fewer than 2 valid studies after cleaning.\nEnsure each study has yi+lowci+highci OR event1+sample1+event2+sample2.")
  if (any(dat$yi <= 0, na.rm = TRUE))    stop("yi must be > 0")
  if (any(dat$lowci <= 0, na.rm = TRUE)) stop("lowci must be > 0")
  if (any(dat$lowci >= dat$highci, na.rm = TRUE)) stop("lowci must be < highci for all rows")

  cat("OK Dataset valid — studies:", nrow(dat), "\n\n")

  # ── Exclude double-zero studies ──────────────────────────────────────────────

  if (isTRUE(exclude_doublezero) && all(c("event1", "event2") %in% names(dat))) {
    e1 <- suppressWarnings(as.numeric(as.character(dat$event1)))
    e2 <- suppressWarnings(as.numeric(as.character(dat$event2)))
    dz <- !is.na(e1) & !is.na(e2) & e1 == 0 & e2 == 0
    if (any(dz)) {
      cat(sprintf("  INFO: exclude_doublezero=TRUE — exclude %d studi (event1=0 & event2=0): %s\n",
                  sum(dz), paste(as.character(dat$study[dz]), collapse = ", ")))
      dat <- dat[!dz, , drop = FALSE]
      if (nrow(dat) < 2)
        stop("Kurang dari 2 studi tersisa setelah exclude double-zero.")
    }
  }

  # ── Validasi tau_method ──────────────────────────────────────────────────────

  tau_method <- toupper(trimws(as.character(tau_method)))
  if (!tau_method %in% c("REML", "DL", "PM", "EB", "SJ", "ML", "GENQ")) {
    warning("tau_method '", tau_method, "' tidak dikenal — menggunakan REML.")
    tau_method <- "REML"
  }

  # ── Subgroup detection ───────────────────────────────────────────────────────

  subgroup_cols <- grep("^subgroup_", names(dat), value = TRUE)
  if (length(subgroup_cols) > 0) {
    cat("OK Subgroup columns detected:\n")
    cat(paste("  -", subgroup_cols, collapse = "\n"), "\n\n")
  }

  # ── Log transform & SE ──────────────────────────────────────────────────────

  dat$yi_log <- log(dat$yi)
  dat$sei    <- (log(dat$highci) - log(dat$lowci)) / (2 * 1.96)
  if (any(!is.finite(dat$yi_log))) stop("Non-finite values after log transform.")
  if (any(!is.finite(dat$sei)) || any(dat$sei <= 0)) stop("Invalid standard errors.")

  # ── Overall meta-analysis ────────────────────────────────────────────────────

  cat(sprintf("Running overall meta-analysis (tau method: %s)...\n", tau_method))
  res <- tryCatch(
    metafor::rma(yi = yi_log, sei = sei, data = dat, method = tau_method, slab = dat$study),
    error = function(e) {
      if (tau_method == "REML") {
        warning("REML tidak konvergen untuk '", outcome_name_display,
                "' — fallback ke DL. Detail: ", e$message)
        tryCatch(
          metafor::rma(yi = yi_log, sei = sei, data = dat, method = "DL", slab = dat$study),
          error = function(e2) stop("Error in rma() [DL fallback]: ", e2$message)
        )
      } else {
        stop("Error in rma() [", tau_method, "]: ", e$message)
      }
    })
  .tau_used <- if (!is.null(res$method) && res$method != tau_method) res$method else tau_method
  if (.tau_used != tau_method)
    cat(sprintf("  INFO: %s tidak konvergen — menggunakan %s.\n", tau_method, .tau_used))
  # ── Detect treat names & sample sizes for n-columns in forest plots ──────────

  .ni <- .forest_n_info(dat)

  # Build metagen args; include n.e/n.c when sample sizes are known
  .metagen_args_overall <- list(TE = dat$yi_log, seTE = dat$sei, studlab = dat$study,
                                sm = effect_measure, method.tau = .tau_used)
  if (.ni$has_n) { .metagen_args_overall$n.e <- .ni$n_e; .metagen_args_overall$n.c <- .ni$n_c }
  m_overall <- tryCatch(
    do.call(meta::metagen, .metagen_args_overall),
    error = function(e) stop("Error in metagen(): ", e$message))
  cat("OK Overall meta-analysis done\n\n")

  # ── Forest plot — overall ────────────────────────────────────────────────────

  cat("Creating forest plot...\n")
  forest_args <- list(m_overall, comb.fixed = TRUE, overall = TRUE,
                      overall.hetstat = TRUE, print.I2 = TRUE, digits = 2,
                      leftlabs = "Study", rightlabs = c(effect_measure, "95% CI"),
                      main = paste("Forest Plot -", outcome_name_display, "(", effect_measure, ")"))
  forest_args <- .forest_add_spacing(forest_args, nrow(dat))
  forest_args <- .forest_apply_n_cols(forest_args, .ni)
  forest_args <- .forest_add_pval_text(forest_args, m_overall)
  tryCatch(do.call(meta::forest, forest_args),
           error = function(e) warning("Cannot display forest plot: ", e$message))
  .fp_dims <- .forest_png_dims(nrow(dat), dat$study, has_n_cols = .ni$has_n)
  tryCatch({
    grDevices::png(paste0("forest_overall_", outcome_safe, ".png"),
                   width = .fp_dims$width, height = .fp_dims$height, res = 300)
    do.call(meta::forest, forest_args)
    grDevices::dev.off()
    cat("OK Forest plot saved\n")
  }, error = function(e) { safe_dev_off(); warning("Failed to save forest plot: ", e$message) })

  # ── Subgroup analysis ────────────────────────────────────────────────────────

  subgroup_results <- list()

  for (sg_col in subgroup_cols) {
    sg_name         <- sub("^subgroup_", "", sg_col)
    sg_name_display <- gsub("_", " ", sg_name)
    sg_name_safe    <- gsub("[^A-Za-z0-9]", "_", sg_name)
    sg_values       <- dat[[sg_col]]

    if (all(is.na(sg_values))) { warning("Column '", sg_col, "' all NA. Skipped."); next }
    n_levels <- length(unique(na.omit(sg_values)))
    if (n_levels < 2) { warning("Column '", sg_col, "' has 1 level. Skipped."); next }
    n_na_sg <- sum(is.na(sg_values))
    if (n_na_sg > 0) {
      message("Subgroup '", sg_name_display, "': ", n_na_sg,
              " studi tidak punya nilai subgroup — diisi 'Unknown'.")
      sg_values[is.na(sg_values)] <- "Unknown"
      n_levels <- length(unique(na.omit(sg_values)))
      if (n_levels < 2) { warning("Column '", sg_col, "' has 1 level after NA fill. Skipped."); next }
    }

    cat("Running subgroup analysis:", sg_name_display, "\n")
    tryCatch({
      .metagen_args_sg <- list(TE = dat$yi_log, seTE = dat$sei, studlab = dat$study,
                               sm = effect_measure, method.tau = "REML",
                               subgroup = sg_values, print.subgroup.name = FALSE)
      if (.ni$has_n) { .metagen_args_sg$n.e <- .ni$n_e; .metagen_args_sg$n.c <- .ni$n_c }
      m_sg <- do.call(meta::metagen, .metagen_args_sg)
      sg_forest_args <- list(m_sg, comb.fixed = TRUE, overall = TRUE,
                             overall.hetstat = TRUE, print.I2 = TRUE, print.I2.ci = TRUE,
                             digits = 2, leftlabs = "Study",
                             rightlabs = c(effect_measure, "95% CI"),
                             main = paste("Subgroup:", sg_name_display, "\n",
                                          outcome_name_display, "(", effect_measure, ")"))
      sg_forest_args <- .forest_add_spacing(sg_forest_args, nrow(dat))
      sg_forest_args <- .forest_apply_n_cols(sg_forest_args, .ni)
      sg_forest_args <- .forest_add_pval_text(sg_forest_args, m_sg)
      tryCatch(do.call(meta::forest, sg_forest_args),
               error = function(e) warning("Cannot display subgroup plot: ", e$message))
      .sg_dims <- .forest_png_dims(nrow(dat), dat$study,
                                   n_subgroup_levels = n_levels, is_subgroup = TRUE,
                                   has_n_cols = .ni$has_n)
      tryCatch({
        grDevices::png(paste0("forest_subgroup_", sg_name_safe, "_", outcome_safe, ".png"),
                       width = .sg_dims$width, height = .sg_dims$height, res = 300)
        do.call(meta::forest, sg_forest_args)
        grDevices::dev.off()
        cat("  OK Subgroup plot saved\n")
      }, error = function(e) { safe_dev_off(); warning("Failed to save subgroup plot: ", e$message) })
      subgroup_results[[sg_col]] <- m_sg
    }, error = function(e) warning("Subgroup error '", sg_col, "': ", e$message))
  }

  # ── Publication bias ─────────────────────────────────────────────────────────

  cat("\nRunning publication bias tests...\n")
  taf <- egger <- begg <- NULL
  n_pub_studies <- sum(!is.na(res$yi))

  if (n_pub_studies < 3) {
    message("Publication bias tests dilewati: hanya ", n_pub_studies,
            " studi (minimum 3 untuk trim-and-fill & Begg, minimum 10 untuk Egger).")
  } else {
    # Trim-and-fill & Begg: valid mulai 3 studi
    tryCatch({
      taf  <- metafor::trimfill(res)
      begg <- metafor::ranktest(res)
      cat("OK Trim-and-fill & Begg done\n")
    }, error = function(e) warning("Trim-and-fill/Begg failed: ", e$message))

    # Egger: butuh minimal 10 studi agar reliable
    if (n_pub_studies < 10) {
      message("Egger test dilewati: hanya ", n_pub_studies,
              " studi (disarankan >= 10).")
    } else {
      tryCatch({
        egger <- metafor::regtest(res, model = "lm")
        cat("OK Egger test done\n")
      }, error = function(e) warning("Egger test failed: ", e$message))
    }
  }

  funnel_args <- list(res, xlab = paste("Log", effect_measure),
                      main = paste("Funnel Plot -", outcome_name_display, "(", effect_measure, ")"))
  tryCatch(do.call(metafor::funnel, funnel_args),
           error = function(e) warning("Cannot display funnel plot: ", e$message))
  tryCatch({
    grDevices::png(paste0("funnel_standard_", outcome_safe, ".png"), width = 3000, height = 2400, res = 300)
    do.call(metafor::funnel, funnel_args)
    grDevices::dev.off()
    cat("OK Standard funnel plot saved\n")
  }, error = function(e) { safe_dev_off(); warning("Failed to save funnel plot: ", e$message) })

  if (!is.null(taf)) {
    taf_args <- list(taf, xlab = paste("Log", effect_measure),
                     main = paste("Trim-and-Fill\n", outcome_name_display, "(", effect_measure, ")"))
    tryCatch(do.call(metafor::funnel, taf_args),
             error = function(e) warning("Cannot display trim-fill funnel: ", e$message))
    tryCatch({
      grDevices::png(paste0("funnel_trimfill_", outcome_safe, ".png"), width = 3000, height = 2400, res = 300)
      do.call(metafor::funnel, taf_args)
      grDevices::dev.off()
      cat("OK Trim-and-fill funnel saved\n")
    }, error = function(e) { safe_dev_off(); warning("Failed to save trim-fill funnel: ", e$message) })
  }

  # ── Leave-one-out ────────────────────────────────────────────────────────────

  cat("\nRunning leave-one-out analysis...\n")
  loo_obj <- loo_results <- NULL

  tryCatch({
    loo_obj <- metafor::leave1out(res)
    loo_results <- data.frame(
      omitted_study = as.character(loo_obj$slab),
      pooled_effect = exp(loo_obj$estimate),
      CI_lower      = exp(loo_obj$ci.lb),
      CI_upper      = exp(loo_obj$ci.ub),
      p_value       = round(loo_obj$pval, 5)
    )
    utils::write.csv(loo_results, paste0("leave_one_out_", outcome_safe, ".csv"), row.names = FALSE)
    loo_sorted <- loo_results[order(loo_results$pooled_effect), ]
    .loo_p <- .loo_plot_params(loo_sorted$omitted_study)

    draw_loo_binary <- function() {
      graphics::par(mar = .loo_p$mar)
      xlim_range <- range(c(loo_sorted$CI_lower, loo_sorted$CI_upper))
      graphics::plot(loo_sorted$pooled_effect, seq_along(loo_sorted$pooled_effect),
                     xlim = xlim_range, xlab = paste("Pooled", effect_measure, "(Leave-One-Out)"),
                     ylab = "", pch = 19, yaxt = "n",
                     main = paste("Leave-One-Out -", outcome_name_display, "(", effect_measure, ")"))
      graphics::mtext("Omitted study", side = 2, line = .loo_p$mtext_line, cex = 0.95, font = 2)
      graphics::axis(2, at = seq_along(loo_sorted$pooled_effect),
                     labels = loo_sorted$omitted_study, las = 2, cex.axis = .loo_p$cex_axis)
      graphics::segments(loo_sorted$CI_lower, seq_along(loo_sorted$pooled_effect),
                         loo_sorted$CI_upper, seq_along(loo_sorted$pooled_effect))
      graphics::abline(v = exp(res$b), lty = 2, lwd = 2, col = "red")
    }
    tryCatch(draw_loo_binary(), error = function(e) warning("Cannot display LOO plot: ", e$message))
    tryCatch({
      grDevices::png(paste0("leave_one_out_", outcome_safe, ".png"),
                     width = .loo_p$png_width, height = .loo_p$png_height, res = 300)
      draw_loo_binary()
      grDevices::dev.off()
      cat("OK Leave-one-out done\n")
    }, error = function(e) { safe_dev_off(); warning("Failed to save LOO plot: ", e$message) })
  }, error = function(e) warning("Leave-one-out error: ", e$message))

  # ── Meta-regression ───────────────────────────────────────────────────────────

  metareg_results <- .run_metareg_v4(
    dat                  = dat,
    yi_col               = "yi_log",
    sei_col              = "sei",
    outcome_name_display = outcome_name_display,
    outcome_safe         = outcome_safe,
    effect_measure       = effect_measure,
    is_log_scale         = TRUE,
    output_folder        = output_folder
  )

  # ── Text report ──────────────────────────────────────────────────────────────

  cat("\nGenerating report...\n")
  tryCatch({
    report_file <- paste0("report_", outcome_safe, ".txt")
    report_conn <- file(report_file, open = "w")
    wl <- function(...) writeLines(paste0(...), report_conn)

    wl("========================================")
    wl("META-ANALYSIS REPORT — BINARY OUTCOME")
    wl("========================================")
    wl("")
    wl("Outcome       : ", outcome_name_display)
    wl("Effect measure: ", effect_measure)
    wl("Date          : ", format(Sys.time(), "%Y-%m-%d %H:%M:%S"))
    wl("")
    wl("Number of studies : ", nrow(dat))
    wl("Group 1 (n)       : ", sum(dat$sample1, na.rm = TRUE))
    wl("Group 2 (n)       : ", sum(dat$sample2, na.rm = TRUE))
    wl("Total N           : ", sum(dat$sample1, na.rm = TRUE) + sum(dat$sample2, na.rm = TRUE))
    wl("")
    wl("========================================")
    wl("OVERALL RESULT")
    wl("========================================")
    wl("")
    wl("Pooled ", effect_measure, " : ", round(exp(res$b[1]), 4))
    wl("95% CI        : ", round(exp(res$ci.lb), 4), " - ", round(exp(res$ci.ub), 4))
    wl("P-value       : ", formatC(res$pval, format = "g", digits = 5))
    model_type <- "Random-effects (REML)"
    if (!is.null(res$tau2) && res$tau2 < 1e-6) model_type <- paste0(model_type, " — tau2 ~ 0")
    wl("Model         : ", model_type)
    wl("")
    wl("HETEROGENEITY")
    wl("I2  : ", round(res$I2, 2), "%")
    wl("tau2: ", round(res$tau2, 6))
    wl("Q   : ", round(res$QE, 4), " (df=", res$k - 1, ", p=",
       formatC(res$QEp, format = "g", digits = 4), ")")
    wl("")
    if (!is.null(taf) || !is.null(begg) || !is.null(egger)) {
      wl("========================================")
      wl("PUBLICATION BIAS")
      wl("========================================")
      if (!is.null(egger)) {
        wl("Egger's test p-value: ", round(egger$pval, 5))
      } else {
        wl("Egger's test        : tidak dijalankan (studi < 10)")
      }
      if (!is.null(begg)) {
        wl("Begg's test p-value : ", round(begg$pval, 5))
      } else {
        wl("Begg's test         : tidak dijalankan (studi < 3)")
      }
      if (!is.null(taf)) {
        wl("Trim-and-Fill — studies imputed: ", taf$k0)
        if (taf$k0 > 0)
          wl("  Adjusted ", effect_measure, ": ", round(exp(taf$beta), 4),
             " [", round(exp(taf$ci.lb), 4), "; ", round(exp(taf$ci.ub), 4), "]")
        else
          wl("  Trim-and-Fill: tidak ada studi yang di-impute")
      } else {
        wl("Trim-and-Fill       : tidak dijalankan (studi < 3)")
      }
      wl("")
    }
    if (length(subgroup_results) > 0) {
      wl("========================================")
      wl("SUBGROUP ANALYSIS")
      wl("========================================")
      wl("")
      for (sg_col in names(subgroup_results)) {
        sg_name_d <- gsub("_", " ", sub("^subgroup_", "", sg_col))
        m_sg      <- subgroup_results[[sg_col]]
        wl("Subgroup: ", sg_name_d)
        if (!is.null(m_sg$bylevs)) {
          for (i in seq_along(m_sg$bylevs)) {
            wl("  ", m_sg$bylevs[i], ": ", effect_measure, " = ",
               round(exp(m_sg$TE.random.w[i]), 4),
               " [", round(exp(m_sg$lower.random.w[i]), 4), "; ",
               round(exp(m_sg$upper.random.w[i]), 4), "]",
               "  I2=", round(m_sg$I2.w[i] * 100, 1), "%")
          }
          if (!is.null(m_sg$pval.Q.b.random))
            wl("  P between subgroups: ", round(m_sg$pval.Q.b.random, 5))
        }
        wl("")
      }
    }
    if (!is.null(loo_results)) {
      wl("========================================")
      wl("LEAVE-ONE-OUT ANALYSIS")
      wl("========================================")
      wl("")
      for (i in seq_len(nrow(loo_results))) {
        wl("  Omit ", loo_results$omitted_study[i], ": ",
           effect_measure, " = ", round(loo_results$pooled_effect[i], 4),
           " [", round(loo_results$CI_lower[i], 4), "; ", round(loo_results$CI_upper[i], 4), "]",
           "  p=", loo_results$p_value[i])
      }
    }

    # ── Meta-regression summary ───────────────────────────────────────────────
    if (!is.null(metareg_results) && length(metareg_results$univariable) > 0) {
      wl("")
      wl("========================================")
      wl("META-REGRESSION")
      wl("========================================")
      wl("")
      wl("Univariabel:")
      for (col_key in names(metareg_results$univariable)) {
        rr   <- metareg_results$univariable[[col_key]]
        wl("  Moderator : ", rr$mod_name, " (", rr$mod_type, ")")
        wl("  R2        : ", ifelse(is.na(rr$r2), "N/A", paste0(round(rr$r2, 1), "%")))
        wl("  p(moderator): ", formatC(rr$model$QMp, format = "g", digits = 4))
        for (i in seq_len(nrow(rr$coef_df))) {
          wl("  ", formatC(rr$coef_df$term[i], width = 30, flag = "-"),
             "  est=", round(rr$coef_df$estimate[i], 4),
             "  [", round(rr$coef_df$estimate[i] - 1.96*rr$coef_df$se[i], 4),
             "; ", round(rr$coef_df$estimate[i] + 1.96*rr$coef_df$se[i], 4), "]",
             "  p=", formatC(rr$coef_df$pval[i], format = "g", digits = 3))
        }
        wl("")
      }
      if (!is.null(metareg_results$multivariable)) {
        mr <- metareg_results$multivariable
        wl("Multivariabel:")
        wl("  R2 total  : ", ifelse(is.na(mr$r2), "N/A", paste0(round(mr$r2, 1), "%")))
        wl("  p(model)  : ", formatC(mr$model$QMp, format = "g", digits = 4))
        for (i in seq_len(nrow(mr$coef_df))) {
          wl("  ", formatC(mr$coef_df$term[i], width = 30, flag = "-"),
             "  est=", round(mr$coef_df$estimate[i], 4),
             "  [", round(mr$coef_df$estimate[i] - 1.96*mr$coef_df$se[i], 4),
             "; ", round(mr$coef_df$estimate[i] + 1.96*mr$coef_df$se[i], 4), "]",
             "  p=", formatC(mr$coef_df$pval[i], format = "g", digits = 3))
        }
      }
    }

    wl("")
    wl("========================================")
    wl("END OF REPORT")
    wl("========================================")
    cat("OK Report saved:", report_file, "\n")
  }, error = function(e) warning("Failed to generate report: ", e$message),
     finally = {
       if (exists("report_conn") && inherits(report_conn, "connection") &&
           tryCatch(isOpen(report_conn), error = function(e) FALSE)) close(report_conn)
     })

  cat("\n==========================================\n")
  cat("BINARY ANALYSIS COMPLETE\n")
  cat("==========================================\n")
  cat("Files saved to:\n", output_folder, "\n")
  cat("==========================================\n")

  invisible(list(overall_meta = res, subgroup_meta = subgroup_results,
                 trim_fill = taf, egger = egger, begg = begg,
                 loo = loo_obj, loo_table = loo_results,
                 meta_regression = metareg_results,
                 output_folder = output_folder))
}


# =============================================================================
# SECTION 5: CONTINUOUS OUTCOME ENGINE (MD / SMD)
# =============================================================================

run_continuous_outcome_analysis <- function(dat,
                                            outcome_name,
                                            effect_measure = "MD",
                                            tau_method     = "REML") {

  # ── Load packages ────────────────────────────────────────────────────────────

  for (pkg in c("metafor", "meta")) {
    if (!requireNamespace(pkg, quietly = TRUE))
      stop(paste0("Package '", pkg, "' not installed. Run install_meta_packages() first."))
  }

  # ── Validate effect measure ──────────────────────────────────────────────────

  effect_measure <- toupper(trimws(effect_measure))
  if (!(effect_measure %in% c("MD", "SMD"))) stop("effect_measure must be one of: MD, SMD")
  sm_label <- effect_measure

  # ── Validate outcome name ────────────────────────────────────────────────────

  if (missing(outcome_name) || is.null(outcome_name) || trimws(outcome_name) == "")
    stop("outcome_name cannot be empty")
  outcome_name_display <- gsub("[_-]", " ", outcome_name)
  outcome_safe <- trimws(gsub("_+", "_", gsub("[^A-Za-z0-9]", "_", outcome_name_display)),
                         whitespace = "_")

  # ── Validate data frame ──────────────────────────────────────────────────────

  if (missing(dat) || is.null(dat)) stop("Argument 'dat' is required")
  if (!is.data.frame(dat))           stop("'dat' must be a data.frame")
  if (nrow(dat) < 2)                 stop("At least 2 studies required")
  if (!"study" %in% names(dat))     stop("Column 'study' not found")
  for (col in c("sample1", "sample2"))
    if (!col %in% names(dat)) stop("Required column missing: ", col)

  # ── Create output folder ─────────────────────────────────────────────────────

  timestamp     <- format(Sys.time(), "%Y%m%d_%H%M%S")
  output_folder <- .resolve_output_folder(paste0("MetaAnalysis_", outcome_safe, "_", timestamp))

  cat("\n==========================================\n")
  cat("META-ANALYSIS ENGINE PRO — CONTINUOUS\n")
  cat("==========================================\n")
  cat("Outcome       :", outcome_name_display, "\n")
  cat("Effect measure:", sm_label, "\n")
  cat("Output folder :", output_folder, "\n\n")

  original_wd <- getwd()
  on.exit(setwd(original_wd), add = TRUE)
  setwd(output_folder)

  # ── Helpers ──────────────────────────────────────────────────────────────────

  safe_dev_off <- function() {
    while (grDevices::dev.cur() > 1)
      tryCatch(grDevices::dev.off(), error = function(e) NULL)
  }
  val_is_empty <- function(x) is.na(x) | (is.character(x) & trimws(as.character(x)) == "")

  # ── Column detection & coercion ──────────────────────────────────────────────

  has_means_cols  <- all(c("mean1", "sd1", "mean2", "sd2") %in% names(dat))
  has_sd_col      <- "sd" %in% names(dat)
  has_md_col      <- "md" %in% names(dat)

  # Median/IQR columns — full set for Wan et al. formula selection
  median_cols_1   <- c("median1", "q1_1", "q3_1")    # minimum needed for Wan S1
  median_cols_2   <- c("median2", "q1_2", "q3_2")
  has_median_1    <- all(median_cols_1 %in% names(dat))
  has_median_2    <- all(median_cols_2 %in% names(dat))
  has_median_data <- has_median_1 && has_median_2
  has_minmax_1    <- all(c("min1", "max1") %in% names(dat))
  has_minmax_2    <- all(c("min2", "max2") %in% names(dat))
  has_iqr_1       <- "iqr1" %in% names(dat)   # alternative: single IQR column
  has_iqr_2       <- "iqr2" %in% names(dat)

  if (!has_md_col) { dat$md <- NA_real_; dat$lowci <- NA_real_; dat$highci <- NA_real_ }
  for (col in c("md", "lowci", "highci", "sample1", "sample2"))
    if (col %in% names(dat)) dat[[col]] <- suppressWarnings(as.numeric(as.character(dat[[col]])))
  if (has_sd_col)
    dat$sd <- suppressWarnings(as.numeric(as.character(dat$sd)))
  if (has_means_cols)
    for (col in c("mean1", "sd1", "mean2", "sd2"))
      dat[[col]] <- suppressWarnings(as.numeric(as.character(dat[[col]])))

  # Coerce all median/IQR/minmax columns if present
  median_iqr_cols <- c("median1","iqr1","q1_1","q3_1","min1","max1",
                        "median2","iqr2","q1_2","q3_2","min2","max2")
  for (col in median_iqr_cols)
    if (col %in% names(dat))
      dat[[col]] <- suppressWarnings(as.numeric(as.character(dat[[col]])))

  # ── Auto-calculate CI from md + sd ──────────────────────────────────────────

  if (has_sd_col) {
    rows_need_ci <- which(!val_is_empty(dat$md) &
                          (val_is_empty(dat$lowci) | val_is_empty(dat$highci)) &
                          !val_is_empty(dat$sd))
    if (length(rows_need_ci) > 0) {
      cat("Info: Auto-calculating CI from md + sd...\n")
      for (i in rows_need_ci) {
        md_val <- dat$md[i]; sd_val <- dat$sd[i]
        n1 <- dat$sample1[i]; n2 <- dat$sample2[i]
        lbl <- as.character(dat$study[i])
        if (any(is.na(c(md_val, sd_val, n1, n2)))) { warning("Row ", i, " (", lbl, "): incomplete. Skipped."); next }
        if (sd_val <= 0) { warning("Row ", i, " (", lbl, "): SD must be > 0. Skipped."); next }
        if (n1 < 2 || n2 < 2) { warning("Row ", i, " (", lbl, "): n must be >= 2. Skipped."); next }
        tryCatch({
          se_md <- sd_val * sqrt(1/n1 + 1/n2)
          dat$lowci[i]  <- md_val - 1.96 * se_md
          dat$highci[i] <- md_val + 1.96 * se_md
          cat(sprintf("  OK Row %d (%s): CI = [%.4f; %.4f]\n", i, lbl, dat$lowci[i], dat$highci[i]))
        }, error = function(e) warning("Row ", i, " (", lbl, "): ", e$message))
      }
      cat("\n")
    }
  }

  # ── Auto-calculate MD/SMD from means & SDs ──────────────────────────────────

  # ── Auto-convert median / IQR → mean / SD (Wan et al. 2014; Luo et al. 2018) ──
  # Populates mean1/sd1/mean2/sd2 so the existing mean-based calc block can run.
  # Priority of formula (per group, per row):
  #   Wan S2  — min + median + max + Q1 + Q3 + n   (5-number summary, most accurate)
  #   Wan S1  — Q1 + median + Q3 + n                (IQR only, common)
  #   Luo     — median + n only                     (least accurate, last resort)
  # Rows that undergo conversion are flagged in dat$.median_conv_grp (e.g. "grp1+grp2")
  # so the text report can mark them clearly.

  dat$.median_conv_src <- ""   # will hold human-readable method tag per row

  .wan_mean <- function(med, q1, q3, n, xmin = NA, xmax = NA) {
    if (!is.na(xmin) && !is.na(xmax)) {
      # Wan S2 — equation 2 from Wan et al. 2014 (5-number summary)
      (xmin + 2*q1 + 2*med + 2*q3 + xmax) / 8
    } else {
      # Wan S1 — equation 1 (IQR only)
      (q1 + med + q3) / 3
    }
  }

  .wan_sd <- function(q1, q3, n, xmin = NA, xmax = NA) {
    if (!is.na(xmin) && !is.na(xmax)) {
      # Wan S2 — pooled range and IQR components
      r_part  <- (xmax - xmin) / (2 * qnorm((n - 0.375) / (n + 0.25)))
      iqr_part<- (q3  - q1  ) / (2 * qnorm((0.75 * n - 0.125) / (n + 0.25)))
      sqrt(((n - 1) / (2 * (n - 1) + 1)) * r_part^2 +
           ((2 * (n - 1) + 1) / (2 * (n - 1) + 1)) * iqr_part^2)
      # Simplified blended formula per Wan Table 1
      (r_part + iqr_part) / 2
    } else {
      # Wan S1
      (q3 - q1) / (2 * qnorm((0.75 * n - 0.125) / (n + 0.25)))
    }
  }

  .luo_mean <- function(med, n) {
    # Luo et al. 2018 — equation 2, median-only approximation
    (2.2 / (2.2 + n^0.75)) * ((med + med) / 2) + (n^0.75 / (2.2 + n^0.75)) * med
    # Simplifies to: med  (Luo mean ~ median when no range info)
    med
  }

  .luo_sd <- function(med, n) {
    # Wan/Luo heuristic for median-only: SD ~ IQR/1.35 ≈ range/4 ... but without
    # range we cannot estimate SD reliably. Flag as NA so the row falls through.
    NA_real_
  }

  if (has_median_data) {

    if (!has_means_cols) {
      dat$mean1 <- NA_real_; dat$sd1 <- NA_real_
      dat$mean2 <- NA_real_; dat$sd2 <- NA_real_
    }

    rows_median_conv <- which(
      val_is_empty(dat$md) &
      (val_is_empty(dat$mean1) | val_is_empty(dat$sd1) |
       val_is_empty(dat$mean2) | val_is_empty(dat$sd2))
    )

    if (length(rows_median_conv) > 0) {
      cat("Info: Converting median/IQR → mean/SD for", length(rows_median_conv), "row(s)...\n")

      for (i in rows_median_conv) {
        lbl <- as.character(dat$study[i])
        conv_tags <- character(0)

        for (grp in c(1, 2)) {

          med_col  <- paste0("median", grp)
          q1_col   <- paste0("q1_",   grp)
          q3_col   <- paste0("q3_",   grp)
          iqr_col  <- paste0("iqr",   grp)
          min_col  <- paste0("min",   grp)
          max_col  <- paste0("max",   grp)
          n_col    <- paste0("sample", grp)
          mean_col <- paste0("mean",  grp)
          sd_col   <- paste0("sd",    grp)

          # Skip if mean/SD already filled for this group
          if (!val_is_empty(dat[[mean_col]][i]) && !val_is_empty(dat[[sd_col]][i])) next

          med  <- dat[[med_col]][i]
          n    <- dat[[n_col]][i]
          q1   <- if (q1_col  %in% names(dat)) dat[[q1_col]][i]  else NA_real_
          q3   <- if (q3_col  %in% names(dat)) dat[[q3_col]][i]  else NA_real_
          iqr  <- if (iqr_col %in% names(dat)) dat[[iqr_col]][i] else NA_real_
          xmin <- if (min_col %in% names(dat)) dat[[min_col]][i] else NA_real_
          xmax <- if (max_col %in% names(dat)) dat[[max_col]][i] else NA_real_

          # If only IQR column given (no q1/q3), derive q1/q3 from median±IQR/2
          if (is.na(q1) && !is.na(iqr) && !is.na(med)) {
            q1 <- med - iqr / 2
            q3 <- med + iqr / 2
          }

          if (is.na(med) || is.na(n) || n < 2) {
            warning("Row ", i, " (", lbl, ") grp", grp,
                    ": median or n missing/invalid. Cannot convert.")
            next
          }

          if (!is.na(q1) && !is.na(q3)) {
            if (q3 <= q1) {
              warning("Row ", i, " (", lbl, ") grp", grp, ": Q3 <= Q1. Skipped.")
              next
            }
            use_minmax <- !is.na(xmin) && !is.na(xmax) && xmax > xmin
            m_est <- .wan_mean(med, q1, q3, n,
                               xmin = if (use_minmax) xmin else NA,
                               xmax = if (use_minmax) xmax else NA)
            s_est <- .wan_sd  (q1, q3, n,
                               xmin = if (use_minmax) xmin else NA,
                               xmax = if (use_minmax) xmax else NA)
            method_tag <- if (use_minmax) "Wan-S2(5-num)" else "Wan-S1(IQR)"
          } else {
            # Median only — Luo mean = median, SD not estimable
            m_est <- .luo_mean(med, n)
            s_est <- .luo_sd(med, n)
            method_tag <- "Luo(median-only)"
            if (is.na(s_est)) {
              warning("Row ", i, " (", lbl, ") grp", grp,
                      ": only median available — SD cannot be estimated. ",
                      "Please provide Q1/Q3 or IQR for reliable meta-analysis.")
              next
            }
          }

          if (!is.finite(m_est) || !is.finite(s_est) || s_est <= 0) {
            warning("Row ", i, " (", lbl, ") grp", grp,
                    ": conversion yielded non-finite mean/SD. Skipped.")
            next
          }

          dat[[mean_col]][i] <- m_est
          dat[[sd_col]][i]   <- s_est
          conv_tags <- c(conv_tags, paste0("grp", grp, ":", method_tag))
          cat(sprintf("  OK Row %d (%s) grp%d: mean=%.4f SD=%.4f [%s]\n",
                      i, lbl, grp, m_est, s_est, method_tag))
        }

        if (length(conv_tags) > 0)
          dat$.median_conv_src[i] <- paste(conv_tags, collapse = "; ")
      }
      cat("\n")
    }
  }

  # Update has_means_cols in case we just created mean1/sd1/mean2/sd2
  has_means_cols <- all(c("mean1", "sd1", "mean2", "sd2") %in% names(dat))

  if (has_means_cols) {
    rows_need_calc <- which(val_is_empty(dat$md))
    if (length(rows_need_calc) > 0) {
      cat("Info: Auto-calculating", sm_label, "from means and SDs...\n")
      for (i in rows_need_calc) {
        m1 <- dat$mean1[i]; s1 <- dat$sd1[i]; n1 <- dat$sample1[i]
        m2 <- dat$mean2[i]; s2 <- dat$sd2[i]; n2 <- dat$sample2[i]
        lbl <- as.character(dat$study[i])
        if (any(is.na(c(m1, s1, n1, m2, s2, n2)))) { warning("Row ", i, " (", lbl, "): incomplete. Skipped."); next }
        if (s1 <= 0 || s2 <= 0) { warning("Row ", i, " (", lbl, "): SD must be > 0. Skipped."); next }
        if (n1 < 2 || n2 < 2) { warning("Row ", i, " (", lbl, "): n must be >= 2. Skipped."); next }
        tryCatch({
          result <- metafor::escalc(measure = effect_measure,
                                    m1i = m1, sd1i = s1, n1i = n1,
                                    m2i = m2, sd2i = s2, n2i = n2)
          yi_val <- as.numeric(result$yi); sei_val <- sqrt(as.numeric(result$vi))
          dat$md[i]     <- yi_val
          dat$lowci[i]  <- yi_val - 1.96 * sei_val
          dat$highci[i] <- yi_val + 1.96 * sei_val
          cat(sprintf("  OK Row %d (%s): %s = %.4f [%.4f; %.4f]\n",
                      i, lbl, sm_label, dat$md[i], dat$lowci[i], dat$highci[i]))
        }, error = function(e) warning("Row ", i, " (", lbl, "): ", e$message))
      }
      cat("\n")
    }
  }

  # ── Drop incomplete rows ─────────────────────────────────────────────────────

  rows_complete <- !is.na(dat$md) & !is.na(dat$lowci) & !is.na(dat$highci)
  if (sum(rows_complete) < nrow(dat)) {
    for (s in as.character(dat$study[!rows_complete]))
      warning("Row '", s, "' dropped: missing md/lowci/highci after calculation")
    dat <- dat[rows_complete, ]
  }
  if (nrow(dat) < 2)
    stop(paste0(
      "Fewer than 2 valid studies after cleaning.\n",
      "Each study must have ONE of:\n",
      "  (a) md + lowci + highci  (direct input)\n",
      "  (b) md + sd + sample1 + sample2  (CI auto-calculated)\n",
      "  (c) mean1 + sd1 + sample1 + mean2 + sd2 + sample2  (MD/SMD auto-calculated)\n",
      "  (d) median1 + q1_1 + q3_1 + sample1 + median2 + q1_2 + q3_2 + sample2  (converted via Wan et al.)"
    ))
  if (any(dat$lowci >= dat$highci, na.rm = TRUE)) stop("lowci must be < highci for all rows")

  cat("OK Dataset valid — studies:", nrow(dat), "\n\n")

  # ── Subgroup detection ───────────────────────────────────────────────────────

  subgroup_cols <- grep("^subgroup_", names(dat), value = TRUE)
  if (length(subgroup_cols) > 0) {
    cat("OK Subgroup columns detected:\n")
    cat(paste("  -", subgroup_cols, collapse = "\n"), "\n\n")
  }

  # ── SE from CI ──────────────────────────────────────────────────────────────

  dat$yi_val <- dat$md
  dat$sei    <- (dat$highci - dat$lowci) / (2 * 1.96)
  if (any(!is.finite(dat$sei)) || any(dat$sei <= 0)) stop("Invalid standard errors.")

  # ── Overall meta-analysis ────────────────────────────────────────────────────

  tau_method <- toupper(trimws(as.character(tau_method)))
  if (!tau_method %in% c("REML", "DL", "PM", "EB", "SJ", "ML", "GENQ")) {
    warning("tau_method '", tau_method, "' tidak dikenal — menggunakan REML.")
    tau_method <- "REML"
  }
  cat(sprintf("Running overall meta-analysis (tau method: %s)...\n", tau_method))
  res <- tryCatch(
    metafor::rma(yi = yi_val, sei = sei, data = dat, method = tau_method, slab = dat$study),
    error = function(e) {
      if (tau_method == "REML") {
        warning("REML tidak konvergen untuk '", outcome_name_display,
                "' — fallback ke DL. Detail: ", e$message)
        tryCatch(
          metafor::rma(yi = yi_val, sei = sei, data = dat, method = "DL", slab = dat$study),
          error = function(e2) stop("Error in rma() [DL fallback]: ", e2$message)
        )
      } else {
        stop("Error in rma() [", tau_method, "]: ", e$message)
      }
    })
  .tau_used <- if (!is.null(res$method) && res$method != tau_method) res$method else tau_method
  if (.tau_used != tau_method)
    cat(sprintf("  INFO: %s tidak konvergen — menggunakan %s.\n", tau_method, .tau_used))
  # ── Detect treat names & sample sizes for n-columns in forest plots ──────────

  .ni <- .forest_n_info(dat)

  # Build metagen args; include n.e/n.c when sample sizes are known
  .metagen_args_overall <- list(TE = dat$yi_val, seTE = dat$sei, studlab = dat$study,
                                sm = sm_label, method.tau = .tau_used)
  if (.ni$has_n) { .metagen_args_overall$n.e <- .ni$n_e; .metagen_args_overall$n.c <- .ni$n_c }
  m_overall <- tryCatch(
    do.call(meta::metagen, .metagen_args_overall),
    error = function(e) stop("Error in metagen(): ", e$message))
  cat("OK Overall meta-analysis done\n\n")

  # ── Forest plot — overall ────────────────────────────────────────────────────

  cat("Creating forest plot...\n")
  forest_args <- list(m_overall, comb.fixed = TRUE, overall = TRUE,
                      overall.hetstat = TRUE, print.I2 = TRUE, digits = 2,
                      leftlabs = "Study", rightlabs = c(sm_label, "95% CI"),
                      main = paste("Forest Plot -", outcome_name_display, "(", sm_label, ")"))
  forest_args <- .forest_add_spacing(forest_args, nrow(dat))
  forest_args <- .forest_apply_n_cols(forest_args, .ni)
  forest_args <- .forest_add_pval_text(forest_args, m_overall)
  tryCatch(do.call(meta::forest, forest_args),
           error = function(e) warning("Cannot display forest plot: ", e$message))
  .fp_dims <- .forest_png_dims(nrow(dat), dat$study, has_n_cols = .ni$has_n)
  tryCatch({
    grDevices::png(paste0("forest_overall_", outcome_safe, ".png"),
                   width = .fp_dims$width, height = .fp_dims$height, res = 300)
    do.call(meta::forest, forest_args)
    grDevices::dev.off()
    cat("OK Forest plot saved\n")
  }, error = function(e) { safe_dev_off(); warning("Failed to save forest plot: ", e$message) })

  # ── Subgroup analysis ────────────────────────────────────────────────────────

  subgroup_results <- list()

  for (sg_col in subgroup_cols) {
    sg_name         <- sub("^subgroup_", "", sg_col)
    sg_name_display <- gsub("_", " ", sg_name)
    sg_name_safe    <- gsub("[^A-Za-z0-9]", "_", sg_name)
    sg_values       <- dat[[sg_col]]

    if (all(is.na(sg_values))) { warning("Column '", sg_col, "' all NA. Skipped."); next }
    n_levels <- length(unique(na.omit(sg_values)))
    if (n_levels < 2) { warning("Column '", sg_col, "' has 1 level. Skipped."); next }
    n_na_sg <- sum(is.na(sg_values))
    if (n_na_sg > 0) {
      message("Subgroup '", sg_name_display, "': ", n_na_sg,
              " studi tidak punya nilai subgroup — diisi 'Unknown'.")
      sg_values[is.na(sg_values)] <- "Unknown"
      n_levels <- length(unique(na.omit(sg_values)))
      if (n_levels < 2) { warning("Column '", sg_col, "' has 1 level after NA fill. Skipped."); next }
    }

    cat("Running subgroup analysis:", sg_name_display, "\n")
    tryCatch({
      .metagen_args_sg <- list(TE = dat$yi_val, seTE = dat$sei, studlab = dat$study,
                               sm = sm_label, method.tau = "REML",
                               subgroup = sg_values, print.subgroup.name = FALSE)
      if (.ni$has_n) { .metagen_args_sg$n.e <- .ni$n_e; .metagen_args_sg$n.c <- .ni$n_c }
      m_sg <- do.call(meta::metagen, .metagen_args_sg)
      sg_forest_args <- list(m_sg, comb.fixed = TRUE, overall = TRUE,
                             overall.hetstat = TRUE, print.I2 = TRUE, print.I2.ci = TRUE,
                             digits = 2, leftlabs = "Study",
                             rightlabs = c(sm_label, "95% CI"),
                             main = paste("Subgroup:", sg_name_display, "\n",
                                          outcome_name_display, "(", sm_label, ")"))
      sg_forest_args <- .forest_add_spacing(sg_forest_args, nrow(dat))
      sg_forest_args <- .forest_apply_n_cols(sg_forest_args, .ni)
      sg_forest_args <- .forest_add_pval_text(sg_forest_args, m_sg)
      tryCatch(do.call(meta::forest, sg_forest_args),
               error = function(e) warning("Cannot display subgroup plot: ", e$message))
      .sg_dims <- .forest_png_dims(nrow(dat), dat$study,
                                   n_subgroup_levels = n_levels, is_subgroup = TRUE,
                                   has_n_cols = .ni$has_n)
      tryCatch({
        grDevices::png(paste0("forest_subgroup_", sg_name_safe, "_", outcome_safe, ".png"),
                       width = .sg_dims$width, height = .sg_dims$height, res = 300)
        do.call(meta::forest, sg_forest_args)
        grDevices::dev.off()
        cat("  OK Subgroup plot saved\n")
      }, error = function(e) { safe_dev_off(); warning("Failed to save subgroup plot: ", e$message) })
      subgroup_results[[sg_col]] <- m_sg
    }, error = function(e) warning("Subgroup error '", sg_col, "': ", e$message))
  }

  # ── Publication bias ─────────────────────────────────────────────────────────

  cat("\nRunning publication bias tests...\n")
  taf <- egger <- begg <- NULL
  n_pub_studies <- sum(!is.na(res$yi))

  if (n_pub_studies < 3) {
    message("Publication bias tests dilewati: hanya ", n_pub_studies,
            " studi (minimum 3 untuk trim-and-fill & Begg, minimum 10 untuk Egger).")
  } else {
    # Trim-and-fill & Begg: valid mulai 3 studi
    tryCatch({
      taf  <- metafor::trimfill(res)
      begg <- metafor::ranktest(res)
      cat("OK Trim-and-fill & Begg done\n")
    }, error = function(e) warning("Trim-and-fill/Begg failed: ", e$message))

    # Egger: butuh minimal 10 studi agar reliable
    if (n_pub_studies < 10) {
      message("Egger test dilewati: hanya ", n_pub_studies,
              " studi (disarankan >= 10).")
    } else {
      tryCatch({
        egger <- metafor::regtest(res, model = "lm")
        cat("OK Egger test done\n")
      }, error = function(e) warning("Egger test failed: ", e$message))
    }
  }

  funnel_args <- list(res, xlab = sm_label,
                      main = paste("Funnel Plot -", outcome_name_display, "(", sm_label, ")"))
  tryCatch(do.call(metafor::funnel, funnel_args),
           error = function(e) warning("Cannot display funnel plot: ", e$message))
  tryCatch({
    grDevices::png(paste0("funnel_standard_", outcome_safe, ".png"), width = 3000, height = 2400, res = 300)
    do.call(metafor::funnel, funnel_args)
    grDevices::dev.off()
    cat("OK Standard funnel plot saved\n")
  }, error = function(e) { safe_dev_off(); warning("Failed to save funnel plot: ", e$message) })

  if (!is.null(taf)) {
    taf_args <- list(taf, xlab = sm_label,
                     main = paste("Trim-and-Fill\n", outcome_name_display, "(", sm_label, ")"))
    tryCatch(do.call(metafor::funnel, taf_args),
             error = function(e) warning("Cannot display trim-fill funnel: ", e$message))
    tryCatch({
      grDevices::png(paste0("funnel_trimfill_", outcome_safe, ".png"), width = 3000, height = 2400, res = 300)
      do.call(metafor::funnel, taf_args)
      grDevices::dev.off()
      cat("OK Trim-and-fill funnel saved\n")
    }, error = function(e) { safe_dev_off(); warning("Failed to save trim-fill funnel: ", e$message) })
  }

  # ── Leave-one-out ────────────────────────────────────────────────────────────

  cat("\nRunning leave-one-out analysis...\n")
  loo_obj <- loo_results <- NULL

  tryCatch({
    loo_obj <- metafor::leave1out(res)
    loo_results <- data.frame(
      omitted_study = as.character(loo_obj$slab),
      pooled_effect = loo_obj$estimate,
      CI_lower      = loo_obj$ci.lb,
      CI_upper      = loo_obj$ci.ub,
      p_value       = round(loo_obj$pval, 5)
    )
    utils::write.csv(loo_results, paste0("leave_one_out_", outcome_safe, ".csv"), row.names = FALSE)
    loo_sorted <- loo_results[order(loo_results$pooled_effect), ]
    .loo_p <- .loo_plot_params(loo_sorted$omitted_study)

    draw_loo_cont <- function() {
      graphics::par(mar = .loo_p$mar)
      xlim_range <- range(c(loo_sorted$CI_lower, loo_sorted$CI_upper))
      graphics::plot(loo_sorted$pooled_effect, seq_along(loo_sorted$pooled_effect),
                     xlim = xlim_range, xlab = paste("Pooled", sm_label, "(Leave-One-Out)"),
                     ylab = "", pch = 19, yaxt = "n",
                     main = paste("Leave-One-Out -", outcome_name_display, "(", sm_label, ")"))
      graphics::mtext("Omitted study", side = 2, line = .loo_p$mtext_line, cex = 0.95, font = 2)
      graphics::axis(2, at = seq_along(loo_sorted$pooled_effect),
                     labels = loo_sorted$omitted_study, las = 2, cex.axis = .loo_p$cex_axis)
      graphics::segments(loo_sorted$CI_lower, seq_along(loo_sorted$pooled_effect),
                         loo_sorted$CI_upper, seq_along(loo_sorted$pooled_effect))
      graphics::abline(v = res$b, lty = 2, lwd = 2, col = "red")
    }
    tryCatch(draw_loo_cont(), error = function(e) warning("Cannot display LOO plot: ", e$message))
    tryCatch({
      grDevices::png(paste0("leave_one_out_", outcome_safe, ".png"),
                     width = .loo_p$png_width, height = .loo_p$png_height, res = 300)
      draw_loo_cont()
      grDevices::dev.off()
      cat("OK Leave-one-out done\n")
    }, error = function(e) { safe_dev_off(); warning("Failed to save LOO plot: ", e$message) })
  }, error = function(e) warning("Leave-one-out error: ", e$message))

  # ── Meta-regression ───────────────────────────────────────────────────────────

  metareg_results <- .run_metareg_v4(
    dat                  = dat,
    yi_col               = "yi_val",
    sei_col              = "sei",
    outcome_name_display = outcome_name_display,
    outcome_safe         = outcome_safe,
    effect_measure       = sm_label,
    is_log_scale         = FALSE,
    output_folder        = output_folder
  )

  # ── Text report ──────────────────────────────────────────────────────────────

  cat("\nGenerating report...\n")
  tryCatch({
    report_file <- paste0("report_", outcome_safe, ".txt")
    report_conn <- file(report_file, open = "w")
    wl <- function(...) writeLines(paste0(...), report_conn)

    wl("========================================")
    wl("META-ANALYSIS REPORT — CONTINUOUS OUTCOME")
    wl("========================================")
    wl("")
    wl("Outcome       : ", outcome_name_display)
    wl("Effect measure: ", sm_label)
    wl("Date          : ", format(Sys.time(), "%Y-%m-%d %H:%M:%S"))
    wl("")
    wl("Number of studies: ", nrow(dat))
    wl("Group 1 (n)      : ", sum(dat$sample1, na.rm = TRUE))
    wl("Group 2 (n)      : ", sum(dat$sample2, na.rm = TRUE))
    wl("Total N          : ", sum(dat$sample1, na.rm = TRUE) + sum(dat$sample2, na.rm = TRUE))
    wl("")

    # ── Per-study data source table ───────────────────────────────────────────
    any_conv <- any(nzchar(dat$.median_conv_src))

    # Determine source label per row
    # NOTE: mean1/sd1/mean2/sd2 may not exist (user only inputs md/CI directly),
    # so guard every column access with existence checks and isTRUE() to avoid
    # NULL[i] → logical(0) → "missing value where TRUE/FALSE needed" errors.
    .has_means_in_dat <- all(c("mean1","sd1","mean2","sd2") %in% names(dat))
    get_src <- function(i) {
      conv <- dat$.median_conv_src[i]
      if (!is.na(conv) && nzchar(conv)) return(paste0("Approx. [", conv, "]"))
      if (.has_means_in_dat) {
        has_m1 <- isTRUE(!is.na(dat$mean1[i])) && isTRUE(!is.na(dat$sd1[i]))
        has_m2 <- isTRUE(!is.na(dat$mean2[i])) && isTRUE(!is.na(dat$sd2[i]))
        if (has_m1 && has_m2) return("Calculated (mean/SD)")
      }
      if (isTRUE(!is.na(dat$lowci[i])) && isTRUE(!is.na(dat$highci[i]))) return("Direct input")
      return("Direct input (md+sd)")
    }

    wl("========================================")
    wl("PER-STUDY DETAILS")
    wl("========================================")
    wl("")
    max_w <- max(nchar(as.character(dat$study)), nchar("Study"))
    col_w <- max(max_w, 10)
    hdr <- paste0(
      formatC("Study",   width = col_w, flag = "-"), "  ",
      formatC(sm_label,  width = 9,     flag = "-"), "  ",
      formatC("95% CI",  width = 22,    flag = "-"), "  ",
      formatC("Source",  width = 30,    flag = "-")
    )
    wl(hdr)
    wl(paste(rep("-", nchar(hdr)), collapse = ""))
    for (i in seq_len(nrow(dat))) {
      ci_str <- paste0("[", round(dat$lowci[i], 4), "; ", round(dat$highci[i], 4), "]")
      wl(
        formatC(as.character(dat$study[i]), width = col_w, flag = "-"), "  ",
        formatC(round(dat$md[i], 4), width = 9, format = "f", digits = 4, flag = "-"), "  ",
        formatC(ci_str, width = 22, flag = "-"), "  ",
        formatC(get_src(i), width = 30, flag = "-")
      )
    }
    wl(paste(rep("-", nchar(hdr)), collapse = ""))
    if (any_conv) {
      wl("")
      wl("APPROXIMATION NOTE:")
      wl("Studies marked 'Approx.' used median/IQR converted to mean/SD.")
      wl("Conversion method:")
      wl("  Wan-S2(5-num) : Wan et al. (2014) eq. with min, Q1, median, Q3, max")
      wl("  Wan-S1(IQR)   : Wan et al. (2014) eq. with Q1, median, Q3 only")
      wl("  Luo(median-only): Luo et al. (2018) — least accurate, use with caution")
      wl("Reference: Wan X et al. BMC Med Res Methodol. 2014;14:135")
      wl("           Luo D et al. Stat Med. 2018;37(13):2152-2166")
    }
    wl("")
    wl("========================================")
    wl("OVERALL RESULT")
    wl("========================================")
    wl("")
    wl("Pooled ", sm_label, " : ", round(res$b[1], 4))
    wl("95% CI        : ", round(res$ci.lb, 4), " - ", round(res$ci.ub, 4))
    wl("P-value       : ", formatC(res$pval, format = "g", digits = 5))
    model_type <- "Random-effects (REML)"
    if (!is.null(res$tau2) && res$tau2 < 1e-6) model_type <- paste0(model_type, " — tau2 ~ 0")
    wl("Model         : ", model_type)
    wl("")
    wl("HETEROGENEITY")
    wl("I2  : ", round(res$I2, 2), "%")
    wl("tau2: ", round(res$tau2, 6))
    wl("Q   : ", round(res$QE, 4), " (df=", res$k - 1, ", p=",
       formatC(res$QEp, format = "g", digits = 4), ")")
    wl("")
    if (!is.null(taf) || !is.null(begg) || !is.null(egger)) {
      wl("========================================")
      wl("PUBLICATION BIAS")
      wl("========================================")
      if (!is.null(egger)) {
        wl("Egger's test p-value: ", round(egger$pval, 5))
      } else {
        wl("Egger's test        : tidak dijalankan (studi < 10)")
      }
      if (!is.null(begg)) {
        wl("Begg's test p-value : ", round(begg$pval, 5))
      } else {
        wl("Begg's test         : tidak dijalankan (studi < 3)")
      }
      if (!is.null(taf)) {
        wl("Trim-and-Fill — studies imputed: ", taf$k0)
        if (taf$k0 > 0)
          wl("  Adjusted ", sm_label, ": ", round(taf$beta, 4),
             " [", round(taf$ci.lb, 4), "; ", round(taf$ci.ub, 4), "]")
        else
          wl("  Trim-and-Fill: tidak ada studi yang di-impute")
      } else {
        wl("Trim-and-Fill       : tidak dijalankan (studi < 3)")
      }
      wl("")
    }
    if (length(subgroup_results) > 0) {
      wl("========================================")
      wl("SUBGROUP ANALYSIS")
      wl("========================================")
      wl("")
      for (sg_col in names(subgroup_results)) {
        sg_name_d <- gsub("_", " ", sub("^subgroup_", "", sg_col))
        m_sg      <- subgroup_results[[sg_col]]
        wl("Subgroup: ", sg_name_d)
        if (!is.null(m_sg$bylevs)) {
          for (i in seq_along(m_sg$bylevs)) {
            wl("  ", m_sg$bylevs[i], ": ", sm_label, " = ",
               round(m_sg$TE.random.w[i], 4),
               " [", round(m_sg$lower.random.w[i], 4), "; ",
               round(m_sg$upper.random.w[i], 4), "]",
               "  I2=", round(m_sg$I2.w[i] * 100, 1), "%")
          }
          if (!is.null(m_sg$pval.Q.b.random))
            wl("  P between subgroups: ", round(m_sg$pval.Q.b.random, 5))
        }
        wl("")
      }
    }
    if (!is.null(loo_results)) {
      wl("========================================")
      wl("LEAVE-ONE-OUT ANALYSIS")
      wl("========================================")
      wl("")
      for (i in seq_len(nrow(loo_results))) {
        wl("  Omit ", loo_results$omitted_study[i], ": ",
           sm_label, " = ", round(loo_results$pooled_effect[i], 4),
           " [", round(loo_results$CI_lower[i], 4), "; ", round(loo_results$CI_upper[i], 4), "]",
           "  p=", loo_results$p_value[i])
      }
    }

    # ── Meta-regression summary ───────────────────────────────────────────────
    if (!is.null(metareg_results) && length(metareg_results$univariable) > 0) {
      wl("")
      wl("========================================")
      wl("META-REGRESSION")
      wl("========================================")
      wl("")
      wl("Univariabel:")
      for (col_key in names(metareg_results$univariable)) {
        rr   <- metareg_results$univariable[[col_key]]
        wl("  Moderator : ", rr$mod_name, " (", rr$mod_type, ")")
        wl("  R2        : ", ifelse(is.na(rr$r2), "N/A", paste0(round(rr$r2, 1), "%")))
        wl("  p(moderator): ", formatC(rr$model$QMp, format = "g", digits = 4))
        for (i in seq_len(nrow(rr$coef_df))) {
          wl("  ", formatC(rr$coef_df$term[i], width = 30, flag = "-"),
             "  est=", round(rr$coef_df$estimate[i], 4),
             "  [", round(rr$coef_df$estimate[i] - 1.96*rr$coef_df$se[i], 4),
             "; ", round(rr$coef_df$estimate[i] + 1.96*rr$coef_df$se[i], 4), "]",
             "  p=", formatC(rr$coef_df$pval[i], format = "g", digits = 3))
        }
        wl("")
      }
      if (!is.null(metareg_results$multivariable)) {
        mr <- metareg_results$multivariable
        wl("Multivariabel:")
        wl("  R2 total  : ", ifelse(is.na(mr$r2), "N/A", paste0(round(mr$r2, 1), "%")))
        wl("  p(model)  : ", formatC(mr$model$QMp, format = "g", digits = 4))
        for (i in seq_len(nrow(mr$coef_df))) {
          wl("  ", formatC(mr$coef_df$term[i], width = 30, flag = "-"),
             "  est=", round(mr$coef_df$estimate[i], 4),
             "  [", round(mr$coef_df$estimate[i] - 1.96*mr$coef_df$se[i], 4),
             "; ", round(mr$coef_df$estimate[i] + 1.96*mr$coef_df$se[i], 4), "]",
             "  p=", formatC(mr$coef_df$pval[i], format = "g", digits = 3))
        }
      }
    }

    wl("")
    wl("========================================")
    wl("END OF REPORT")
    wl("========================================")
    close(report_conn)
    cat("OK Report saved:", report_file, "\n")
  }, error = function(e) warning("Failed to generate report: ", e$message),
     finally = {
       if (exists("report_conn") && inherits(report_conn, "connection") &&
           tryCatch(isOpen(report_conn), error = function(e) FALSE)) close(report_conn)
     })

  cat("\n==========================================\n")
  cat("CONTINUOUS ANALYSIS COMPLETE\n")
  cat("==========================================\n")
  cat("Files saved to:\n", output_folder, "\n")
  cat("==========================================\n")

  invisible(list(overall_meta = res, subgroup_meta = subgroup_results,
                 trim_fill = taf, egger = egger, begg = begg,
                 loo = loo_obj, loo_table = loo_results,
                 meta_regression = metareg_results,
                 output_folder = output_folder))
}


# =============================================================================
# SECTION 6: DIAGNOSTIC TEST ACCURACY ENGINE
# =============================================================================

# Internal null-coalescing helpers
`%||%`  <- function(a, b) if (!is.null(a)) a else b

run_diagnostic_meta_analysis <- function(dat,
                                         outcome_name,
                                         alpha = 0.05) {

  # ── Load packages ────────────────────────────────────────────────────────────

  for (pkg in c("mada", "metafor", "meta")) {
    if (!requireNamespace(pkg, quietly = TRUE))
      stop(paste0("Package '", pkg, "' not installed. Run install_meta_packages() first."))
  }

  # ── Validate inputs ──────────────────────────────────────────────────────────

  if (missing(dat) || is.null(dat) || !is.data.frame(dat)) stop("'dat' must be a data.frame")
  if (nrow(dat) < 2)                                        stop("At least 2 studies required")
  if (!"study" %in% names(dat))                            stop("Column 'study' not found")
  if (missing(outcome_name) || is.null(outcome_name) || trimws(outcome_name) == "")
    stop("outcome_name cannot be empty")

  outcome_name_display <- gsub("[_-]", " ", outcome_name)
  outcome_safe <- trimws(gsub("_+", "_", gsub("[^A-Za-z0-9]", "_", outcome_name_display)),
                         whitespace = "_")

  # ── Create output folder ─────────────────────────────────────────────────────

  timestamp     <- format(Sys.time(), "%Y%m%d_%H%M%S")
  output_folder <- .resolve_output_folder(paste0("DiagMeta_", outcome_safe, "_", timestamp))

  cat("\n==========================================\n")
  cat("META-ANALYSIS ENGINE — DIAGNOSTIC\n")
  cat("==========================================\n")
  cat("Outcome      :", outcome_name_display, "\n")
  cat("Output folder:", output_folder, "\n\n")

  original_wd <- getwd()
  on.exit(setwd(original_wd), add = TRUE)
  setwd(output_folder)

  # ── Helpers ──────────────────────────────────────────────────────────────────

  safe_dev_off <- function() {
    while (grDevices::dev.cur() > 1) tryCatch(grDevices::dev.off(), error = function(e) NULL)
  }
  wilson_ci <- function(x, n, conf = 0.95) {
    z <- qnorm(1 - (1 - conf) / 2); p <- x / n
    denom  <- 1 + z^2 / n
    centre <- (p + z^2 / (2 * n)) / denom
    margin <- z * sqrt(p * (1 - p) / n + z^2 / (4 * n^2)) / denom
    list(est = p, lower = centre - margin, upper = centre + margin)
  }
  logit <- function(p) log(p / (1 - p))

  # ── Coerce columns ───────────────────────────────────────────────────────────

  for (col in c("sens", "spec", "sample", "tp", "fp", "fn", "tn"))
    if (col %in% names(dat))
      dat[[col]] <- suppressWarnings(as.numeric(as.character(dat[[col]])))

  # ── Auto-fill from 2×2 ──────────────────────────────────────────────────────

  cat("--- Preparing dataset ---\n")
  has_2x2 <- all(c("tp", "fp", "fn", "tn") %in% names(dat))

  if (has_2x2) {
    for (i in seq_len(nrow(dat))) {
      tp <- dat$tp[i]; fp <- dat$fp[i]; fn <- dat$fn[i]; tn <- dat$tn[i]
      lbl <- as.character(dat$study[i])
      if (is.na(dat$sample[i]) && !any(is.na(c(tp, fp, fn, tn))))
        dat$sample[i] <- tp + fp + fn + tn
      if (!any(is.na(c(tp, fn))) && (tp + fn) > 0 && is.na(dat$sens[i])) {
        dat$sens[i] <- tp / (tp + fn)
        cat(sprintf("  Row %d (%s): sens = %.4f (from 2x2)\n", i, lbl, dat$sens[i]))
      }
      if (!any(is.na(c(tn, fp))) && (tn + fp) > 0 && is.na(dat$spec[i])) {
        dat$spec[i] <- tn / (tn + fp)
        cat(sprintf("  Row %d (%s): spec = %.4f (from 2x2)\n", i, lbl, dat$spec[i]))
      }
      if (!any(is.na(c(tp, fp, fn, tn))) && any(c(tp, fp, fn, tn) == 0)) {
        dat$tp[i] <- tp + 0.5; dat$fp[i] <- fp + 0.5
        dat$fn[i] <- fn + 0.5; dat$tn[i] <- tn + 0.5
        cat(sprintf("  Row %d (%s): continuity correction applied\n", i, lbl))
      }
    }
  }

  if (!"sens" %in% names(dat)) dat$sens <- NA_real_
  if (!"spec" %in% names(dat)) dat$spec <- NA_real_
  if (!"sample" %in% names(dat)) dat$sample <- NA_real_

  rows_valid <- !is.na(dat$sens) & !is.na(dat$spec) &
                dat$sens > 0 & dat$sens < 1 & dat$spec > 0 & dat$spec < 1
  if (sum(rows_valid) < nrow(dat)) {
    warning("Rows dropped (sens/spec missing or at boundary): ",
            paste(as.character(dat$study[!rows_valid]), collapse = ", "))
    dat <- dat[rows_valid, ]
  }
  if (nrow(dat) < 2) stop("Fewer than 2 valid studies after cleaning.")
  cat(sprintf("\nOK %d studies ready for analysis\n\n", nrow(dat)))

  # ── Per-study statistics ─────────────────────────────────────────────────────

  cat("--- Computing per-study statistics ---\n")
  dat$logit_sens  <- logit(dat$sens)
  dat$logit_spec  <- logit(dat$spec)
  dat$logit_1spec <- logit(1 - dat$spec)

  for (col in c("sens_lower", "sens_upper", "spec_lower", "spec_upper",
                "lr_pos", "lr_neg", "dor", "var_logit_sens", "var_logit_spec"))
    dat[[col]] <- NA_real_

  for (i in seq_len(nrow(dat))) {
    if (has_2x2 && !any(is.na(c(dat$tp[i], dat$fn[i])))) {
      ci_s <- wilson_ci(dat$tp[i], dat$tp[i] + dat$fn[i])
    } else if (!is.na(dat$sample[i])) {
      ci_s <- wilson_ci(round(dat$sens[i] * dat$sample[i]), dat$sample[i])
    } else ci_s <- NULL
    if (!is.null(ci_s)) { dat$sens_lower[i] <- ci_s$lower; dat$sens_upper[i] <- ci_s$upper }

    if (has_2x2 && !any(is.na(c(dat$tn[i], dat$fp[i])))) {
      ci_p <- wilson_ci(dat$tn[i], dat$tn[i] + dat$fp[i])
    } else if (!is.na(dat$sample[i])) {
      ci_p <- wilson_ci(round(dat$spec[i] * dat$sample[i]), dat$sample[i])
    } else ci_p <- NULL
    if (!is.null(ci_p)) { dat$spec_lower[i] <- ci_p$lower; dat$spec_upper[i] <- ci_p$upper }

    dat$lr_pos[i] <- dat$sens[i] / (1 - dat$spec[i])
    dat$lr_neg[i] <- (1 - dat$sens[i]) / dat$spec[i]
    dat$dor[i]    <- dat$lr_pos[i] / dat$lr_neg[i]

    if (has_2x2 && !any(is.na(c(dat$tp[i], dat$fn[i]))) && dat$tp[i] > 0 && dat$fn[i] > 0)
      dat$var_logit_sens[i] <- 1/dat$tp[i] + 1/dat$fn[i]
    else if (!is.na(dat$sample[i]) && dat$sample[i] > 0)
      dat$var_logit_sens[i] <- 1 / (dat$sample[i] * dat$sens[i] * (1 - dat$sens[i]))

    if (has_2x2 && !any(is.na(c(dat$tn[i], dat$fp[i]))) && dat$tn[i] > 0 && dat$fp[i] > 0)
      dat$var_logit_spec[i] <- 1/dat$tn[i] + 1/dat$fp[i]
    else if (!is.na(dat$sample[i]) && dat$sample[i] > 0)
      dat$var_logit_spec[i] <- 1 / (dat$sample[i] * dat$spec[i] * (1 - dat$spec[i]))
  }
  dat$se_logit_sens <- sqrt(dat$var_logit_sens)
  dat$se_logit_spec <- sqrt(dat$var_logit_spec)
  cat("OK Per-study stats computed\n\n")

  # ── Threshold effect test ────────────────────────────────────────────────────

  cat("--- Testing for threshold effect ---\n")
  threshold_test <- tryCatch(
    cor.test(dat$logit_sens, dat$logit_1spec, method = "spearman", exact = FALSE),
    error = function(e) NULL)
  threshold_present <- FALSE
  if (!is.null(threshold_test)) {
    threshold_present <- threshold_test$p.value < alpha
    cat(sprintf("  Spearman rho = %.4f, p = %.4f\n",
                threshold_test$estimate, threshold_test$p.value))
    cat(if (threshold_present)
      "  >> Threshold effect DETECTED — HSROC model appropriate\n\n" else
      "  >> No significant threshold effect\n\n")
  }

  # ── Subgroup detection ───────────────────────────────────────────────────────

  subgroup_cols <- grep("^subgroup_", names(dat), value = TRUE)
  if (length(subgroup_cols) > 0)
    cat("OK Subgroup columns detected:", paste(subgroup_cols, collapse = ", "), "\n\n")

  # ── Bivariate random-effects model ──────────────────────────────────────────

  cat("--- Running bivariate random-effects model ---\n")
  n <- nrow(dat)
  biv_dat <- data.frame(
    yi      = c(dat$logit_sens, dat$logit_spec),
    vi      = c(dat$var_logit_sens, dat$var_logit_spec),
    study   = rep(dat$study, 2),
    measure = factor(rep(c("sens", "spec"), each = n))
  )

  biv_model <- tryCatch(
    metafor::rma.mv(yi = yi, V = vi, mods = ~ measure - 1,
                    random = ~ measure | study, struct = "UN",
                    data = biv_dat, method = "REML"),
    error = function(e) { warning("Bivariate model failed: ", e$message); NULL })

  if (!is.null(biv_model)) {
    pooled_sens    <- as.numeric(plogis(biv_model$b["measuresens", ]))
    pooled_spec    <- as.numeric(plogis(biv_model$b["measurespec", ]))
    pooled_sens_lb <- as.numeric(plogis(biv_model$ci.lb["measuresens"]))
    pooled_sens_ub <- as.numeric(plogis(biv_model$ci.ub["measuresens"]))
    pooled_spec_lb <- as.numeric(plogis(biv_model$ci.lb["measurespec"]))
    pooled_spec_ub <- as.numeric(plogis(biv_model$ci.ub["measurespec"]))
    cat(sprintf("  Pooled Sensitivity: %.4f [%.4f; %.4f]\n", pooled_sens, pooled_sens_lb, pooled_sens_ub))
    cat(sprintf("  Pooled Specificity: %.4f [%.4f; %.4f]\n", pooled_spec, pooled_spec_lb, pooled_spec_ub))
  } else {
    pooled_sens <- mean(dat$sens); pooled_spec <- mean(dat$spec)
    pooled_sens_lb <- pooled_sens_ub <- pooled_spec_lb <- pooled_spec_ub <- NA
  }
  pooled_lr_pos <- pooled_sens / (1 - pooled_spec)
  pooled_lr_neg <- (1 - pooled_sens) / pooled_spec
  pooled_dor    <- pooled_lr_pos / pooled_lr_neg
  cat(sprintf("  Pooled LR+: %.4f | LR-: %.4f | DOR: %.4f\n\n",
              pooled_lr_pos, pooled_lr_neg, pooled_dor))

  # ── HSROC / mada model ───────────────────────────────────────────────────────

  cat("--- Running HSROC model (mada) ---\n")
  mada_model <- mada_auc <- NULL

  if (has_2x2) {
    rows_2x2_complete <- !is.na(dat$tp) & !is.na(dat$fp) & !is.na(dat$fn) & !is.na(dat$tn)
    if (sum(rows_2x2_complete) >= 2) {
      mada_dat <- data.frame(TP = dat$tp[rows_2x2_complete], FP = dat$fp[rows_2x2_complete],
                             FN = dat$fn[rows_2x2_complete], TN = dat$tn[rows_2x2_complete])
      mada_model <- tryCatch(
        mada::reitsma(mada_dat, correction = 0.5, correction.control = "all"),
        error = function(e) { warning("mada::reitsma() failed: ", e$message); NULL })
      if (!is.null(mada_model)) {
        mada_auc_raw <- tryCatch(mada::AUC(mada_model), error = function(e) NULL)
        mada_auc <- if (is.null(mada_auc_raw)) NULL
                    else if (is.list(mada_auc_raw))
                      as.numeric(mada_auc_raw$AUC %||% mada_auc_raw$auc %||% mada_auc_raw[[1]])
                    else as.numeric(mada_auc_raw)
        cat(sprintf("  HSROC model OK. AUC = %.4f\n\n",
                    ifelse(!is.null(mada_auc) && is.finite(mada_auc), mada_auc, NA_real_)))
      }
    }
  } else {
    cat("  Skipped (requires tp/fp/fn/tn columns)\n\n")
  }

  # ── metagen for forest plots ─────────────────────────────────────────────────

  cat("--- Running metagen for forest plots ---\n")
  m_sens <- tryCatch(
    meta::metagen(TE = dat$logit_sens, seTE = dat$se_logit_sens, studlab = dat$study,
                  sm = "PLOGIT", method.tau = "REML"),
    error = function(e) { warning("metagen for sensitivity failed: ", e$message); NULL })
  m_spec <- tryCatch(
    meta::metagen(TE = dat$logit_spec, seTE = dat$se_logit_spec, studlab = dat$study,
                  sm = "PLOGIT", method.tau = "REML"),
    error = function(e) { warning("metagen for specificity failed: ", e$message); NULL })
  cat("OK\n\n")

  # ── Forest plots ─────────────────────────────────────────────────────────────

  cat("--- Saving forest plots ---\n")

  make_forest_args <- function(m, label, main_title) {
    args <- list(m, xlim = c(0, 1), pscale = 1, rightcols = c("effect", "ci"),
         rightlabs = c(label, "95% CI"), leftcols = "studlab", leftlabs = "Study",
         common = TRUE, random = TRUE, overall = TRUE, overall.hetstat = TRUE,
         print.I2 = TRUE, digits = 3, col.square = "steelblue",
         col.diamond = "firebrick", col.diamond.lines = "firebrick", colgap = "5mm",
         fs.heading = 12, fs.study = 10, plotwidth = "8cm", main = main_title)
    .forest_add_pval_text(args, m)
  }

  for (measure_info in list(list(m = m_sens, label = "Sensitivity",
                                  file = paste0("forest_sensitivity_", outcome_safe, ".png")),
                             list(m = m_spec, label = "Specificity",
                                  file = paste0("forest_specificity_", outcome_safe, ".png")))) {
    if (is.null(measure_info$m)) next
    fa <- make_forest_args(measure_info$m, measure_info$label,
                           paste("Forest Plot —", measure_info$label, "\n", outcome_name_display))
    fa <- .forest_add_spacing(fa, nrow(dat))
    tryCatch(do.call(meta::forest, fa),
             error = function(e) warning("Cannot display ", measure_info$label, " forest: ", e$message))
    .fp_dims <- .forest_png_dims(nrow(dat), dat$study)
    tryCatch({
      grDevices::png(measure_info$file, width = .fp_dims$width, height = .fp_dims$height, res = 300)
      do.call(meta::forest, fa)
      grDevices::dev.off()
      cat("  OK", measure_info$label, "forest plot saved\n")
    }, error = function(e) { safe_dev_off(); warning(e$message) })
  }

  # ── SROC curve ───────────────────────────────────────────────────────────────

  if (!is.null(mada_model)) {
    draw_sroc <- function() {
      graphics::plot(NA, xlim = c(0, 1), ylim = c(0, 1),
                     xlab = "1 - Specificity (False Positive Rate)",
                     ylab = "Sensitivity (True Positive Rate)",
                     main = paste("SROC Curve —", outcome_name_display))
      tryCatch({
        sroc_pts <- mada::sroc(mada_model, fpr = seq(0.01, 0.99, by = 0.005))
        sroc_x <- as.numeric(sroc_pts[, 1]); sroc_y <- as.numeric(sroc_pts[, 2])
        if (all(is.finite(sroc_x)) && all(is.finite(sroc_y)))
          graphics::lines(sroc_x, sroc_y, lwd = 2, col = "black")
      }, error = function(e) {
        tryCatch({
          cf <- coef(mada_model); fpr_s <- seq(0.001, 0.999, length.out = 200)
          tpr_s <- plogis(cf[1] + cf[2] * qlogis(fpr_s))
          if (all(is.finite(tpr_s))) graphics::lines(fpr_s, tpr_s, lwd = 2, col = "black")
        }, error = function(e2) warning("SROC curve not drawn: ", e2$message))
      })
      tryCatch(mada::ROCellipse(mada_model, add = TRUE, lty = 2, lwd = 1.5, pch = 1),
               error = function(e) NULL)
      if (exists("rows_2x2_complete") && sum(rows_2x2_complete) > 0)
        graphics::points(1 - dat$spec[rows_2x2_complete], dat$sens[rows_2x2_complete],
                         pch = 19, cex = 1.0, col = "steelblue")
      else
        graphics::points(1 - dat$spec, dat$sens, pch = 19, cex = 1.0, col = "steelblue")
      graphics::points(1 - pooled_spec, pooled_sens, pch = 18, cex = 2.5, col = "red")
      graphics::abline(a = 0, b = 1, lty = 3, col = "gray60")
      leg <- c("SROC curve", "95% conf. region", "Individual studies", "Summary point")
      if (!is.null(mada_auc) && is.numeric(mada_auc) && is.finite(mada_auc))
        leg <- c(leg, paste0("AUC = ", round(mada_auc, 3)),
                 paste0("Pooled Sens = ", round(pooled_sens, 3)),
                 paste0("Pooled Spec = ", round(pooled_spec, 3)))
      graphics::legend("bottomright", legend = leg,
                       col = c("black","black","steelblue","red", rep(NA, max(0, length(leg)-4))),
                       pch = c(NA, NA, 19, 18, rep(NA, max(0, length(leg)-4))),
                       lty = c(1, 2, NA, NA, rep(NA, max(0, length(leg)-4))),
                       lwd = c(2, 1.5, NA, NA, rep(NA, max(0, length(leg)-4))),
                       bty = "n", cex = 0.8, pt.cex = 1.2)
    }
    tryCatch(draw_sroc(), error = function(e) warning("Cannot display SROC: ", e$message))
    tryCatch({
      grDevices::png(paste0("sroc_curve_", outcome_safe, ".png"), width = 2800, height = 2800, res = 300)
      draw_sroc(); grDevices::dev.off()
      cat("  OK SROC curve saved\n")
    }, error = function(e) { safe_dev_off(); warning(e$message) })
  }

  # ── Deeks' funnel plot ───────────────────────────────────────────────────────

  cat("\n--- Deeks' funnel plot (publication bias) ---\n")
  deeks_result <- NULL
  tryCatch({
    dat$log_dor      <- log(dat$dor)
    dat$ess          <- dat$sample
    dat$inv_sqrt_ess <- 1 / sqrt(dat$ess)
    deeks_valid      <- is.finite(dat$log_dor) & is.finite(dat$inv_sqrt_ess)

    if (sum(deeks_valid) >= 3) {
      deeks_lm     <- lm(log_dor ~ inv_sqrt_ess, data = dat[deeks_valid, ],
                         weights = dat$ess[deeks_valid])
      deeks_result <- summary(deeks_lm)
      deeks_pval   <- deeks_result$coefficients[2, 4]
      cat(sprintf("  Deeks' test: slope = %.4f, p = %.4f\n",
                  coef(deeks_lm)[2], deeks_pval))
      cat(if (deeks_pval < 0.10) "  >> Possible publication bias (p < 0.10)\n\n"
          else "  >> No significant publication bias\n\n")

      draw_deeks <- function() {
        plot(dat$inv_sqrt_ess[deeks_valid], dat$log_dor[deeks_valid],
             xlab = "1 / sqrt(Effective Sample Size)", ylab = "log(DOR)",
             main = paste("Deeks' Funnel Plot —", outcome_name_display),
             pch = 19, col = "steelblue", cex = 1.1)
        x_seq <- seq(min(dat$inv_sqrt_ess[deeks_valid]), max(dat$inv_sqrt_ess[deeks_valid]),
                     length.out = 100)
        graphics::lines(x_seq, predict(deeks_lm, newdata = data.frame(inv_sqrt_ess = x_seq)),
                        lty = 2, col = "red", lwd = 2)
        graphics::legend("topright", legend = paste0("p = ", round(deeks_pval, 3)),
                         bty = "n", cex = 0.9)
      }
      tryCatch(draw_deeks(), error = function(e) warning("Cannot display Deeks plot: ", e$message))
      tryCatch({
        grDevices::png(paste0("deeks_funnel_", outcome_safe, ".png"), width = 2800, height = 2800, res = 300)
        draw_deeks(); grDevices::dev.off()
        cat("  OK Deeks' funnel plot saved\n")
      }, error = function(e) { safe_dev_off(); warning(e$message) })
    } else {
      cat("  Skipped: need >= 3 studies with valid DOR\n\n")
    }
  }, error = function(e) warning("Deeks' test failed: ", e$message))

  # ── Subgroup analysis ────────────────────────────────────────────────────────

  subgroup_results <- list()

  if (length(subgroup_cols) > 0 && !is.null(m_sens) && !is.null(m_spec)) {
    for (sg_col in subgroup_cols) {
      sg_name         <- sub("^subgroup_", "", sg_col)
      sg_name_display <- gsub("_", " ", sg_name)
      sg_name_safe    <- gsub("[^A-Za-z0-9]", "_", sg_name)
      sg_values       <- dat[[sg_col]]
      if (all(is.na(sg_values))) { warning("Column '", sg_col, "' all NA. Skipped."); next }
      n_levels <- length(unique(na.omit(sg_values)))
      if (n_levels < 2) { warning("Column '", sg_col, "' has 1 level. Skipped."); next }
      cat("Subgroup analysis:", sg_name_display, "\n")

      for (measure_name in c("sens", "spec")) {
        label <- if (measure_name == "sens") "Sensitivity" else "Specificity"
        tryCatch({
          m_sg_sub <- meta::metagen(
            TE      = if (measure_name == "sens") dat$logit_sens else dat$logit_spec,
            seTE    = if (measure_name == "sens") dat$se_logit_sens else dat$se_logit_spec,
            studlab = dat$study, sm = "PLOGIT",
            subgroup = sg_values, print.subgroup.name = FALSE)
          sg_fa <- list(m_sg_sub, xlim = c(-5, 5), rightcols = c("effect", "ci"),
                        rightlabs = c(label, "95% CI"), leftcols = "studlab", leftlabs = "Study",
                        common = TRUE, random = TRUE, overall = TRUE, overall.hetstat = TRUE,
                        print.I2 = TRUE, digits = 3, col.square = "steelblue",
                        col.diamond = "firebrick", col.diamond.lines = "firebrick",
                        colgap = "5mm", fs.heading = 12, fs.study = 10, plotwidth = "8cm",
                        main = paste("Subgroup:", sg_name_display, "—", label, "\n", outcome_name_display))
          sg_fa <- .forest_add_spacing(sg_fa, nrow(dat))
          sg_fa <- .forest_add_pval_text(sg_fa, m_sg_sub)
          .sg_dims <- .forest_png_dims(nrow(dat), dat$study, n_subgroup_levels = n_levels, is_subgroup = TRUE)
          tryCatch({
            grDevices::png(paste0("forest_subgroup_", sg_name_safe, "_", measure_name, "_", outcome_safe, ".png"),
                           width = .sg_dims$width, height = .sg_dims$height, res = 300)
            do.call(meta::forest, sg_fa)
            grDevices::dev.off()
            cat(sprintf("  OK Subgroup %s %s plot saved\n", sg_name_display, label))
          }, error = function(e) { safe_dev_off(); warning(e$message) })
          subgroup_results[[paste0(sg_col, "_", measure_name)]] <- m_sg_sub
        }, error = function(e) warning("Subgroup failed '", sg_col, "' (", label, "): ", e$message))
      }
    }
  }

  # ── Leave-one-out ────────────────────────────────────────────────────────────

  cat("\n--- Leave-one-out influence analysis ---\n")
  loo_results <- NULL

  if (!is.null(biv_model)) {
    tryCatch({
      n_studies <- nrow(dat); loo_list <- vector("list", n_studies)
      for (i in seq_len(n_studies)) {
        dat_loo <- biv_dat[biv_dat$study != dat$study[i], ]
        m_loo <- NULL
        for (struct in c("UN", "CS", "DIAG")) {
          m_loo <- tryCatch(
            suppressWarnings(metafor::rma.mv(yi = yi, V = vi, mods = ~ measure - 1,
                                             random = ~ measure | study, struct = struct,
                                             data = dat_loo, method = "REML")),
            error = function(e) NULL)
          if (!is.null(m_loo)) break
        }
        if (!is.null(m_loo)) {
          safe_ci <- function(model, coef_name, direction) {
            b_val <- as.numeric(model$b[coef_name, ]); se_val <- as.numeric(model$se[coef_name])
            if (!is.finite(b_val) || !is.finite(se_val)) return(NA_real_)
            ci_val <- if (direction == "lb") {
              v <- as.numeric(model$ci.lb[coef_name])
              if (!is.finite(v)) b_val - 1.96 * se_val else v
            } else {
              v <- as.numeric(model$ci.ub[coef_name])
              if (!is.finite(v)) b_val + 1.96 * se_val else v
            }
            round(plogis(ci_val), 4)
          }
          loo_list[[i]] <- data.frame(
            omitted_study  = as.character(dat$study[i]),
            pooled_sens    = round(plogis(as.numeric(m_loo$b["measuresens", ])), 4),
            pooled_sens_lb = safe_ci(m_loo, "measuresens", "lb"),
            pooled_sens_ub = safe_ci(m_loo, "measuresens", "ub"),
            pooled_spec    = round(plogis(as.numeric(m_loo$b["measurespec", ])), 4),
            pooled_spec_lb = safe_ci(m_loo, "measurespec", "lb"),
            pooled_spec_ub = safe_ci(m_loo, "measurespec", "ub"))
        }
      }
      loo_list_valid <- Filter(Negate(is.null), loo_list)
      loo_results <- if (length(loo_list_valid) > 0) do.call(rbind, loo_list_valid) else NULL
      if (!is.null(loo_results) && nrow(loo_results) > 0) {
        utils::write.csv(loo_results, paste0("leave_one_out_", outcome_safe, ".csv"), row.names = FALSE)
        for (measure in c("sens", "spec")) {
          col_est <- paste0("pooled_", measure); col_lb <- paste0("pooled_", measure, "_lb")
          col_ub  <- paste0("pooled_", measure, "_ub")
          label   <- if (measure == "sens") "Sensitivity" else "Specificity"
          ref_val <- if (measure == "sens") pooled_sens else pooled_spec
          loo_sorted <- loo_results[order(loo_results[[col_est]]), ]
          .loo_p <- .loo_plot_params(loo_sorted$omitted_study)
          draw_loo_diag <- function(ls = loo_sorted, cl = col_lb, cu = col_ub,
                                    ce = col_est, lbl = label, rv = ref_val) {
            graphics::par(mar = .loo_p$mar)
            finite_vals <- c(ls[[cl]], ls[[cu]]); finite_vals <- finite_vals[is.finite(finite_vals)]
            if (length(finite_vals) < 2) { warning("LOO plot skipped: no finite CI for ", lbl); return(invisible(NULL)) }
            xlim_r <- range(finite_vals)
            if (diff(xlim_r) < 0.001) xlim_r <- c(max(0, xlim_r[1]-0.1), min(1, xlim_r[2]+0.1))
            graphics::plot(ls[[ce]], seq_len(nrow(ls)), xlim = xlim_r,
                           xlab = paste("Pooled", lbl, "(Leave-One-Out)"),
                           ylab = "", pch = 19, yaxt = "n",
                           main = paste("LOO —", lbl, "\n", outcome_name_display))
            graphics::mtext("Omitted study", side = 2, line = .loo_p$mtext_line, cex = 0.95, font = 2)
            graphics::axis(2, at = seq_len(nrow(ls)), labels = ls$omitted_study, las = 2, cex.axis = .loo_p$cex_axis)
            graphics::segments(ls[[cl]], seq_len(nrow(ls)), ls[[cu]], seq_len(nrow(ls)))
            graphics::abline(v = rv, lty = 2, lwd = 2, col = "red")
          }
          tryCatch(draw_loo_diag(), error = function(e) warning("LOO viewer failed: ", e$message))
          tryCatch({
            grDevices::png(paste0("leave_one_out_", if(measure=="sens") "sensitivity" else "specificity",
                                  "_", outcome_safe, ".png"),
                           width = .loo_p$png_width, height = .loo_p$png_height, res = 300)
            draw_loo_diag(); grDevices::dev.off()
            cat("  OK LOO", label, "plot saved\n")
          }, error = function(e) { safe_dev_off(); warning(e$message) })
        }
      } else {
        cat("  LOO plots skipped: insufficient studies for convergence\n")
      }
    }, error = function(e) warning("LOO analysis failed: ", e$message))
  }

  # ── Text report ──────────────────────────────────────────────────────────────

  cat("\n--- Generating report ---\n")
  tryCatch({
    report_file <- paste0("report_", outcome_safe, ".txt")
    report_conn <- file(report_file, open = "w")
    wl <- function(...) writeLines(paste0(...), report_conn)
    safe_round <- function(x, digits = 4) {
      x <- suppressWarnings(as.numeric(x))
      if (is.na(x) || !is.finite(x)) return("N/A")
      as.character(round(x, digits))
    }

    wl("============================================================")
    wl("DIAGNOSTIC META-ANALYSIS REPORT (PRISMA-DTA Aligned)")
    wl("============================================================")
    wl("")
    wl("Outcome      : ", outcome_name_display)
    wl("Date         : ", format(Sys.time(), "%Y-%m-%d %H:%M:%S"))
    wl("Model        : Bivariate Random-Effects (Reitsma 2005)")
    wl("Software     : R / metafor::rma.mv + mada::reitsma")
    wl("")
    wl("OVERVIEW")
    wl("Number of studies : ", nrow(dat))
    wl("Total N           : ", sum(dat$sample, na.rm = TRUE))
    if (has_2x2) {
      total_pos <- sum(dat$tp + dat$fn, na.rm = TRUE)
      total_neg <- sum(dat$tn + dat$fp, na.rm = TRUE)
      wl("Disease positive  : ", total_pos,
         " (prevalence = ", round(total_pos / (total_pos + total_neg), 4), ")")
      wl("Disease negative  : ", total_neg)
    }
    wl("")
    wl("THRESHOLD EFFECT TEST")
    if (!is.null(threshold_test)) {
      wl("Spearman rho : ", round(threshold_test$estimate, 4))
      wl("P-value      : ", round(threshold_test$p.value, 4))
      wl("Result       : ", if (threshold_present)
        "Threshold effect PRESENT (p < 0.05)" else "No significant threshold effect")
    }
    wl("")
    wl("POOLED RESULTS — BIVARIATE MODEL")
    wl("Pooled Sensitivity: ", safe_round(pooled_sens),
       " [", safe_round(pooled_sens_lb), "; ", safe_round(pooled_sens_ub), "]")
    wl("Pooled Specificity: ", safe_round(pooled_spec),
       " [", safe_round(pooled_spec_lb), "; ", safe_round(pooled_spec_ub), "]")
    wl("Positive LR (LR+) : ", safe_round(pooled_lr_pos))
    wl("Negative LR (LR-) : ", safe_round(pooled_lr_neg))
    wl("Diagnostic OR (DOR): ", safe_round(pooled_dor))
    if (!is.null(mada_auc)) wl("AUC (SROC)        : ", safe_round(mada_auc))
    wl("")
    wl("HETEROGENEITY")
    if (!is.null(m_sens)) wl("Sensitivity — I2: ", round(m_sens$I2, 2), "%  tau2: ", round(m_sens$tau2, 6))
    if (!is.null(m_spec)) wl("Specificity — I2: ", round(m_spec$I2, 2), "%  tau2: ", round(m_spec$tau2, 6))
    if (!is.null(biv_model)) {
      wl("Bivariate tau2 (sens): ", round(biv_model$sigma2[1], 6))
      wl("Bivariate tau2 (spec): ", round(biv_model$sigma2[2], 6))
    }
    wl("")
    wl("PUBLICATION BIAS — DEEKS' TEST")
    if (!is.null(deeks_result)) {
      dv <- deeks_result$coefficients[2, 4]
      wl("Slope  : ", round(deeks_result$coefficients[2, 1], 4))
      wl("P-value: ", round(dv, 4))
      wl("Result : ", if (dv < 0.10) "Possible publication bias (p < 0.10)"
                      else "No significant publication bias (p >= 0.10)")
    } else {
      wl("Not computed (requires >= 3 studies with valid DOR)")
    }
    wl("")
    if (length(subgroup_results) > 0) {
      wl("SUBGROUP ANALYSIS")
      sg_cols_done <- unique(sub("_(sens|spec)$", "", names(subgroup_results)))
      for (sg_col in sg_cols_done) {
        wl("Subgroup: ", gsub("_", " ", sub("^subgroup_", "", sg_col)))
        for (measure in c("sens", "spec")) {
          key <- paste0(sg_col, "_", measure)
          if (!is.null(subgroup_results[[key]])) {
            m_sg <- subgroup_results[[key]]
            label <- if (measure == "sens") "Sensitivity" else "Specificity"
            wl("  [", label, "]")
            if (!is.null(m_sg$bylevs)) {
              for (j in seq_along(m_sg$bylevs)) {
                wl("    ", m_sg$bylevs[j], ": ",
                   round(plogis(m_sg$TE.random.w[j]), 4),
                   " [", round(plogis(m_sg$lower.random.w[j]), 4), "; ",
                   round(plogis(m_sg$upper.random.w[j]), 4), "]",
                   "  I2=", round(m_sg$I2.w[j] * 100, 1), "%")
              }
              if (!is.null(m_sg$pval.Q.b.random))
                wl("    P between subgroups: ", round(m_sg$pval.Q.b.random, 4))
            }
          }
        }
        wl("")
      }
    }
    if (!is.null(loo_results) && nrow(loo_results) > 0) {
      wl("LEAVE-ONE-OUT ANALYSIS")
      wl("")
      for (i in seq_len(nrow(loo_results))) {
        wl("  Omit ", loo_results$omitted_study[i],
           ": Sens=", loo_results$pooled_sens[i],
           " [", loo_results$pooled_sens_lb[i], "; ", loo_results$pooled_sens_ub[i], "]",
           "  Spec=", loo_results$pooled_spec[i],
           " [", loo_results$pooled_spec_lb[i], "; ", loo_results$pooled_spec_ub[i], "]")
      }
    }
    wl("")
    wl("============================================================")
    wl("END OF REPORT")
    wl("============================================================")
    cat("OK Report saved:", report_file, "\n")
  }, error = function(e) warning("Failed to generate report: ", e$message),
     finally = {
       if (exists("report_conn") && inherits(report_conn, "connection") &&
           tryCatch(isOpen(report_conn), error = function(e) FALSE)) close(report_conn)
     })

  cat("\n==========================================\n")
  cat("DIAGNOSTIC ANALYSIS COMPLETE\n")
  cat("==========================================\n")
  cat("Files saved to:\n", output_folder, "\n")
  cat("==========================================\n")

  invisible(list(bivariate_model = biv_model, mada_model = mada_model,
                 metaprop_sens = m_sens, metaprop_spec = m_spec,
                 subgroup_results = subgroup_results, loo_table = loo_results,
                 threshold_test = threshold_test,
                 pooled = list(sensitivity = c(est = pooled_sens, lower = pooled_sens_lb, upper = pooled_sens_ub),
                               specificity = c(est = pooled_spec, lower = pooled_spec_lb, upper = pooled_spec_ub),
                               lr_pos = pooled_lr_pos, lr_neg = pooled_lr_neg,
                               dor = pooled_dor, auc = mada_auc),
                 dat_processed = dat, output_folder = output_folder))
}


# =============================================================================


# =============================================================================
# SECTION 7: NETWORK META-ANALYSIS ENGINE
# run_network_meta_analysis() + plot_net_clinical_benefit()
# =============================================================================
# =============================================================================
# NETWORK META-ANALYSIS ENGINE
# =============================================================================
#
# run_network_meta_analysis() — satu fungsi untuk semua.
#
# BINARY OUTCOME (OR / RR / HR / RD):
#   Opsi A: yi + lowci + highci (precalculated)
#   Opsi B: event1 + n1/sample1 + event2 + n2/sample2 (raw 2×2)
#   Opsi C: campuran A+B antar baris
#
# CONTINUOUS OUTCOME (MD / SMD):
#   Opsi A: md + lowci + highci (precalculated)
#   Opsi B: md + sd + n1/sample1 + n2/sample2 (CI auto-calc)
#   Opsi C: mean1 + sd1 + n1 + mean2 + sd2 + n2 (MD/SMD auto-calc)
#   Opsi D: median1 + q1_1 + q3_1 + min1 + max1 + n1 (Wan-S2) → mean/SD
#   Opsi E: median1 + q1_1 + q3_1 + n1 (Wan-S1) → mean/SD
#   Opsi F: median1 + iqr1 + n1 (IQR → Q1/Q3 → Wan-S1)
#   Boleh CAMPUR opsi A–F antar baris dalam satu dataset
#
# PRE-CALCULATED (TE + seTE langsung):
#   Kolom: TE + seTE sudah terisi → langsung dipakai (skip auto-calc)
#
# KOLOM WAJIB: study, treat1, treat2
#
# SUBGROUP:
#   Tambahkan kolom subgroup_xxx (prefix subgroup_)
#
# OUTPUT:
#   - Summary NMA
#   - Network graph
#   - Forest plot (vs reference treatment)
#   - League table (random effects) → CSV + Excel + visual
#   - P-score ranking + bar plot
#   - Inconsistency tests (netsplit + decomp.design)
#   - Text report
#   - Semua plot disimpan sebagai PNG

run_network_meta_analysis <- function(dat,
                                       outcome_name,
                                       effect_measure = "RR",
                                       reference       = NULL,
                                       small_values    = "desirable") {

  # ── Load packages ──────────────────────────────────────────────────────────
  for (pkg in c("netmeta", "meta", "metafor", "ggplot2", "gridExtra", "writexl")) {
    if (!requireNamespace(pkg, quietly = TRUE))
      stop(paste0("Package '", pkg, "' not installed. Run install_nma_packages() first."))
  }

  library(netmeta)
  library(ggplot2)

  # ── Validate inputs ────────────────────────────────────────────────────────
  if (missing(dat) || is.null(dat) || !is.data.frame(dat))
    stop("'dat' must be a data.frame")
  if (nrow(dat) < 2)
    stop("At least 2 studies required")
  if (missing(outcome_name) || is.null(outcome_name) || trimws(outcome_name) == "")
    stop("outcome_name cannot be empty")

  effect_measure <- toupper(trimws(effect_measure))
  outcome_name_display <- gsub("[_-]", " ", outcome_name)
  outcome_safe <- trimws(gsub("_+", "_", gsub("[^A-Za-z0-9]", "_", outcome_name_display)),
                         whitespace = "_")

  # ── Required columns check ─────────────────────────────────────────────────
  for (col in c("study", "treat1", "treat2"))
    if (!col %in% names(dat))
      stop(paste("Required column missing:", col))

  # ── Detect outcome type from effect_measure ────────────────────────────────
  is_binary     <- effect_measure %in% c("OR", "RR", "HR", "RD")
  is_continuous <- effect_measure %in% c("MD", "SMD")
  is_log_scale  <- effect_measure %in% c("OR", "RR", "HR")

  if (!is_binary && !is_continuous)
    stop("effect_measure must be one of: OR, RR, HR, RD, MD, SMD")

  data_type <- if (is_binary) "binary" else "continuous"

  # ── Create output folder ───────────────────────────────────────────────────
  timestamp     <- format(Sys.time(), "%Y%m%d_%H%M%S")
  output_folder <- .resolve_nma_output_folder(
    paste0("NMA_", outcome_safe, "_", timestamp))

  cat("\n==========================================\n")
  cat("NETWORK META-ANALYSIS ENGINE\n")
  cat("==========================================\n")
  cat("Outcome        :", outcome_name_display, "\n")
  cat("Effect measure :", effect_measure, "\n")
  cat("Data type      :", data_type, "\n")
  cat("Studies        :", nrow(dat), "\n")
  cat("Output folder  :", output_folder, "\n\n")

  original_wd <- getwd()
  on.exit(setwd(original_wd), add = TRUE)
  setwd(output_folder)

  # ── Helpers ────────────────────────────────────────────────────────────────
  safe_dev_off <- function() {
    while (grDevices::dev.cur() > 1)
      tryCatch(grDevices::dev.off(), error = function(e) NULL)
  }
  safe_dev_off()

  val_is_empty <- function(x) is.na(x) | (is.character(x) & trimws(as.character(x)) == "")

  # ── Coerce columns ────────────────────────────────────────────────────────
  dat$study  <- trimws(as.character(dat$study))
  dat$treat1 <- trimws(as.character(dat$treat1))
  dat$treat2 <- trimws(as.character(dat$treat2))

  # Drop rows without study/treat1/treat2 (catches note rows from Excel template)
  rows_core <- !is.na(dat$study) & nzchar(dat$study) &
               !is.na(dat$treat1) & nzchar(dat$treat1) &
               !is.na(dat$treat2) & nzchar(dat$treat2)
  if (sum(rows_core) < nrow(dat)) {
    n_dropped <- nrow(dat) - sum(rows_core)
    dat <- dat[rows_core, ]
    cat(sprintf("Info: %d non-data rows removed (missing study/treat1/treat2)\n", n_dropped))
  }

  # Coerce all possible numeric columns
  possible_num <- c("yi","lowci","highci","event1","sample1","event2","sample2",
                    "n1","n2",
                    "md","sd","mean1","sd1","mean2","sd2",
                    "median1","iqr1","q1_1","q3_1","min1","max1",
                    "median2","iqr2","q1_2","q3_2","min2","max2",
                    "TE","seTE")
  for (col in possible_num)
    if (col %in% names(dat))
      dat[[col]] <- suppressWarnings(as.numeric(as.character(dat[[col]])))

  # Normalize column names: sample1/sample2 → n1/n2 alias
  if ("sample1" %in% names(dat) && !"n1" %in% names(dat)) dat$n1 <- dat$sample1
  if ("sample2" %in% names(dat) && !"n2" %in% names(dat)) dat$n2 <- dat$sample2
  if ("n1" %in% names(dat) && !"sample1" %in% names(dat)) dat$sample1 <- dat$n1
  if ("n2" %in% names(dat) && !"sample2" %in% names(dat)) dat$sample2 <- dat$n2

  # ── Initialize TE / seTE columns ──────────────────────────────────────────
  dat$TE   <- if ("TE" %in% names(dat)) dat$TE else NA_real_
  dat$seTE <- if ("seTE" %in% names(dat)) dat$seTE else NA_real_

  # ═══════════════════════════════════════════════════════════════════════════
  # AUTO-CALCULATE TE / seTE — PER ROW, MULTI-SCENARIO
  # ═══════════════════════════════════════════════════════════════════════════

  cat("--- Computing TE / seTE per row ---\n")

  if (is_binary) {
    # ── BINARY: yi/lowci/highci → TE/seTE, or event/n → TE/seTE ─────────────
    # Priority: (1) precalc yi+CI, (2) raw 2×2 event/n

    for (i in seq_len(nrow(dat))) {
      lbl <- dat$study[i]

      # Skip if TE+seTE already filled
      if (!is.na(dat$TE[i]) && !is.na(dat$seTE[i])) next

      # Opsi 1: yi + lowci + highci (precalculated effect size)
      yi_val <- if ("yi" %in% names(dat)) dat$yi[i] else NA
      lo_val <- if ("lowci" %in% names(dat)) dat$lowci[i] else NA
      hi_val <- if ("highci" %in% names(dat)) dat$highci[i] else NA

      if (!is.na(yi_val) && !is.na(lo_val) && !is.na(hi_val)) {
        if (is_log_scale) {
          # OR/RR/HR: yi is on natural scale, convert to log
          if (yi_val > 0 && lo_val > 0 && hi_val > 0) {
            dat$TE[i]   <- log(yi_val)
            dat$seTE[i] <- (log(hi_val) - log(lo_val)) / (2 * 1.96)
            cat(sprintf("  Row %d (%s): TE from yi+CI [%s=%.4f, log=%.4f]\n",
                        i, lbl, effect_measure, yi_val, dat$TE[i]))
            next
          }
        } else {
          # RD: yi already on difference scale
          dat$TE[i]   <- yi_val
          dat$seTE[i] <- (hi_val - lo_val) / (2 * 1.96)
          cat(sprintf("  Row %d (%s): TE from yi+CI [%s=%.4f]\n",
                      i, lbl, effect_measure, yi_val))
          next
        }
      }

      # Opsi 2: raw 2×2 (event1/n1/event2/n2)
      e1 <- if ("event1" %in% names(dat)) dat$event1[i] else NA
      e2 <- if ("event2" %in% names(dat)) dat$event2[i] else NA
      n1 <- if ("n1" %in% names(dat)) dat$n1[i] else NA
      n2 <- if ("n2" %in% names(dat)) dat$n2[i] else NA

      if (!any(is.na(c(e1, n1, e2, n2))) && n1 > 0 && n2 > 0 &&
          e1 >= 0 && e2 >= 0 && e1 <= n1 && e2 <= n2) {
        escalc_sm <- if (effect_measure == "HR") "RR" else effect_measure
        tryCatch({
          result <- metafor::escalc(measure = escalc_sm,
                                    ai = e1, n1i = n1, ci = e2, n2i = n2,
                                    add = 0.5, to = "only0")
          dat$TE[i]   <- as.numeric(result$yi)
          dat$seTE[i] <- sqrt(as.numeric(result$vi))
          cat(sprintf("  Row %d (%s): TE from 2×2 [%s=%.4f]\n",
                      i, lbl, effect_measure, exp(dat$TE[i])))
        }, error = function(e) warning("Row ", i, " (", lbl, "): escalc failed: ", e$message))
        next
      }

      warning("Row ", i, " (", lbl, "): insufficient data for binary TE calculation")
    }

  } else {
    # ── CONTINUOUS: multiple pathways to TE/seTE ──────────────────────────────
    # Priority: (1) md+CI, (2) md+sd, (3) mean/sd, (4) median/IQR→mean/sd, (5) TE/seTE

    # ── Wan et al. helpers for median/IQR conversion ──────────────────────────
    .wan_mean <- function(med, q1, q3, n, xmin = NA, xmax = NA) {
      if (!is.na(xmin) && !is.na(xmax))
        (xmin + 2*q1 + 2*med + 2*q3 + xmax) / 8
      else
        (q1 + med + q3) / 3
    }
    .wan_sd <- function(q1, q3, n, xmin = NA, xmax = NA) {
      if (!is.na(xmin) && !is.na(xmax)) {
        r_part  <- (xmax - xmin) / (2 * qnorm((n - 0.375) / (n + 0.25)))
        iqr_part<- (q3  - q1  ) / (2 * qnorm((0.75 * n - 0.125) / (n + 0.25)))
        (r_part + iqr_part) / 2
      } else {
        (q3 - q1) / (2 * qnorm((0.75 * n - 0.125) / (n + 0.25)))
      }
    }

    # Initialize mean/sd columns if not present
    for (col in c("mean1","sd1","mean2","sd2","md"))
      if (!col %in% names(dat)) dat[[col]] <- NA_real_

    for (i in seq_len(nrow(dat))) {
      lbl <- dat$study[i]

      # Skip if TE+seTE already filled
      if (!is.na(dat$TE[i]) && !is.na(dat$seTE[i])) next

      n1 <- if ("n1" %in% names(dat)) dat$n1[i] else NA
      n2 <- if ("n2" %in% names(dat)) dat$n2[i] else NA

      # ── Opsi 1: md + lowci + highci ──────────────────────────────────────
      md_val <- dat$md[i]
      lo_val <- if ("lowci" %in% names(dat)) dat$lowci[i] else NA
      hi_val <- if ("highci" %in% names(dat)) dat$highci[i] else NA

      if (!is.na(md_val) && !is.na(lo_val) && !is.na(hi_val)) {
        dat$TE[i]   <- md_val
        dat$seTE[i] <- (hi_val - lo_val) / (2 * 1.96)
        cat(sprintf("  Row %d (%s): TE from md+CI [%s=%.4f]\n", i, lbl, effect_measure, md_val))
        next
      }

      # ── Opsi 2: md + sd + n1 + n2 ───────────────────────────────────────
      sd_val <- if ("sd" %in% names(dat)) dat$sd[i] else NA
      if (!is.na(md_val) && !is.na(sd_val) && !is.na(n1) && !is.na(n2) &&
          sd_val > 0 && n1 >= 2 && n2 >= 2) {
        dat$TE[i]   <- md_val
        dat$seTE[i] <- sd_val * sqrt(1/n1 + 1/n2)
        cat(sprintf("  Row %d (%s): TE from md+sd [%s=%.4f]\n", i, lbl, effect_measure, md_val))
        next
      }

      # ── Opsi 3–4: need mean1/sd1/mean2/sd2 — first try median/IQR conversion ──
      for (grp in c(1, 2)) {
        med_col  <- paste0("median", grp)
        q1_col   <- paste0("q1_",   grp)
        q3_col   <- paste0("q3_",   grp)
        iqr_col  <- paste0("iqr",   grp)
        min_col  <- paste0("min",   grp)
        max_col  <- paste0("max",   grp)
        mean_col <- paste0("mean",  grp)
        sd_col2  <- paste0("sd",    grp)
        n_col    <- paste0("n",     grp)

        # Skip if mean/SD already present for this group
        if (!val_is_empty(dat[[mean_col]][i]) && !val_is_empty(dat[[sd_col2]][i])) next

        med  <- if (med_col %in% names(dat)) dat[[med_col]][i] else NA
        q1   <- if (q1_col  %in% names(dat)) dat[[q1_col]][i]  else NA
        q3   <- if (q3_col  %in% names(dat)) dat[[q3_col]][i]  else NA
        iqr  <- if (iqr_col %in% names(dat)) dat[[iqr_col]][i] else NA
        xmin <- if (min_col %in% names(dat)) dat[[min_col]][i] else NA
        xmax <- if (max_col %in% names(dat)) dat[[max_col]][i] else NA
        n_g  <- if (n_col   %in% names(dat)) dat[[n_col]][i]   else NA

        if (is.na(med) || is.na(n_g) || n_g < 2) next

        # If only IQR, derive q1/q3
        if (is.na(q1) && !is.na(iqr)) {
          q1 <- med - iqr / 2
          q3 <- med + iqr / 2
        }

        if (!is.na(q1) && !is.na(q3) && q3 > q1) {
          use_mm <- !is.na(xmin) && !is.na(xmax) && xmax > xmin
          m_est <- .wan_mean(med, q1, q3, n_g,
                             xmin = if (use_mm) xmin else NA,
                             xmax = if (use_mm) xmax else NA)
          s_est <- .wan_sd(q1, q3, n_g,
                           xmin = if (use_mm) xmin else NA,
                           xmax = if (use_mm) xmax else NA)
          method_tag <- if (use_mm) "Wan-S2" else "Wan-S1"
          if (is.finite(m_est) && is.finite(s_est) && s_est > 0) {
            dat[[mean_col]][i] <- m_est
            dat[[sd_col2]][i]  <- s_est
            cat(sprintf("  Row %d (%s) grp%d: median/IQR → mean=%.4f SD=%.4f [%s]\n",
                        i, lbl, grp, m_est, s_est, method_tag))
          }
        }
      }

      # ── Opsi 3: mean1/sd1 + mean2/sd2 → escalc MD/SMD ──────────────────
      m1 <- dat$mean1[i]; s1 <- dat$sd1[i]
      m2 <- dat$mean2[i]; s2 <- dat$sd2[i]

      if (!any(is.na(c(m1, s1, n1, m2, s2, n2))) &&
          s1 > 0 && s2 > 0 && n1 >= 2 && n2 >= 2) {
        tryCatch({
          result <- metafor::escalc(measure = effect_measure,
                                    m1i = m1, sd1i = s1, n1i = n1,
                                    m2i = m2, sd2i = s2, n2i = n2)
          dat$TE[i]   <- as.numeric(result$yi)
          dat$seTE[i] <- sqrt(as.numeric(result$vi))
          cat(sprintf("  Row %d (%s): TE from mean/sd [%s=%.4f]\n",
                      i, lbl, effect_measure, dat$TE[i]))
        }, error = function(e) warning("Row ", i, " (", lbl, "): escalc failed: ", e$message))
        next
      }

      # If still no TE, warn
      if (is.na(dat$TE[i]) || is.na(dat$seTE[i]))
        warning("Row ", i, " (", lbl, "): insufficient data for continuous TE calculation")
    }
  }

  # ── Drop rows without TE/seTE ─────────────────────────────────────────────
  rows_valid <- !is.na(dat$TE) & !is.na(dat$seTE) & is.finite(dat$TE) &
                is.finite(dat$seTE) & dat$seTE > 0
  if (sum(rows_valid) < nrow(dat)) {
    dropped <- dat$study[!rows_valid]
    for (s in dropped) warning("Row '", s, "' dropped: could not compute TE/seTE")
    dat <- dat[rows_valid, ]
  }
  if (nrow(dat) < 2)
    stop("Fewer than 2 valid studies after TE/seTE computation.")

  cat("OK Dataset valid —", nrow(dat), "comparisons from",
      length(unique(dat$study)), "studies\n")

  # ── Identify treatments ────────────────────────────────────────────────────
  all_treats <- sort(unique(c(dat$treat1, dat$treat2)))
  n_treats   <- length(all_treats)
  cat("OK Treatments detected:", n_treats, "\n")
  for (tr in all_treats) cat("  -", tr, "\n")
  cat("\n")

  # ── Subgroup detection ─────────────────────────────────────────────────────
  subgroup_cols <- grep("^subgroup_", names(dat), value = TRUE)
  if (length(subgroup_cols) > 0) {
    cat("OK Subgroup columns detected:\n")
    for (sg in subgroup_cols) cat("  -", sg, "\n")
    cat("\n")
  }

  # ── Set reference treatment ────────────────────────────────────────────────
  if (is.null(reference)) {
    # Auto-select: treatment yang paling sering muncul di kolom treat2
    # (treat2 biasanya diisi comparator/placebo → kandidat terbaik sebagai referensi)
    treat2_freq  <- sort(table(dat$treat2), decreasing = TRUE)
    top_treat2   <- names(treat2_freq)[1]
    # Pastikan treatment tersebut memang ada di daftar treatment valid
    reference <- if (!is.null(top_treat2) && top_treat2 %in% all_treats)
                   top_treat2 else all_treats[1]
    cat("INFO Reference treatment (auto-selected — most frequent treat2):", reference, "\n")
    cat("     Frekuensi treat2:", paste(names(treat2_freq),
                                        treat2_freq, sep = "=", collapse = ", "), "\n")
    cat("     Ubah dengan mengisi kolom nma_reference di Excel,\n")
    cat("     atau parameter reference = 'nama_treatment'\n\n")
  } else {
    reference <- trimws(reference)
    if (!reference %in% all_treats)
      stop("Reference '", reference, "' not found in treatment list: ",
           paste(all_treats, collapse = ", "))
    cat("OK Reference treatment:", reference, "\n\n")
  }

  # ── Build pairwise data (TE/seTE already computed) ─────────────────────────
  cat("--- Preparing pairwise data ---\n")
  pw <- data.frame(
    TE      = dat$TE,
    seTE    = dat$seTE,
    treat1  = dat$treat1,
    treat2  = dat$treat2,
    studlab = dat$study,
    stringsAsFactors = FALSE
  )
  # Carry over subgroup columns to pw
  for (sg in subgroup_cols) pw[[sg]] <- dat[[sg]]
  cat("OK Pairwise data —", nrow(pw), "comparisons\n\n")

  # ── Run Network Meta-Analysis ──────────────────────────────────────────────
  cat("--- Running Network Meta-Analysis ---\n")

  nma <- tryCatch(
    netmeta::netmeta(
      TE      = pw$TE,
      seTE    = pw$seTE,
      treat1  = pw$treat1,
      treat2  = pw$treat2,
      studlab = pw$studlab,
      sm      = effect_measure,
      method.tau = "REML",
      random  = TRUE,
      common  = TRUE,  # netmeta >= 7.0 uses 'common', fallback via tryCatch
      reference.group = reference,
      small.values = small_values
    ),
    error = function(e) {
      # Fallback untuk versi netmeta lama yang pakai fixed bukan common
      tryCatch(
        netmeta::netmeta(
          TE      = pw$TE,
          seTE    = pw$seTE,
          treat1  = pw$treat1,
          treat2  = pw$treat2,
          studlab = pw$studlab,
          sm      = effect_measure,
          method.tau = "REML",
          random  = TRUE,
          fixed   = TRUE,
          reference.group = reference,
          small.values = small_values
        ),
        error = function(e2) stop("netmeta() failed: ", e2$message)
      )
    }
  )

  cat("OK Network meta-analysis completed\n\n")

  # ── Print NMA summary ─────────────────────────────────────────────────────
  cat("--- NMA Summary ---\n")
  nma_summary <- summary(nma)
  print(nma_summary)
  cat("\n")

  # ── Save NMA summary to file ──────────────────────────────────────────────
  tryCatch({
    sink(paste0("nma_summary_", outcome_safe, ".txt"))
    print(nma_summary)
    sink()
    cat("OK NMA summary saved\n\n")
  }, error = function(e) { sink(); warning("Failed to save summary: ", e$message) })

  # ═══════════════════════════════════════════════════════════════════════════
  # VISUALIZATION 1: NETWORK GRAPH
  # ═══════════════════════════════════════════════════════════════════════════

  cat("--- Creating network graph ---\n")

  draw_netgraph <- function() {
    netmeta::netgraph(nma,
                      plastic     = FALSE,
                      number.of.studies = TRUE,
                      multiarm    = TRUE,
                      cex         = 1.2,
                      cex.number  = 0.9,
                      col         = "steelblue4",
                      col.number  = "white",
                      lwd         = 2,
                      main        = paste("Network Graph —", outcome_name_display))
  }

  tryCatch(draw_netgraph(),
           error = function(e) warning("Cannot display network graph: ", e$message))
  tryCatch({
    grDevices::png(paste0("network_graph_", outcome_safe, ".png"),
                   width = 2400, height = 2400, res = 250)
    draw_netgraph()
    grDevices::dev.off()
    cat("OK Network graph saved\n\n")
  }, error = function(e) { safe_dev_off(); warning("Failed to save network graph: ", e$message) })

  # ═══════════════════════════════════════════════════════════════════════════
  # VISUALIZATION 2: FOREST PLOT (vs Reference)
  # ═══════════════════════════════════════════════════════════════════════════

  cat("--- Creating forest plot (vs ", reference, ") ---\n")

  draw_forest_nma <- function() {
    # forest() is an S3 generic from meta — dispatch to forest.netmeta
    # netmeta registers the method but doesn't export 'forest' directly
    forest(nma,
           reference.group = reference,
           sortvar         = TE,
           label.left      = paste("Favors", reference),
           label.right     = paste("Favors Treatment"),
           smlab           = paste(effect_measure, "vs", reference),
           main            = paste("Forest Plot —", outcome_name_display))
  }

  tryCatch(draw_forest_nma(),
           error = function(e) warning("Cannot display forest plot: ", e$message))
  .fp_dims <- .forest_png_dims(n_treats, NULL)
  tryCatch({
    grDevices::png(paste0("forest_nma_", outcome_safe, ".png"),
                   width = .fp_dims$width, height = .fp_dims$height, res = 300)
    draw_forest_nma()
    grDevices::dev.off()
    cat("OK Forest plot saved\n\n")
  }, error = function(e) { safe_dev_off(); warning("Failed to save forest plot: ", e$message) })

  # ═══════════════════════════════════════════════════════════════════════════
  # VISUALIZATION 3: LEAGUE TABLE
  # ═══════════════════════════════════════════════════════════════════════════

  cat("--- Generating league table ---\n")
  league_table <- NULL

  tryCatch({
    lt <- netmeta::netleague(nma, digits = 2,
                              bracket = "(", separator = " to ")

    # Extract random effects table
    df_lt <- as.data.frame(lt$random)
    # Coba set row/col names — handle different netmeta versions
    tryCatch({
      if (!is.null(lt$treatments)) {
        rownames(df_lt) <- lt$treatments
        colnames(df_lt) <- lt$treatments
      } else if (!is.null(lt$trts)) {
        rownames(df_lt) <- lt$trts
        colnames(df_lt) <- lt$trts
      }
    }, error = function(e) NULL)

    league_table <- df_lt

    # Save as CSV
    utils::write.csv(df_lt, paste0("league_table_", outcome_safe, ".csv"))

    # Save as Excel
    tryCatch({
      writexl::write_xlsx(df_lt, paste0("league_table_", outcome_safe, ".xlsx"))
      cat("  OK League table saved (CSV + Excel)\n")
    }, error = function(e) cat("  OK League table saved (CSV only)\n"))

    # Visualize with gridExtra
    draw_league_visual <- function() {
      grid::grid.newpage()
      gridExtra::grid.table(df_lt, rows = rownames(df_lt))
    }
    tryCatch(draw_league_visual(),
             error = function(e) warning("Cannot display league table: ", e$message))
    tryCatch({
      grDevices::png(paste0("league_table_visual_", outcome_safe, ".png"),
                     width = max(1600, n_treats * 300),
                     height = max(800, n_treats * 150), res = 150)
      draw_league_visual()
      grDevices::dev.off()
      cat("  OK League table visual saved\n\n")
    }, error = function(e) {
      safe_dev_off()
      warning("League table visual failed: ", e$message)
    })

  }, error = function(e) warning("League table generation failed: ", e$message))

  # ═══════════════════════════════════════════════════════════════════════════
  # VISUALIZATION 4: P-SCORE RANKING
  # ═══════════════════════════════════════════════════════════════════════════

  cat("--- Computing treatment ranking (P-scores) ---\n")
  pscore_obj <- NULL

  tryCatch({
    pscore_obj <- netmeta::netrank(nma, small.values = small_values)

    # Extract P-score values (random effects)
    pscore_values <- if (!is.null(pscore_obj$Pscore.random))
                       pscore_obj$Pscore.random
                     else if (!is.null(pscore_obj$ranking.random))
                       pscore_obj$ranking.random
                     else pscore_obj$Pscore

    df_pscore <- data.frame(
      Treatment = names(pscore_values),
      P_score   = as.numeric(pscore_values),
      stringsAsFactors = FALSE
    )
    df_pscore <- df_pscore[order(df_pscore$P_score, decreasing = TRUE), ]

    cat("\n  Treatment Ranking (P-score, random effects):\n")
    for (i in seq_len(nrow(df_pscore)))
      cat(sprintf("  %d. %-35s P-score = %.3f\n", i,
                  df_pscore$Treatment[i], df_pscore$P_score[i]))
    cat("\n")

    # Save ranking CSV
    utils::write.csv(df_pscore, paste0("pscore_ranking_", outcome_safe, ".csv"),
                     row.names = FALSE)

    # P-score bar plot
    draw_pscore <- function() {
      p <- ggplot2::ggplot(df_pscore,
                           ggplot2::aes(x = reorder(Treatment, P_score),
                                        y = P_score)) +
        ggplot2::geom_col(fill = "#4B9CD3", width = 0.7) +
        ggplot2::coord_flip() +
        ggplot2::geom_text(ggplot2::aes(label = round(P_score, 3)),
                           hjust = -0.1, size = 4) +
        ggplot2::labs(
          title = paste("Treatment Ranking — P-score (Random Effects)\n",
                        outcome_name_display),
          x = "Treatment", y = "P-score") +
        ggplot2::theme_minimal(base_size = 12) +
        ggplot2::ylim(0, 1.05)
      print(p)
    }

    tryCatch(draw_pscore(),
             error = function(e) warning("Cannot display P-score plot: ", e$message))
    tryCatch({
      grDevices::png(paste0("pscore_ranking_", outcome_safe, ".png"),
                     width = 2400, height = max(800, n_treats * 200), res = 250)
      draw_pscore()
      grDevices::dev.off()
      cat("OK P-score ranking plot saved\n\n")
    }, error = function(e) { safe_dev_off(); warning(e$message) })

  }, error = function(e) warning("P-score computation failed: ", e$message))

  # ═══════════════════════════════════════════════════════════════════════════
  # INCONSISTENCY TESTS
  # ═══════════════════════════════════════════════════════════════════════════

  cat("--- Running inconsistency tests ---\n")
  netsplit_result <- decomp_result <- NULL

  # Netsplit (SIDE analysis: direct vs indirect)
  tryCatch({
    netsplit_result <- netmeta::netsplit(nma)
    cat("OK netsplit() — Split-Node (SIDE) analysis completed\n")

    # Save netsplit results
    tryCatch({
      sink(paste0("netsplit_", outcome_safe, ".txt"))
      print(netsplit_result)
      sink()
    }, error = function(e) { sink(); NULL })

    # Netsplit forest plot
    tryCatch(forest(netsplit_result, show = "all"),
             error = function(e) warning("Cannot display netsplit forest: ", e$message))
    tryCatch({
      .ns_dims <- .forest_png_dims(n_treats * 3, NULL, n_subgroup_levels = n_treats, is_subgroup = TRUE)
      grDevices::png(paste0("netsplit_forest_", outcome_safe, ".png"),
                     width = max(3500, .ns_dims$width), height = max(1200, .ns_dims$height), res = 250)
      forest(netsplit_result, show = "all")
      grDevices::dev.off()
      cat("  OK Netsplit forest plot saved\n")
    }, error = function(e) { safe_dev_off(); warning("Netsplit forest failed: ", e$message) })

  }, error = function(e) warning("netsplit() failed: ", e$message))

  # Decomp.design (design-by-treatment interaction)
  tryCatch({
    decomp_result <- netmeta::decomp.design(nma)
    cat("OK decomp.design() — Design-by-treatment interaction completed\n")

    tryCatch({
      sink(paste0("decomp_design_", outcome_safe, ".txt"))
      print(decomp_result)
      sink()
    }, error = function(e) { sink(); NULL })

  }, error = function(e) warning("decomp.design() failed: ", e$message))

  cat("\n")

  # ═══════════════════════════════════════════════════════════════════════════
  # SUBGROUP ANALYSIS (jika ada kolom subgroup_)
  # ═══════════════════════════════════════════════════════════════════════════

  subgroup_nma_results <- list()

  if (length(subgroup_cols) > 0) {
    cat("--- Running subgroup NMA ---\n")

    for (sg_col in subgroup_cols) {
      sg_name         <- sub("^subgroup_", "", sg_col)
      sg_name_display <- gsub("_", " ", sg_name)
      sg_name_safe    <- gsub("[^A-Za-z0-9]", "_", sg_name)

      # We need subgroup at pairwise level
      # Map subgroup from dat into pw
      if (!sg_col %in% names(pw)) {
        # pairwise() may or may not carry over extra columns
        # Try matching by studlab
        sg_map <- stats::setNames(as.character(dat[[sg_col]]), dat$study)
        pw_sg  <- sg_map[as.character(pw$studlab)]
      } else {
        pw_sg <- as.character(pw[[sg_col]])
      }

      if (all(is.na(pw_sg))) { warning("Subgroup '", sg_col, "' all NA. Skipped."); next }
      n_levels <- length(unique(na.omit(pw_sg)))
      if (n_levels < 2) { warning("Subgroup '", sg_col, "' has <2 levels. Skipped."); next }

      cat("  Subgroup:", sg_name_display, "(", n_levels, "levels )\n")

      tryCatch({
        # Run separate NMA per subgroup level
        levels_sg <- sort(unique(na.omit(pw_sg)))

        for (lv in levels_sg) {
          pw_sub <- pw[!is.na(pw_sg) & pw_sg == lv, ]
          if (nrow(pw_sub) < 1) next

          treats_sub <- unique(c(pw_sub$treat1, pw_sub$treat2))
          ref_sub    <- if (reference %in% treats_sub) reference else treats_sub[1]

          nma_sub <- tryCatch(
            netmeta::netmeta(
              TE = pw_sub$TE, seTE = pw_sub$seTE,
              treat1 = pw_sub$treat1, treat2 = pw_sub$treat2,
              studlab = pw_sub$studlab,
              sm = effect_measure, method.tau = "REML",
              random = TRUE, reference.group = ref_sub,
              small.values = small_values),
            error = function(e) NULL)

          if (!is.null(nma_sub)) {
            subgroup_nma_results[[paste0(sg_col, "_", lv)]] <- nma_sub

            # Display in viewer first
            tryCatch(forest(nma_sub, reference.group = ref_sub,
                            main = paste("Subgroup:", sg_name_display, "=", lv,
                                         "\n", outcome_name_display)),
                     error = function(e) NULL)
            # Save to file
            tryCatch({
              grDevices::png(paste0("forest_subgroup_", sg_name_safe, "_",
                                    gsub("[^A-Za-z0-9]", "_", lv), "_",
                                    outcome_safe, ".png"),
                             width = .forest_png_dims(length(treats_sub), NULL)$width,
                             height = .forest_png_dims(length(treats_sub), NULL)$height, res = 300)
              forest(nma_sub, reference.group = ref_sub,
                              main = paste("Subgroup:", sg_name_display, "=", lv,
                                           "\n", outcome_name_display))
              grDevices::dev.off()
              cat(sprintf("    OK Forest plot saved for %s = %s\n", sg_name_display, lv))
            }, error = function(e) { safe_dev_off(); NULL })
          }
        }
      }, error = function(e) warning("Subgroup NMA failed '", sg_col, "': ", e$message))
    }
    cat("\n")
  }

  # ═══════════════════════════════════════════════════════════════════════════
  # PAIRWISE DIRECT COMPARISONS (standard meta-analysis per edge)
  # ═══════════════════════════════════════════════════════════════════════════

  cat("--- Running pairwise direct meta-analyses ---\n")
  pairwise_results <- list()

  tryCatch({
    edges <- unique(paste(pmin(pw$treat1, pw$treat2),
                          pmax(pw$treat1, pw$treat2), sep = " vs "))
    for (edge in edges) {
      parts <- strsplit(edge, " vs ")[[1]]
      t1 <- parts[1]; t2 <- parts[2]
      idx <- (pw$treat1 == t1 & pw$treat2 == t2) |
             (pw$treat1 == t2 & pw$treat2 == t1)
      pw_edge <- pw[idx, ]
      if (nrow(pw_edge) < 1) next

      m_edge <- tryCatch(
        meta::metagen(TE = pw_edge$TE, seTE = pw_edge$seTE,
                      studlab = pw_edge$studlab, sm = effect_measure,
                      method.tau = "REML"),
        error = function(e) NULL)
      if (!is.null(m_edge)) {
        pairwise_results[[edge]] <- m_edge
        cat(sprintf("  %s: k=%d, %s=%.4f [%.4f; %.4f] I2=%.1f%%\n",
                    edge, m_edge$k,
                    effect_measure,
                    exp(m_edge$TE.random),
                    exp(m_edge$lower.random),
                    exp(m_edge$upper.random),
                    m_edge$I2 * 100))
      }
    }
    cat("OK Pairwise direct meta-analyses done\n\n")
  }, error = function(e) warning("Pairwise direct MA failed: ", e$message))

  # ═══════════════════════════════════════════════════════════════════════════
  # TEXT REPORT
  # ═══════════════════════════════════════════════════════════════════════════

  cat("--- Generating text report ---\n")
  tryCatch({
    report_file <- paste0("report_nma_", outcome_safe, ".txt")
    report_conn <- file(report_file, open = "w")
    wl <- function(...) writeLines(paste0(...), report_conn)

    wl("============================================================")
    wl("NETWORK META-ANALYSIS REPORT")
    wl("============================================================")
    wl("")
    wl("Outcome        : ", outcome_name_display)
    wl("Effect measure : ", effect_measure)
    wl("Data type      : ", data_type)
    wl("Reference      : ", reference)
    wl("Small values   : ", small_values)
    wl("Date           : ", format(Sys.time(), "%Y-%m-%d %H:%M:%S"))
    wl("")
    wl("Number of studies      : ", length(unique(dat$study)))
    wl("Number of comparisons  : ", nrow(dat))
    wl("Number of treatments   : ", n_treats)
    wl("Treatments             : ", paste(all_treats, collapse = ", "))
    wl("")

    # Total sample sizes
    if (data_type == "binary") {
      wl("Total N (arm 1) : ", sum(dat$n1, na.rm = TRUE))
      wl("Total N (arm 2) : ", sum(dat$n2, na.rm = TRUE))
      wl("Total N         : ", sum(dat$n1, na.rm = TRUE) + sum(dat$n2, na.rm = TRUE))
    } else if (data_type == "continuous") {
      wl("Total N (arm 1) : ", sum(dat$n1, na.rm = TRUE))
      wl("Total N (arm 2) : ", sum(dat$n2, na.rm = TRUE))
      wl("Total N         : ", sum(dat$n1, na.rm = TRUE) + sum(dat$n2, na.rm = TRUE))
    }
    wl("")

    wl("============================================================")
    wl("NMA RESULTS — RANDOM EFFECTS (vs ", reference, ")")
    wl("============================================================")
    wl("")

    # Extract results vs reference
    tryCatch({
      te_ref  <- nma$TE.random[, reference]
      se_ref  <- nma$seTE.random[, reference]
      lb_ref  <- nma$lower.random[, reference]
      ub_ref  <- nma$upper.random[, reference]
      pv_ref  <- nma$pval.random[, reference]

      is_log <- effect_measure %in% c("OR", "RR", "HR", "RD")
      # For ratio measures, back-transform
      if (effect_measure %in% c("OR", "RR", "HR")) {
        for (tr in names(te_ref)) {
          if (tr == reference) next
          wl(sprintf("  %-35s  %s = %7.4f  [%7.4f; %7.4f]  p = %s",
                     tr, effect_measure,
                     exp(te_ref[tr]), exp(lb_ref[tr]), exp(ub_ref[tr]),
                     formatC(pv_ref[tr], format = "g", digits = 4)))
        }
      } else {
        for (tr in names(te_ref)) {
          if (tr == reference) next
          wl(sprintf("  %-35s  %s = %7.4f  [%7.4f; %7.4f]  p = %s",
                     tr, effect_measure,
                     te_ref[tr], lb_ref[tr], ub_ref[tr],
                     formatC(pv_ref[tr], format = "g", digits = 4)))
        }
      }
    }, error = function(e) wl("  [Could not extract results: ", e$message, "]"))

    wl("")
    wl("============================================================")
    wl("HETEROGENEITY")
    wl("============================================================")
    wl("")
    wl("tau2 (between-study) : ", round(nma$tau^2, 6))
    wl("tau                  : ", round(nma$tau, 4))
    tryCatch({
      wl("I2 (overall)         : ", round(nma$I2, 2), "%")
    }, error = function(e) NULL)
    wl("")

    # P-score ranking
    if (!is.null(pscore_obj)) {
      wl("============================================================")
      wl("TREATMENT RANKING (P-SCORES)")
      wl("============================================================")
      wl("")
      if (exists("df_pscore")) {
        for (i in seq_len(nrow(df_pscore)))
          wl(sprintf("  %d. %-35s P-score = %.3f", i,
                      df_pscore$Treatment[i], df_pscore$P_score[i]))
      }
      wl("")
    }

    # League table
    if (!is.null(league_table)) {
      wl("============================================================")
      wl("LEAGUE TABLE (saved separately as CSV and Excel)")
      wl("============================================================")
      wl("")
    }

    # Inconsistency
    wl("============================================================")
    wl("INCONSISTENCY TESTS")
    wl("============================================================")
    wl("")
    if (!is.null(netsplit_result)) {
      wl("netsplit() — Split-Node (SIDE) Analysis:")
      wl("  Tests whether direct and indirect evidence agree for each comparison.")
      wl("  Detailed results saved in: netsplit_", outcome_safe, ".txt")
      wl("")
    }
    if (!is.null(decomp_result)) {
      wl("decomp.design() — Design-by-Treatment Interaction:")
      wl("  Tests global inconsistency across all study designs.")
      wl("  Detailed results saved in: decomp_design_", outcome_safe, ".txt")

      # Extract Q statistics if available
      tryCatch({
        if (!is.null(decomp_result$Q.decomp)) {
          q_tab <- decomp_result$Q.decomp
          wl("")
          wl("  Q decomposition:")
          for (i in seq_len(nrow(q_tab))) {
            wl(sprintf("    %-30s Q = %7.4f  df = %d  p = %s",
                        rownames(q_tab)[i],
                        q_tab[i, 1],
                        round(q_tab[i, 2]),
                        formatC(q_tab[i, 3], format = "g", digits = 4)))
          }
        }
      }, error = function(e) NULL)
      wl("")
    }

    # Subgroup
    if (length(subgroup_nma_results) > 0) {
      wl("============================================================")
      wl("SUBGROUP NMA RESULTS")
      wl("============================================================")
      wl("")
      for (key in names(subgroup_nma_results)) {
        wl("  Subgroup level: ", gsub("_", " ", key))
        nma_sub <- subgroup_nma_results[[key]]
        tryCatch({
          wl("    tau2 = ", round(nma_sub$tau^2, 6),
             "  k = ", nma_sub$k, " comparisons")
        }, error = function(e) NULL)
        wl("")
      }
    }

    # Pairwise direct comparisons
    if (length(pairwise_results) > 0) {
      wl("============================================================")
      wl("PAIRWISE DIRECT META-ANALYSES")
      wl("============================================================")
      wl("")
      for (edge in names(pairwise_results)) {
        m <- pairwise_results[[edge]]
        if (effect_measure %in% c("OR", "RR", "HR")) {
          wl(sprintf("  %-40s  %s = %.4f [%.4f; %.4f]  k=%d  I2=%.1f%%",
                      edge, effect_measure,
                      exp(m$TE.random), exp(m$lower.random), exp(m$upper.random),
                      m$k, m$I2 * 100))
        } else {
          wl(sprintf("  %-40s  %s = %.4f [%.4f; %.4f]  k=%d  I2=%.1f%%",
                      edge, effect_measure,
                      m$TE.random, m$lower.random, m$upper.random,
                      m$k, m$I2 * 100))
        }
      }
      wl("")
    }

    wl("")
    wl("============================================================")
    wl("END OF REPORT")
    wl("============================================================")
    close(report_conn)
    cat("OK Report saved:", report_file, "\n\n")
  }, error = function(e) warning("Failed to generate report: ", e$message),
     finally = {
       if (exists("report_conn") && inherits(report_conn, "connection") &&
           tryCatch(isOpen(report_conn), error = function(e) FALSE))
         close(report_conn)
     })

  # ═══════════════════════════════════════════════════════════════════════════
  # FINAL OUTPUT
  # ═══════════════════════════════════════════════════════════════════════════

  cat("==========================================\n")
  cat("NETWORK META-ANALYSIS COMPLETE\n")
  cat("==========================================\n")
  cat("Files saved to:\n ", output_folder, "\n")
  cat("==========================================\n")

  invisible(list(
    nma             = nma,
    pairwise        = pw,
    pscore          = pscore_obj,
    league_table    = league_table,
    netsplit        = netsplit_result,
    decomp_design   = decomp_result,
    subgroup_nma    = subgroup_nma_results,
    pairwise_direct = pairwise_results,
    output_folder   = output_folder
  ))
}


# =============================================================================
# BONUS: NET CLINICAL BENEFIT PLOT (dua outcome)
# =============================================================================
#
# plot_net_clinical_benefit() — scatter plot RR outcome 1 vs RR outcome 2
# Membutuhkan 2 objek NMA (misalnya nma_MI dan nma_bleeding)
#
# Contoh:
#   plot_net_clinical_benefit(
#     nma_x        = result_bleeding$nma,
#     nma_y        = result_mi$nma,
#     x_label      = "Major Bleeding",
#     y_label      = "Myocardial Infarction",
#     reference    = "12-month_DAPT",
#     output_file  = "net_clinical_benefit.png"
#   )

plot_net_clinical_benefit <- function(nma_x,
                                       nma_y,
                                       x_label      = "Outcome X",
                                       y_label      = "Outcome Y",
                                       reference    = NULL,
                                       output_file  = "net_clinical_benefit.png") {

  if (!requireNamespace("ggplot2", quietly = TRUE))
    stop("Package 'ggplot2' required. Run install_nma_packages() first.")

  library(ggplot2)

  # ── Input validation ─────────────────────────────────────────────────────
  # Users often pass the data frame instead of the nma object.
  # Check for netmeta class or at least the expected slots.
  .check_nma_obj <- function(obj, arg_name) {
    if (is.data.frame(obj))
      stop(arg_name, " is a data.frame, but this function needs a netmeta object.\n",
           "  Use: result <- run_network_meta_analysis(...)\n",
           "  Then pass: result$nma")
    if (!inherits(obj, "netmeta") && is.null(obj$sm))
      stop(arg_name, " does not appear to be a netmeta object.\n",
           "  Use: result <- run_network_meta_analysis(...)\n",
           "  Then pass: result$nma")
  }
  .check_nma_obj(nma_x, "nma_x")
  .check_nma_obj(nma_y, "nma_y")

  # Determine reference
  if (is.null(reference)) reference <- nma_x$reference.group
  if (is.null(reference)) stop("Please specify 'reference' treatment.")

  # ── Extract treatment effects vs reference ─────────────────────────────
  # netmeta stores results in matrices; column names = treatment names
  # Slot names may vary across versions: TE.random, lower.random, upper.random
  .get_matrix <- function(obj, slot_name) {
    m <- obj[[slot_name]]
    if (is.null(m)) stop("Cannot find '", slot_name, "' in netmeta object. ",
                         "Check netmeta version compatibility.")
    m
  }

  te_x <- .get_matrix(nma_x, "TE.random")[, reference]
  te_y <- .get_matrix(nma_y, "TE.random")[, reference]
  lb_x <- .get_matrix(nma_x, "lower.random")[, reference]
  ub_x <- .get_matrix(nma_x, "upper.random")[, reference]
  lb_y <- .get_matrix(nma_y, "lower.random")[, reference]
  ub_y <- .get_matrix(nma_y, "upper.random")[, reference]

  # Back-transform if ratio measure
  sm_x <- if (!is.null(nma_x$sm)) nma_x$sm else ""
  sm_y <- if (!is.null(nma_y$sm)) nma_y$sm else ""

  if (sm_x %in% c("OR", "RR", "HR")) {
    te_x <- exp(te_x); lb_x <- exp(lb_x); ub_x <- exp(ub_x)
  }
  if (sm_y %in% c("OR", "RR", "HR")) {
    te_y <- exp(te_y); lb_y <- exp(lb_y); ub_y <- exp(ub_y)
  }

  null_x <- if (sm_x %in% c("OR", "RR", "HR")) 1 else 0
  null_y <- if (sm_y %in% c("OR", "RR", "HR")) 1 else 0

  treatments <- names(te_x)

  df <- data.frame(
    Treatment = treatments,
    X = te_x, X_lb = lb_x, X_ub = ub_x,
    Y = te_y, Y_lb = lb_y, Y_ub = ub_y,
    stringsAsFactors = FALSE
  )
  # Remove reference point (it's at null,null)
  df <- df[df$Treatment != reference, ]

  draw_ncb <- function() {
    # Use ggrepel if available for non-overlapping labels, fallback to geom_text
    use_repel <- requireNamespace("ggrepel", quietly = TRUE)

    p <- ggplot(df, aes(x = X, y = Y)) +
      geom_errorbarh(aes(xmin = X_lb, xmax = X_ub), height = 0, alpha = 0.35,
                     color = "gray60", linewidth = 0.5) +
      geom_errorbar(aes(ymin = Y_lb, ymax = Y_ub), width = 0, alpha = 0.35,
                    color = "gray60", linewidth = 0.5) +
      geom_point(size = 3.5, color = "#1F77B4") +
      annotate("point", x = null_x, y = null_y, shape = 18, size = 4.5,
               color = "red") +
      geom_hline(yintercept = null_y, lty = 2, color = "gray50", linewidth = 0.4) +
      geom_vline(xintercept = null_x, lty = 2, color = "gray50", linewidth = 0.4) +
      annotate("text", x = null_x, y = null_y, label = reference,
               vjust = 2, color = "red", size = 3.5, fontface = "bold") +
      labs(x = paste(sm_x, "(", x_label, ")"),
           y = paste(sm_y, "(", y_label, ")"),
           title = "Net Clinical Benefit",
           subtitle = paste("Reference:", reference)) +
      theme_minimal(base_size = 12)

    if (use_repel) {
      p <- p + ggrepel::geom_text_repel(
        aes(label = Treatment), size = 3.5,
        box.padding = 0.6, point.padding = 0.4,
        segment.color = "gray70", segment.size = 0.3,
        max.overlaps = Inf, seed = 42)
    } else {
      p <- p + geom_text(aes(label = Treatment), vjust = -1.2, size = 3.5)
    }

    print(p)
  }

  tryCatch(draw_ncb(),
           error = function(e) warning("Cannot display NCB plot: ", e$message))
  tryCatch({
    grDevices::png(output_file, width = 2400, height = 2400, res = 250)
    draw_ncb()
    grDevices::dev.off()
    cat("OK Net clinical benefit plot saved:", output_file, "\n")
  }, error = function(e) {
    while (grDevices::dev.cur() > 1) tryCatch(grDevices::dev.off(), error = function(e) NULL)
    warning("Failed to save NCB plot: ", e$message)
  })

  invisible(df)
}


# =============================================================================


# =============================================================================
# SECTION 8: run_ma_analyses() — SATU FUNGSI UNTUK SEMUA ANALISIS
# =============================================================================
#
# Satu fungsi untuk semua. Routing otomatis per outcome:
#   Sheet diagnostik                      → MA biasa (selalu)
#   dikotomi/kontinyu, tanpa treat1/treat2 → MA biasa
#   dikotomi/kontinyu, 1 pair treat        → MA biasa
#   dikotomi/kontinyu, > 1 pair treat      → NMA (langsung dijalankan di sini)
#
# Kolom opsional di Excel untuk konfigurasi NMA
# (cukup isi di baris pertama per outcome_name, baris lain diabaikan):
#   treat1            nama treatment kelompok 1
#   treat2            nama treatment kelompok 2
#   nma_reference     treatment referensi; kosong/NA → auto (alphabetically first)
#   nma_small_values  "desirable" atau "undesirable"; kosong/NA → "desirable"
#
# CARA PAKAI:
#   hasil <- run_ma_analyses()              # buka file picker
#   hasil <- run_ma_analyses("data.xlsx")   # atau path langsung
#
# AKSES HASIL:
#   hasil$dikotomi$`Mortality (OR)`$overall_meta       # MA
#   hasil$dikotomi$`Mortality (OR)`$nma                # NMA
#   hasil$dikotomi$`Mortality (OR)`$pscore             # NMA P-scores
#   hasil$kontinyu$`HbA1c (MD)`$overall_meta           # MA
#   hasil$diagnostik$`PCR`$bivariate_model             # Diagnostik

run_ma_analyses <- function(file_path           = file.choose(),
                            tau_method_override  = list(),
                            exclude_doublezero   = FALSE) {

  # ── Auto-install packages (MA + NMA) ──────────────────────────────────────

  .req_pkgs <- list(
    list(name = "metafor",   min_version = "3.0"),
    list(name = "meta",      min_version = "5.0"),
    list(name = "mada",      min_version = "0.5"),
    list(name = "netmeta",   min_version = "2.0"),
    list(name = "ggplot2",   min_version = "3.3"),
    list(name = "ggrepel",   min_version = "0.9"),
    list(name = "gridExtra", min_version = "2.3"),
    list(name = "writexl",   min_version = "1.4"),
    list(name = "readxl",    min_version = "1.3"),
    list(name = "Matrix",    min_version = "1.3"),
    list(name = "lme4",      min_version = "1.1")
  )
  .ver_ok <- function(pkg, min_v)
    tryCatch(utils::compareVersion(as.character(utils::packageVersion(pkg)), min_v) >= 0,
             error = function(e) FALSE)
  .miss <- Filter(function(p)
    !requireNamespace(p$name, quietly = TRUE) || !.ver_ok(p$name, p$min_version),
    .req_pkgs)
  if (length(.miss) > 0) {
    cat("\n============================================================\n")
    cat("  Package belum lengkap — install otomatis...\n")
    cat("============================================================\n")
    for (p in .miss) cat("  Perlu install:", p$name, "(>=", p$min_version, ")\n")
    install_meta_packages()
    cat("  Install selesai.\n============================================================\n\n")
  }

  # ── Cek dependensi engine ──────────────────────────────────────────────────

  for (fn in c("run_binary_outcome_analysis", "run_continuous_outcome_analysis",
               "run_diagnostic_meta_analysis", "run_network_meta_analysis",
               "run_single_arm_analysis"))
    if (!exists(fn, envir = .GlobalEnv, inherits = FALSE))
      stop("Fungsi '", fn, "' tidak ditemukan. Source file ini ulang secara penuh.")

  # ── Validasi file ──────────────────────────────────────────────────────────

  if (!file.exists(file_path)) stop("File tidak ditemukan: ", file_path)
  ext <- tolower(tools::file_ext(file_path))
  if (!ext %in% c("xlsx", "xls", "xlsm", "xlsb"))
    stop("File harus berformat Excel. Diterima: .", ext)

  # ── Baca daftar sheet ──────────────────────────────────────────────────────

  all_sheets <- tryCatch(readxl::excel_sheets(file_path),
                         error = function(e) stop("Gagal membaca sheet: ", e$message))

  sheet_map <- list(dikotomi = "binary", kontinyu = "continuous",
                    diagnostik = "diagnostic", single_arm = "single_arm")
  matched <- list()
  for (nm in all_sheets) {
    key <- tolower(trimws(nm))
    if (key %in% names(sheet_map)) matched[[key]] <- nm
  }

  cat("\n============================================================\n")
  cat("  run_ma_analyses() — META-ANALYSIS / NMA AUTO-RUN\n")
  cat("============================================================\n")
  cat("File:", basename(file_path), "\n\n")
  for (key in names(sheet_map))
    cat(sprintf("  %-12s %s\n", key,
                if (key %in% names(matched)) paste0("OK -> '", matched[[key]], "'")
                else "-- tidak ada, dilewati"))
  if (length(matched) == 0)
    stop("\nTidak ada sheet 'dikotomi', 'kontinyu', 'diagnostik', atau 'single_arm'.")
  cat("\n")

  # ── Helper: baca & bersihkan sheet ────────────────────────────────────────

  .read_clean <- function(sht) {
    df <- readxl::read_excel(file_path, sheet = sht)
    names(df) <- gsub("[^A-Za-z0-9_.]", "_", names(df))
    names(df) <- gsub("_+",             "_", names(df))
    names(df) <- gsub("^_|_$",          "",  names(df))
    df
  }

  # ── Helper: hitung unique treatment pairs ─────────────────────────────────

  .count_pairs <- function(df_oc) {
    if (!all(c("treat1", "treat2") %in% names(df_oc))) return(0L)
    t1 <- trimws(as.character(df_oc$treat1))
    t2 <- trimws(as.character(df_oc$treat2))
    valid <- !is.na(t1) & nzchar(t1) & !is.na(t2) & nzchar(t2)
    if (sum(valid) == 0) return(0L)
    length(unique(paste(pmin(t1[valid], t2[valid]),
                        pmax(t1[valid], t2[valid]), sep = "|||")))
  }

  # ── Helper: validasi kolom wajib ──────────────────────────────────────────

  .validate_cols <- function(df, stype, slabel) {
    if (!"study" %in% names(df))
      stop("Sheet '", slabel, "': kolom 'study' tidak ditemukan.")
    if (!"outcome_name" %in% names(df))
      stop("Sheet '", slabel, "': kolom 'outcome_name' tidak ditemukan.")
    if (stype %in% c("binary", "continuous") && !"effect_measure" %in% names(df))
      stop("Sheet '", slabel, "': kolom 'effect_measure' tidak ditemukan.")
  }

  # ── Helper: ambil nilai pertama non-NA dari kolom (untuk NMA config) ──────
  # Tidak error jika kolom tidak ada atau semua NA → kembalikan default

  .first_nma_val <- function(df_oc, col_name, default = NA_character_) {
    if (!col_name %in% names(df_oc)) return(default)
    vals <- trimws(as.character(df_oc[[col_name]]))
    vals <- vals[!is.na(df_oc[[col_name]]) & nzchar(vals) &
                 tolower(vals) != "na" & tolower(vals) != "n/a"]
    if (length(vals) == 0) return(default)
    vals[1]
  }

  # ── Helper: split data per outcome ────────────────────────────────────────

  .split_outcomes <- function(df, stype) {
    df$outcome_name <- trimws(as.character(df$outcome_name))
    if (stype %in% c("binary", "continuous"))
      df$effect_measure <- toupper(trimws(as.character(df$effect_measure)))

    keys <- if (stype %in% c("binary", "continuous"))
              paste0(df$outcome_name, "\u00b7", df$effect_measure)
            else df$outcome_name

    result <- list()
    for (k in unique(keys[!is.na(df$outcome_name) & nzchar(df$outcome_name)])) {
      mask       <- !is.na(keys) & keys == k
      dat_sub    <- df[mask, , drop = FALSE]
      outcome_nm <- unique(df$outcome_name[mask])[1]
      em         <- if (stype %in% c("binary", "continuous"))
                      unique(toupper(trimws(df$effect_measure[mask])))[1] else NULL
      label      <- if (!is.null(em)) paste0(outcome_nm, " (", em, ")") else outcome_nm
      n_pairs    <- if (stype != "diagnostic") .count_pairs(dat_sub) else 0L

      # ── NMA config (safe — kosong/NA → pakai default) ─────────────────────
      ref_raw  <- .first_nma_val(dat_sub, "nma_reference",    NA_character_)
      sv_raw   <- tolower(.first_nma_val(dat_sub, "nma_small_values", "desirable"))
      sv_val   <- if (!is.na(sv_raw) && sv_raw %in% c("desirable", "undesirable"))
                    sv_raw else "desirable"
      # NULL = auto-select (run_network_meta_analysis will pick alphabetically first)
      ref_val  <- if (!is.na(ref_raw) && nzchar(ref_raw)) ref_raw else NULL

      # ── Drop metadata cols before passing to engine ────────────────────────
      drop_cols <- intersect(c("outcome_name", "effect_measure",
                                "nma_reference", "nma_small_values"), names(dat_sub))
      dat_sub <- dat_sub[, setdiff(names(dat_sub), drop_cols), drop = FALSE]
      dat_sub <- dat_sub[, colSums(!is.na(dat_sub)) > 0, drop = FALSE]

      result[[label]] <- list(
        dat          = dat_sub,
        outcome_name = outcome_nm,
        effect_measure = em,
        n_pairs      = n_pairs,
        reference    = ref_val,    # NULL jika tidak diisi → auto
        small_values = sv_val      # "desirable" jika tidak diisi
      )
    }
    result
  }

  # ── Helper: jalankan satu outcome sebagai MA ──────────────────────────────

  .run_one_ma <- function(entry, stype, label) {
    dat_sub    <- entry$dat
    outcome_nm <- entry$outcome_name
    em         <- entry$effect_measure

    if (nrow(dat_sub) < 2) {
      warning("'", label, "': hanya ", nrow(dat_sub), " studi. Dilewati.")
      return(NULL)
    }

    # Resolve tau_method dari override (key = outcome_name)
    tm <- if (!is.null(tau_method_override[[outcome_nm]])) {
      tau_method_override[[outcome_nm]]
    } else if (!is.null(tau_method_override[["default"]])) {
      tau_method_override[["default"]]
    } else {
      "REML"
    }

    cat("\n  [MA] ", label, "—", nrow(dat_sub), "studi | tau:", tm, "\n")

    tryCatch({
      if (stype == "binary")
        run_binary_outcome_analysis(dat_sub, outcome_name = outcome_nm,
                                    effect_measure     = em,
                                    tau_method         = tm,
                                    exclude_doublezero = exclude_doublezero)
      else if (stype == "continuous")
        run_continuous_outcome_analysis(dat_sub, outcome_name = outcome_nm,
                                        effect_measure = em,
                                        tau_method     = tm)
      else
        run_diagnostic_meta_analysis(dat_sub, outcome_name = outcome_nm)
    }, error = function(e) { warning("GAGAL MA '", label, "': ", e$message); NULL })
  }

  # ── Helper: jalankan satu outcome sebagai NMA ─────────────────────────────

  .run_one_nma <- function(entry, label) {
    dat_sub    <- entry$dat
    outcome_nm <- entry$outcome_name
    em         <- entry$effect_measure
    ref        <- entry$reference    # bisa NULL → auto
    sv         <- entry$small_values # sudah pasti "desirable" atau "undesirable"

    if (nrow(dat_sub) < 2) {
      warning("'", label, "': hanya ", nrow(dat_sub), " studi. Dilewati.")
      return(NULL)
    }

    cat("\n  [NMA]", label, "—", nrow(dat_sub), "studi |",
        entry$n_pairs, "pairs | ref =",
        if (!is.null(ref)) ref else "(auto)", "| small =", sv, "\n")

    tryCatch(
      run_network_meta_analysis(
        dat            = dat_sub,
        outcome_name   = outcome_nm,
        effect_measure = em,
        reference      = ref,   # NULL diterima: netmeta auto-pilih referensi
        small_values   = sv
      ),
      error = function(e) { warning("GAGAL NMA '", label, "': ", e$message); NULL }
    )
  }

  # ── Loop semua sheet ───────────────────────────────────────────────────────

  all_results <- list()

  for (key in names(matched)) {
    slabel <- matched[[key]]
    stype  <- sheet_map[[key]]

    cat("============================================================\n")
    cat("SHEET:", toupper(slabel), "(", stype, ")\n")
    cat("============================================================\n")

    df <- tryCatch(.read_clean(slabel),
                   error = function(e) { warning(e$message); NULL })
    if (is.null(df)) { cat("  SKIP — gagal dibaca.\n\n"); next }
    cat("Dimensi:", nrow(df), "baris x", ncol(df), "kolom\n")

    # ── Cabang single_arm ────────────────────────────────────────────────────
    if (stype == "single_arm") {
      if (!"study" %in% names(df))        { cat("  SKIP — kolom 'study' tidak ditemukan.\n\n"); next }
      if (!"outcome_name" %in% names(df)) { cat("  SKIP — kolom 'outcome_name' tidak ditemukan.\n\n"); next }
      df <- df[!is.na(df$outcome_name) & nzchar(trimws(as.character(df$outcome_name))), , drop = FALSE]
      if (nrow(df) == 0) { cat("  SKIP — tidak ada baris valid.\n\n"); next }
      df$outcome_name <- trimws(as.character(df$outcome_name))
      outcomes_sa <- unique(df$outcome_name)
      cat("Outcome ditemukan:", length(outcomes_sa), "\n\n")
      sheet_results <- list()
      for (oc in outcomes_sa) {
        dat_oc <- df[df$outcome_name == oc, , drop = FALSE]
        dat_oc <- dat_oc[, setdiff(names(dat_oc), "outcome_name"), drop = FALSE]
        dat_oc <- dat_oc[, colSums(!is.na(dat_oc)) > 0, drop = FALSE]
        cat("  [SA]", oc, "—", nrow(dat_oc), "studi\n")
        if (nrow(dat_oc) < 2) { warning("'", oc, "': hanya ", nrow(dat_oc), " studi. Dilewati."); next }
        sheet_results[[oc]] <- tryCatch(
          run_single_arm_analysis(dat = dat_oc, outcome_name = oc),
          error = function(e) { warning("GAGAL SA '", oc, "': ", e$message); NULL }
        )
      }
      all_results[[key]] <- sheet_results
      next
    }

    # ── Cabang MA / NMA (dikotomi, kontinyu, diagnostik) ─────────────────────

    ok <- tryCatch({ .validate_cols(df, stype, slabel); TRUE },
                   error = function(e) { warning(e$message); FALSE })
    if (!ok) { cat("  SKIP — kolom wajib tidak lengkap.\n\n"); next }

    df <- df[!is.na(df$outcome_name) & nzchar(trimws(as.character(df$outcome_name))),
             , drop = FALSE]
    if (nrow(df) == 0) { cat("  SKIP — tidak ada baris valid.\n\n"); next }

    outcome_list <- .split_outcomes(df, stype)
    cat("Outcome ditemukan:", length(outcome_list), "\n")
    for (lbl in names(outcome_list)) {
      entry <- outcome_list[[lbl]]
      mode  <- if (stype != "diagnostic" && entry$n_pairs > 1) "NMA" else "MA "
      cat(sprintf("  [%s] %s (%d studi%s)\n", mode, lbl, nrow(entry$dat),
                  if (mode == "NMA") paste0(", ", entry$n_pairs, " pairs") else ""))
    }
    cat("\n")

    sheet_results <- list()
    for (lbl in names(outcome_list)) {
      entry <- outcome_list[[lbl]]
      if (stype != "diagnostic" && entry$n_pairs > 1) {
        sheet_results[[lbl]] <- .run_one_nma(entry, lbl)
      } else {
        sheet_results[[lbl]] <- .run_one_ma(entry, stype, lbl)
      }
    }

    all_results[[key]] <- sheet_results
  }

  # ── Ringkasan ──────────────────────────────────────────────────────────────

  cat("\n============================================================\n")
  cat("  SELESAI — RINGKASAN run_ma_analyses()\n")
  cat("============================================================\n")

  total_ma_ok <- 0; total_nma_ok <- 0; total_sa_ok <- 0; total_fail <- 0

  for (key in names(all_results)) {
    cat(sprintf("\nSheet '%s':\n", matched[[key]]))
    for (lbl in names(all_results[[key]])) {
      res    <- all_results[[key]][[lbl]]
      is_nma <- !is.null(res$nma)
      is_sa  <- !is.null(res$analysis_type)
      if (!is.null(res)) {
        folder <- tryCatch(res$output_folder, error = function(e) "")
        tag    <- if (is_nma) "[NMA]" else if (is_sa) "[SA ]" else "[MA ]"
        cat(sprintf("  OK %s %-40s\n", tag, lbl))
        if (nzchar(folder)) cat(sprintf("           -> %s\n", folder))
        if (is_nma) total_nma_ok <- total_nma_ok + 1
        else if (is_sa) total_sa_ok <- total_sa_ok + 1
        else total_ma_ok <- total_ma_ok + 1
      } else {
        cat(sprintf("  FAIL      %-40s (lihat warnings)\n", lbl))
        total_fail <- total_fail + 1
      }
    }
  }

  cat(sprintf("\nMA  selesai: %d analisis", total_ma_ok))
  cat(sprintf("\nNMA selesai: %d analisis", total_nma_ok))
  cat(sprintf("\nSA  selesai: %d analisis", total_sa_ok))
  if (total_fail > 0) cat(sprintf("\nGAGAL      : %d analisis", total_fail))
  cat("\n============================================================\n\n")

  invisible(all_results)
}


# =============================================================================
# QUICK START — PANDUAN LENGKAP
# =============================================================================
#
# Step 1 — Set working directory ke folder script:
#   RStudio/Positron: Session > Set Working Directory > To Source File Location
#
# Step 2 — Source file ini:
#   source("meta_nma_engine.R")
#
# Step 3 — Jalankan analisis (SATU fungsi untuk semua):
#   hasil <- run_ma_analyses()              # buka file picker
#   hasil <- run_ma_analyses("data.xlsx")   # atau path langsung
#
#   Routing otomatis per outcome:
#     Tidak ada treat1/treat2     → MA biasa
#     treat1/treat2, 1 pair       → MA biasa
#     treat1/treat2, > 1 pair     → NMA langsung dijalankan
#     Sheet diagnostik            → selalu MA
#
# Step 4 — Akses hasil:
#   # MA:
#   hasil$dikotomi$`Mortality (OR)`$overall_meta
#   hasil$dikotomi$`Mortality (OR)`$meta_regression
#   hasil$kontinyu$`HbA1c (MD)`$overall_meta
#   hasil$diagnostik$`PCR`$bivariate_model
#
#   # NMA:
#   hasil$dikotomi$`Mortality (OR)`$nma
#   hasil$dikotomi$`Mortality (OR)`$pscore
#   hasil$dikotomi$`Mortality (OR)`$league_table
#   hasil$dikotomi$`Mortality (OR)`$netsplit
#   hasil$kontinyu$`HbA1c (MD)`$nma
#
# Step 5 — (Bonus NMA) Net Clinical Benefit plot, 2 outcomes:
#   plot_net_clinical_benefit(
#     nma_x      = hasil$dikotomi$`Bleeding (RR)`$nma,
#     nma_y      = hasil$dikotomi$`Mortality (OR)`$nma,
#     x_label    = "Major Bleeding",
#     y_label    = "Mortality",
#     reference  = "Placebo",
#     output_file = "ncb_plot.png"
#   )
#
# Step 6 — Manual (tanpa Excel, langsung dari R):
#   # MA manual:
#   run_binary_outcome_analysis(dat, outcome_name = "MI", effect_measure = "OR")
#   run_continuous_outcome_analysis(dat, outcome_name = "HbA1c", effect_measure = "MD")
#   run_diagnostic_meta_analysis(dat, outcome_name = "PCR")
#
#   # NMA manual:
#   run_network_meta_analysis(dat, "MI", "RR", reference = "Placebo")
#
# =============================================================================
# FORMAT KOLOM EXCEL — REFERENSI LENGKAP
# =============================================================================
#
# KOLOM WAJIB (semua sheet):
#   study          nama studi (karakter)
#   outcome_name   nama outcome
#   effect_measure OR/RR/HR (dikotomi) · MD/SMD (kontinyu) [tidak perlu di diagnostik]
#
# KOLOM ROUTING MA vs NMA (dikotomi & kontinyu, opsional):
#   treat1         nama treatment kelompok 1
#   treat2         nama treatment kelompok 2
#   → Tidak ada / 1 pair unik  = MA biasa
#   → > 1 pair unik            = NMA otomatis
#
# KOLOM KONFIGURASI NMA (opsional, isi di baris pertama per outcome):
#   nma_reference    nama treatment referensi
#                    → kosong / NA = auto-pilih (alphabetically first)
#   nma_small_values "desirable" atau "undesirable"
#                    → kosong / NA = "desirable"
#
# BINARY ENGINE — boleh campur per baris:
#   Opsi A: yi, lowci, highci, sample1, sample2
#   Opsi B: event1, sample1, event2, sample2
#   Opsi C: TE, seTE (langsung)
#
# CONTINUOUS ENGINE — boleh campur per baris:
#   Opsi A: md, lowci, highci, sample1, sample2
#   Opsi B: md, sd, sample1, sample2
#   Opsi C: mean1, sd1, sample1, mean2, sd2, sample2
#   Opsi D: median/IQR → Wan et al.
#   Opsi E: TE, seTE (langsung)
#
# DIAGNOSTIC ENGINE:
#   Opsi A: tp, fp, fn, tn, sample
#   Opsi B: sens, spec, sample
#
# SUBGROUP (prefix subgroup_):
#   subgroup_design · subgroup_region · dll.
#
# META-REGRESSION (prefix moderator_num_ / moderator_cat_):
#   moderator_num_year · moderator_cat_design · dll.
#
# TIPS PENAMAAN TREATMENT (untuk NMA):
#   - Gunakan underscore bukan spasi: "Drug_A", "Placebo"
#   - Nama harus KONSISTEN dan case-sensitive di seluruh dataset
#   - Multi-arm trial: satu baris per perbandingan, nama study sama
# =============================================================================


# =============================================================================
# SECTION 9: SINGLE-ARM META-ANALYSIS ENGINE
# =============================================================================
#
# Dijalankan OTOMATIS oleh run_ma_analyses() jika sheet "single_arm" terisi.
#
# TIGA OPSI INPUT (boleh campur per baris, kecuali proporsi + mean):
#   Opsi 1: event + sample                        → dipool sebagai rate (%)
#   Opsi 2: proportion + lowci + highci           → dipool sebagai rate (%)
#   Opsi 3: proportion (tanpa CI)                 → dipool sebagai rate (%)
#   Opsi 4: mean + sample + (sd | lowci + highci) → dipool sebagai mean
#
# KOLOM OPSIONAL: subgroup_* · moderator_num_* · moderator_cat_*

run_single_arm_analysis <- function(dat,
                                     outcome_name  = "Outcome",
                                     output_folder = NULL) {

  for (pkg in c("meta", "metafor"))
    if (!requireNamespace(pkg, quietly = TRUE))
      stop("Package '", pkg, "' diperlukan. Jalankan install_meta_packages() dulu.")

  outcome_safe <- gsub("_+", "_", gsub("[^A-Za-z0-9]", "_", outcome_name))
  outcome_safe <- gsub("^_|_$", "", outcome_safe)

  if (is.null(output_folder))
    output_folder <- .resolve_output_folder(paste0("SA_", outcome_safe))

  safe_dev_off <- function() {
    while (grDevices::dev.cur() > 1)
      tryCatch(grDevices::dev.off(), error = function(e) NULL)
  }

  cat("\n==========================================\n")
  cat("SINGLE-ARM META-ANALYSIS\n")
  cat("==========================================\n")
  cat("Outcome :", outcome_name, "\n")
  cat("Output  :", output_folder, "\n")
  cat("Dataset :", nrow(dat), "baris\n\n")

  names(dat) <- tolower(trimws(names(dat)))

  has_col <- function(nm) nm %in% names(dat)
  to_num  <- function(x) suppressWarnings(as.numeric(as.character(x)))

  col_event      <- if (has_col("event"))      to_num(dat$event)      else rep(NA_real_, nrow(dat))
  col_sample     <- if (has_col("sample"))     to_num(dat$sample)     else rep(NA_real_, nrow(dat))
  col_proportion <- if (has_col("proportion")) to_num(dat$proportion) else rep(NA_real_, nrow(dat))
  col_mean       <- if (has_col("mean"))       to_num(dat$mean)       else rep(NA_real_, nrow(dat))
  col_sd         <- if (has_col("sd"))         to_num(dat$sd)         else rep(NA_real_, nrow(dat))
  col_lowci      <- if (has_col("lowci"))      to_num(dat$lowci)      else rep(NA_real_, nrow(dat))
  col_highci     <- if (has_col("highci"))     to_num(dat$highci)     else rep(NA_real_, nrow(dat))

  row_type <- character(nrow(dat))
  for (i in seq_len(nrow(dat))) {
    if (!is.na(col_event[i]) && !is.na(col_sample[i]) && col_sample[i] > 0)
      row_type[i] <- "event_sample"
    else if (!is.na(col_proportion[i]) && !is.na(col_lowci[i]) && !is.na(col_highci[i]))
      row_type[i] <- "proportion_ci"
    else if (!is.na(col_proportion[i]))
      row_type[i] <- "proportion_only"
    else if (!is.na(col_mean[i]) && !is.na(col_sample[i]))
      row_type[i] <- "mean"
    else
      row_type[i] <- "unknown"
  }

  n_prop <- sum(row_type %in% c("event_sample", "proportion_ci", "proportion_only"))
  n_mean <- sum(row_type == "mean")

  cat(sprintf("  event+sample     : %d baris\n", sum(row_type == "event_sample")))
  cat(sprintf("  proportion+CI    : %d baris\n", sum(row_type == "proportion_ci")))
  cat(sprintf("  proportion only  : %d baris\n", sum(row_type == "proportion_only")))
  cat(sprintf("  mean+dispersi    : %d baris\n", n_mean))
  if (sum(row_type == "unknown") > 0)
    cat(sprintf("  tidak dikenali   : %d baris (di-skip)\n", sum(row_type == "unknown")))

  if (n_prop > 0 && n_mean > 0)
    stop("Outcome '", outcome_name, "' mencampur data proporsi dan mean. ",
         "Pisahkan ke outcome_name berbeda.")
  if (n_prop == 0 && n_mean == 0)
    stop("Outcome '", outcome_name, "': tidak ada baris dengan data yang dikenali.")

  analysis_type <- if (n_prop > 0) "proportion" else "mean"
  cat(sprintf("\nJenis analisis: %s\n\n",
              if (analysis_type == "proportion") "Proporsi / Rate (%)" else "Mean"))

  study_col    <- if (has_col("study")) as.character(dat$study) else paste0("Study_", seq_len(nrow(dat)))
  subgroup_cols <- grep("^subgroup_", names(dat), value = TRUE)

  # ── PROPORSI ────────────────────────────────────────────────────────────────
  if (analysis_type == "proportion") {

    ev <- rep(NA_real_, nrow(dat)); n <- rep(NA_real_, nrow(dat))
    pr <- rep(NA_real_, nrow(dat)); lb <- rep(NA_real_, nrow(dat)); ub <- rep(NA_real_, nrow(dat))

    for (i in seq_len(nrow(dat))) {
      if (row_type[i] == "event_sample") {
        ev[i] <- col_event[i]; n[i] <- col_sample[i]
      } else if (row_type[i] %in% c("proportion_ci", "proportion_only")) {
        pr[i] <- col_proportion[i]; lb[i] <- col_lowci[i]; ub[i] <- col_highci[i]
        if (!is.na(col_sample[i])) n[i] <- col_sample[i]
      }
    }

    valid_ev <- !is.na(ev) & !is.na(n) & n > 0 & ev >= 0 & ev <= n
    valid_pr <- !is.na(pr) & pr >= 0 & pr <= 1
    all_valid <- valid_ev | valid_pr
    if (sum(all_valid) < 2) stop("Proporsi: kurang dari 2 studi valid.")
    cat("OK Baris valid:", sum(all_valid), "\n\n")

    use_hybrid <- sum(valid_pr & !valid_ev) > 0

    if (!use_hybrid) {
      # ── metaprop ────────────────────────────────────────────────────────────
      ev_use <- ev[all_valid]; n_use <- n[all_valid]; sl_use <- study_col[all_valid]
      m_prop <- tryCatch(
        meta::metaprop(event = ev_use, n = n_use, studlab = sl_use,
                       method.tau = "REML", sm = "PLN", backtransf = TRUE),
        error = function(e) stop("metaprop gagal: ", e$message))

      pooled_pct    <- exp(m_prop$TE.random) * 100
      pooled_pct_lb <- exp(m_prop$lower.random) * 100
      pooled_pct_ub <- exp(m_prop$upper.random) * 100
      cat(sprintf("Pooled: %.2f%% [%.2f%%; %.2f%%]  I²=%.1f%%\n\n",
                  pooled_pct, pooled_pct_lb, pooled_pct_ub, m_prop$I2 * 100))

      fp_title <- paste("Forest Plot —", outcome_name, "(Proporsi %)")
      .pvtxt_prop <- .forest_pval_text(m_prop)
      .draw_fp <- function() meta::forest(m_prop, comb.fixed = TRUE, overall = TRUE,
        overall.hetstat = TRUE, print.I2 = TRUE, digits = 2,
        leftlabs = "Study", rightlabs = c("Proporsi", "95% CI"),
        text.common = .pvtxt_prop$text.common,
        text.random = .pvtxt_prop$text.random,
        main = fp_title, backtransf = TRUE)
      tryCatch(.draw_fp(), error = function(e) NULL)
      tryCatch({
        .fp_dims <- .forest_png_dims(sum(all_valid), dat$study[all_valid])
        grDevices::png(file.path(output_folder, paste0("forest_overall_", outcome_safe, ".png")),
                       width = .fp_dims$width, height = .fp_dims$height, res = 300)
        .draw_fp(); grDevices::dev.off(); cat("OK Forest plot disimpan\n")
      }, error = function(e) { safe_dev_off(); warning(e$message) })

      subgroup_results <- list()
      for (sg_col in subgroup_cols) {
        sg_name <- sub("^subgroup_", "", sg_col)
        sg_vals <- as.character(dat[[sg_col]][all_valid])
        if (all(is.na(sg_vals)) || length(unique(na.omit(sg_vals))) < 2) next
        tryCatch({
          m_sg <- meta::metaprop(event = ev_use, n = n_use, studlab = sl_use,
            subgroup = factor(sg_vals), method.tau = "REML", sm = "PLN", backtransf = TRUE)
          tryCatch({
            grDevices::png(file.path(output_folder,
              paste0("forest_subgroup_", gsub("[^A-Za-z0-9]","_",sg_name), "_", outcome_safe, ".png")),
              width = .forest_png_dims(sum(all_valid), dat$study[all_valid], n_subgroup_levels = length(unique(na.omit(sg_vals))), is_subgroup = TRUE)$width,
              height = .forest_png_dims(sum(all_valid), dat$study[all_valid], n_subgroup_levels = length(unique(na.omit(sg_vals))), is_subgroup = TRUE)$height, res = 300)
            .pvtxt_sg <- .forest_pval_text(m_sg)
            meta::forest(m_sg, comb.fixed = TRUE, overall = TRUE, print.I2 = TRUE,
              digits = 2, leftlabs = "Study", backtransf = TRUE,
              text.common = .pvtxt_sg$text.common,
              text.random = .pvtxt_sg$text.random,
              main = paste0(fp_title, " — Subgroup: ", gsub("_"," ",sg_name)))
            grDevices::dev.off(); cat(sprintf("  OK Subgroup '%s' disimpan\n", sg_name))
          }, error = function(e) { safe_dev_off(); warning(e$message) })
          subgroup_results[[sg_col]] <- m_sg
        }, error = function(e) warning("Subgroup '", sg_name, "' gagal: ", e$message))
      }

      funnel_result <- NULL
      if (sum(all_valid) >= 10) {
        tryCatch({
          yi_l <- log((ev_use + 0.5) / (n_use - ev_use + 0.5))
          se_l <- sqrt(1/(ev_use+0.5) + 1/(n_use-ev_use+0.5))
          res_rma <- metafor::rma(yi = yi_l, sei = se_l, method = "REML", slab = sl_use)
          egger   <- metafor::regtest(res_rma, model = "lm")
          cat(sprintf("  Egger: z=%.3f p=%.4f\n", egger$zval, egger$pval))
          tryCatch({
            grDevices::png(file.path(output_folder, paste0("funnel_", outcome_safe, ".png")),
                           width = 1600, height = 1400, res = 200)
            metafor::funnel(res_rma, main = paste("Funnel —", outcome_name))
            grDevices::dev.off(); cat("  OK Funnel disimpan\n")
          }, error = function(e) { safe_dev_off(); warning(e$message) })
          funnel_result <- list(rma = res_rma, egger = egger)
        }, error = function(e) warning("Funnel gagal: ", e$message))
      }

      mreg_result <- NULL
      all_mod_cols <- c(grep("^moderator_num_", names(dat), value = TRUE),
                        grep("^moderator_cat_", names(dat), value = TRUE))
      all_mod_cols <- all_mod_cols[nzchar(sub("^moderator_(num|cat)_", "", all_mod_cols))]
      if (length(all_mod_cols) > 0) {
        dat_v <- dat[all_valid, , drop = FALSE]
        dat_v$._yi  <- log((ev_use + 0.5) / (n_use - ev_use + 0.5))
        dat_v$._sei <- sqrt(1/(ev_use+0.5) + 1/(n_use-ev_use+0.5))
        mreg_result <- .run_metareg_v4(dat_v, "._yi", "._sei", outcome_name,
                                        outcome_safe, "Proportion", FALSE, output_folder)
      }

      utils::write.csv(
        data.frame(outcome = outcome_name, n_studies = sum(all_valid),
                   pooled_pct = round(pooled_pct, 2), ci_lb = round(pooled_pct_lb, 2),
                   ci_ub = round(pooled_pct_ub, 2), i2_pct = round(m_prop$I2 * 100, 1),
                   tau2 = round(m_prop$tau2, 6)),
        file.path(output_folder, paste0("result_summary_", outcome_safe, ".csv")),
        row.names = FALSE)
      cat("OK CSV ringkasan disimpan\n\n")

      return(invisible(list(overall_meta = m_prop, subgroup_results = subgroup_results,
        meta_regression = mreg_result, funnel = funnel_result,
        pooled_pct = pooled_pct, pooled_ci = c(pooled_pct_lb, pooled_pct_ub),
        i2 = m_prop$I2, tau2 = m_prop$tau2, output_folder = output_folder,
        analysis_type = "proportion", outcome_name = outcome_name)))

    } else {
      # ── metagen logit hybrid ─────────────────────────────────────────────────
      TE_all <- rep(NA_real_, nrow(dat)); seTE_all <- rep(NA_real_, nrow(dat))
      for (i in seq_len(nrow(dat))) {
        if (row_type[i] == "event_sample") {
          e_i <- ev[i]+0.5; n_i <- n[i]+1
          TE_all[i]   <- log(e_i/(n_i-e_i))
          seTE_all[i] <- sqrt(1/e_i + 1/(n_i-e_i))
        } else if (row_type[i] %in% c("proportion_ci","proportion_only")) {
          p_i <- pmax(pmin(pr[i], 1-1e-6), 1e-6)
          TE_all[i] <- log(p_i/(1-p_i))
          if (!is.na(lb[i]) && !is.na(ub[i]) && ub[i] > lb[i]) {
            lb_i <- pmax(pmin(lb[i],1-1e-6),1e-6); ub_i <- pmax(pmin(ub[i],1-1e-6),1e-6)
            seTE_all[i] <- (log(ub_i/(1-ub_i)) - log(lb_i/(1-lb_i))) / (2*1.96)
          } else {
            n_a <- if (!is.na(n[i]) && n[i] > 0) n[i] else 100
            seTE_all[i] <- sqrt(p_i*(1-p_i)/n_a) / (p_i*(1-p_i))
          }
        }
      }
      valid_idx <- !is.na(TE_all) & !is.na(seTE_all) & is.finite(TE_all) & is.finite(seTE_all) & seTE_all > 0
      if (sum(valid_idx) < 2) stop("Hybrid: kurang dari 2 baris valid.")
      cat("OK Baris valid (hybrid logit):", sum(valid_idx), "\n\n")

      m_h <- tryCatch(
        meta::metagen(TE = TE_all[valid_idx], seTE = seTE_all[valid_idx],
                      studlab = study_col[valid_idx], sm = "PLOGIT",
                      method.tau = "REML", backtransf = TRUE),
        error = function(e) stop("metagen hybrid gagal: ", e$message))

      pooled_pct    <- stats::plogis(m_h$TE.random) * 100
      pooled_pct_lb <- stats::plogis(m_h$lower.random) * 100
      pooled_pct_ub <- stats::plogis(m_h$upper.random) * 100
      cat(sprintf("Pooled: %.2f%% [%.2f%%; %.2f%%]  I²=%.1f%%\n\n",
                  pooled_pct, pooled_pct_lb, pooled_pct_ub, m_h$I2 * 100))

      fp_title <- paste("Forest Plot —", outcome_name, "(Proporsi %)")
      .pvtxt_h <- .forest_pval_text(m_h)
      .draw_fph <- function() meta::forest(m_h, comb.fixed = TRUE, overall = TRUE,
        overall.hetstat = TRUE, print.I2 = TRUE, digits = 2,
        leftlabs = "Study", main = fp_title, backtransf = TRUE,
        text.common = .pvtxt_h$text.common,
        text.random = .pvtxt_h$text.random)
      tryCatch(.draw_fph(), error = function(e) NULL)
      tryCatch({
        .fp_dims <- .forest_png_dims(sum(valid_idx), study_col[valid_idx])
        grDevices::png(file.path(output_folder, paste0("forest_overall_", outcome_safe, ".png")),
                       width = .fp_dims$width, height = .fp_dims$height, res = 300)
        .draw_fph(); grDevices::dev.off(); cat("OK Forest plot disimpan\n")
      }, error = function(e) { safe_dev_off(); warning(e$message) })

      subgroup_results <- list()
      for (sg_col in subgroup_cols) {
        sg_name <- sub("^subgroup_", "", sg_col)
        sg_vals <- as.character(dat[[sg_col]][valid_idx])
        if (all(is.na(sg_vals)) || length(unique(na.omit(sg_vals))) < 2) next
        tryCatch({
          m_sg <- meta::metagen(TE = TE_all[valid_idx], seTE = seTE_all[valid_idx],
            studlab = study_col[valid_idx], subgroup = factor(sg_vals),
            sm = "PLOGIT", method.tau = "REML", backtransf = TRUE)
          tryCatch({
            grDevices::png(file.path(output_folder,
              paste0("forest_subgroup_", gsub("[^A-Za-z0-9]","_",sg_name), "_", outcome_safe, ".png")),
              width = .forest_png_dims(sum(valid_idx), study_col[valid_idx], n_subgroup_levels = length(unique(na.omit(sg_vals))), is_subgroup = TRUE)$width,
              height = .forest_png_dims(sum(valid_idx), study_col[valid_idx], n_subgroup_levels = length(unique(na.omit(sg_vals))), is_subgroup = TRUE)$height, res = 300)
            .pvtxt_sgh <- .forest_pval_text(m_sg)
            meta::forest(m_sg, comb.fixed = TRUE, overall = TRUE, print.I2 = TRUE,
              digits = 2, leftlabs = "Study", backtransf = TRUE,
              text.common = .pvtxt_sgh$text.common,
              text.random = .pvtxt_sgh$text.random,
              main = paste0(fp_title, " — Subgroup: ", gsub("_"," ",sg_name)))
            grDevices::dev.off(); cat(sprintf("  OK Subgroup '%s' disimpan\n", sg_name))
          }, error = function(e) { safe_dev_off(); warning(e$message) })
          subgroup_results[[sg_col]] <- m_sg
        }, error = function(e) warning("Subgroup gagal: ", e$message))
      }

      funnel_result <- NULL
      if (sum(valid_idx) >= 10) {
        tryCatch({
          res_rma <- metafor::rma(yi = TE_all[valid_idx], sei = seTE_all[valid_idx],
                                  method = "REML", slab = study_col[valid_idx])
          egger <- metafor::regtest(res_rma, model = "lm")
          cat(sprintf("  Egger: z=%.3f p=%.4f\n", egger$zval, egger$pval))
          tryCatch({
            grDevices::png(file.path(output_folder, paste0("funnel_", outcome_safe, ".png")),
                           width = 1600, height = 1400, res = 200)
            metafor::funnel(res_rma, main = paste("Funnel —", outcome_name))
            grDevices::dev.off(); cat("  OK Funnel disimpan\n")
          }, error = function(e) { safe_dev_off(); warning(e$message) })
          funnel_result <- list(rma = res_rma, egger = egger)
        }, error = function(e) warning("Funnel gagal: ", e$message))
      }

      mreg_result <- NULL
      all_mod_cols <- c(grep("^moderator_num_", names(dat), value = TRUE),
                        grep("^moderator_cat_", names(dat), value = TRUE))
      all_mod_cols <- all_mod_cols[nzchar(sub("^moderator_(num|cat)_", "", all_mod_cols))]
      if (length(all_mod_cols) > 0) {
        dat_v <- dat[valid_idx, , drop = FALSE]
        dat_v$._yi <- TE_all[valid_idx]; dat_v$._sei <- seTE_all[valid_idx]
        mreg_result <- .run_metareg_v4(dat_v, "._yi", "._sei", outcome_name,
                                        outcome_safe, "Proportion", FALSE, output_folder)
      }

      utils::write.csv(
        data.frame(outcome = outcome_name, n_studies = sum(valid_idx),
                   pooled_pct = round(pooled_pct, 2), ci_lb = round(pooled_pct_lb, 2),
                   ci_ub = round(pooled_pct_ub, 2), i2_pct = round(m_h$I2 * 100, 1),
                   tau2 = round(m_h$tau2, 6)),
        file.path(output_folder, paste0("result_summary_", outcome_safe, ".csv")),
        row.names = FALSE)
      cat("OK CSV ringkasan disimpan\n\n")

      return(invisible(list(overall_meta = m_h, subgroup_results = subgroup_results,
        meta_regression = mreg_result, funnel = funnel_result,
        pooled_pct = pooled_pct, pooled_ci = c(pooled_pct_lb, pooled_pct_ub),
        i2 = m_h$I2, tau2 = m_h$tau2, output_folder = output_folder,
        analysis_type = "proportion_hybrid", outcome_name = outcome_name)))
    }
  }

  # ── MEAN ────────────────────────────────────────────────────────────────────
  if (analysis_type == "mean") {
    mn <- rep(NA_real_, nrow(dat)); sd_ <- rep(NA_real_, nrow(dat)); nn <- rep(NA_real_, nrow(dat))
    for (i in seq_len(nrow(dat))) {
      if (row_type[i] != "mean") next
      mn[i] <- col_mean[i]; nn[i] <- col_sample[i]
      if (!is.na(col_sd[i])) {
        sd_[i] <- col_sd[i]
      } else if (!is.na(col_lowci[i]) && !is.na(col_highci[i]) && col_highci[i] > col_lowci[i]) {
        sd_[i] <- (col_highci[i] - col_lowci[i]) / (2 * 1.96) * sqrt(nn[i])
      }
    }
    valid_mean <- !is.na(mn) & !is.na(sd_) & !is.na(nn) & nn > 0 & sd_ > 0
    if (sum(valid_mean) < 2) stop("Mean: kurang dari 2 studi valid.")
    cat("OK Baris valid:", sum(valid_mean), "\n\n")

    mn_use <- mn[valid_mean]; sd_use <- sd_[valid_mean]
    nn_use <- nn[valid_mean]; sl_use <- study_col[valid_mean]
    se_use <- sd_use / sqrt(nn_use)

    m_mean <- tryCatch(
      meta::metamean(n = nn_use, mean = mn_use, sd = sd_use, studlab = sl_use,
                     method.tau = "REML", sm = "MRAW"),
      error = function(e) {
        warning("metamean gagal, fallback ke metagen: ", e$message)
        meta::metagen(TE = mn_use, seTE = se_use, studlab = sl_use,
                      method.tau = "REML", sm = "MD")
      })

    pooled_mean <- m_mean$TE.random
    cat(sprintf("Pooled mean: %.4f [%.4f; %.4f]  I²=%.1f%%\n\n",
                pooled_mean, m_mean$lower.random, m_mean$upper.random, m_mean$I2 * 100))

    fp_title <- paste("Forest Plot —", outcome_name, "(Mean)")
    .pvtxt_mean <- .forest_pval_text(m_mean)
    .draw_fm <- function() meta::forest(m_mean, comb.fixed = TRUE, overall = TRUE,
      overall.hetstat = TRUE, print.I2 = TRUE, digits = 2,
      leftlabs = "Study", rightlabs = c("Mean","95% CI"), main = fp_title,
      text.common = .pvtxt_mean$text.common,
      text.random = .pvtxt_mean$text.random)
    tryCatch(.draw_fm(), error = function(e) NULL)
    tryCatch({
      .fp_dims <- .forest_png_dims(sum(valid_mean), sl_use)
      grDevices::png(file.path(output_folder, paste0("forest_overall_", outcome_safe, ".png")),
                     width = .fp_dims$width, height = .fp_dims$height, res = 300)
      .draw_fm(); grDevices::dev.off(); cat("OK Forest plot disimpan\n")
    }, error = function(e) { safe_dev_off(); warning(e$message) })

    subgroup_results <- list()
    for (sg_col in subgroup_cols) {
      sg_name <- sub("^subgroup_", "", sg_col)
      sg_vals <- as.character(dat[[sg_col]][valid_mean])
      if (all(is.na(sg_vals)) || length(unique(na.omit(sg_vals))) < 2) next
      tryCatch({
        m_sg <- meta::metagen(TE = mn_use, seTE = se_use, studlab = sl_use,
          subgroup = factor(sg_vals), method.tau = "REML", sm = "MD")
        tryCatch({
          grDevices::png(file.path(output_folder,
            paste0("forest_subgroup_", gsub("[^A-Za-z0-9]","_",sg_name), "_", outcome_safe, ".png")),
            width = .forest_png_dims(sum(valid_mean), sl_use, n_subgroup_levels = length(unique(na.omit(sg_vals))), is_subgroup = TRUE)$width,
            height = .forest_png_dims(sum(valid_mean), sl_use, n_subgroup_levels = length(unique(na.omit(sg_vals))), is_subgroup = TRUE)$height, res = 300)
          .pvtxt_sgm <- .forest_pval_text(m_sg)
          meta::forest(m_sg, comb.fixed = TRUE, overall = TRUE, print.I2 = TRUE,
            digits = 2, leftlabs = "Study",
            text.common = .pvtxt_sgm$text.common,
            text.random = .pvtxt_sgm$text.random,
            main = paste0(fp_title, " — Subgroup: ", gsub("_"," ",sg_name)))
          grDevices::dev.off(); cat(sprintf("  OK Subgroup '%s' disimpan\n", sg_name))
        }, error = function(e) { safe_dev_off(); warning(e$message) })
        subgroup_results[[sg_col]] <- m_sg
      }, error = function(e) warning("Subgroup gagal: ", e$message))
    }

    funnel_result <- NULL
    if (sum(valid_mean) >= 10) {
      tryCatch({
        res_rma <- metafor::rma(yi = mn_use, sei = se_use, method = "REML", slab = sl_use)
        egger <- metafor::regtest(res_rma, model = "lm")
        cat(sprintf("  Egger: z=%.3f p=%.4f\n", egger$zval, egger$pval))
        tryCatch({
          grDevices::png(file.path(output_folder, paste0("funnel_", outcome_safe, ".png")),
                         width = 1600, height = 1400, res = 200)
          metafor::funnel(res_rma, main = paste("Funnel —", outcome_name))
          grDevices::dev.off(); cat("  OK Funnel disimpan\n")
        }, error = function(e) { safe_dev_off(); warning(e$message) })
        funnel_result <- list(rma = res_rma, egger = egger)
      }, error = function(e) warning("Funnel gagal: ", e$message))
    }

    mreg_result <- NULL
    all_mod_cols <- c(grep("^moderator_num_", names(dat), value = TRUE),
                      grep("^moderator_cat_", names(dat), value = TRUE))
    all_mod_cols <- all_mod_cols[nzchar(sub("^moderator_(num|cat)_", "", all_mod_cols))]
    if (length(all_mod_cols) > 0) {
      dat_v <- dat[valid_mean, , drop = FALSE]
      dat_v$._yi <- mn_use; dat_v$._sei <- se_use
      mreg_result <- .run_metareg_v4(dat_v, "._yi", "._sei", outcome_name,
                                      outcome_safe, "Mean", FALSE, output_folder)
    }

    utils::write.csv(
      data.frame(outcome = outcome_name, n_studies = sum(valid_mean),
                 pooled_mean = round(pooled_mean, 4),
                 ci_lb = round(m_mean$lower.random, 4), ci_ub = round(m_mean$upper.random, 4),
                 i2_pct = round(m_mean$I2 * 100, 1), tau2 = round(m_mean$tau2, 6)),
      file.path(output_folder, paste0("result_summary_", outcome_safe, ".csv")),
      row.names = FALSE)
    cat("OK CSV ringkasan disimpan\n\n")

    return(invisible(list(overall_meta = m_mean, subgroup_results = subgroup_results,
      meta_regression = mreg_result, funnel = funnel_result,
      pooled_mean = pooled_mean, pooled_ci = c(m_mean$lower.random, m_mean$upper.random),
      i2 = m_mean$I2, tau2 = m_mean$tau2, output_folder = output_folder,
      analysis_type = "mean", outcome_name = outcome_name)))
  }
}
